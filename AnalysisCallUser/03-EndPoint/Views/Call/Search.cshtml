@model AnalysisCallUser._03_EndPoint.Models.ViewModels.Call.CallSearchViewModel
@{
    ViewData["Title"] = "جستجوی تماس";
}
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@{
    var tokenSet = Antiforgery.GetAndStoreTokens(Context);
}
<!-- استایل‌های جدید برای پاپ‌آپ اطلاعات شماره -->
<style>
    .phone-info-container {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 1050;
        padding: 0.75rem;
        margin-top: 0.25rem;
        background-color: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        color: #212529;
    }

    .input-group {
        position: relative;
    }

    .phone-info-trigger {
        cursor: pointer;
    }

    .phone-info-content {
        font-size: 0.875rem;
        line-height: 1.5;
    }

        .phone-info-content strong {
            color: #6f42c1;
        }

    /* استایل‌های سفارشی برای دراپ‌داون‌ها در تم روشن با هایلایت بنفش */
    .custom-dropdown {
        width: 100%;
    }

        .custom-dropdown .dropdown-menu {
            background-color: #ffffff !important;
            border-color: #dee2e6 !important;
            color: #212529 !important;
            box-shadow: 0 0.5rem 1rem rgba(111, 66, 193, 0.2);
            max-height: 300px;
            overflow-y: auto;
            border-radius: 0.5rem;
            padding: 0.5rem 0;
            border: 1px solid #e9ecef;
        }

        .custom-dropdown .dropdown-item {
            color: #212529 !important;
            padding: 0.5rem 1rem; /* کاهش padding برای فونت کوچکتر */
            font-size: 0.85rem; /* کاهش سایز فونت */
            text-align: right;
            transition: all 0.2s ease;
            border-radius: 0.25rem;
            margin: 0.125rem 0.5rem;
            border-left: 3px solid transparent;
        }

            .custom-dropdown .dropdown-item:hover {
                background-color: #f3e8ff !important;
                color: #6f42c1 !important;
                transform: translateX(-3px);
                border-left: 3px solid #6f42c1;
            }

            .custom-dropdown .dropdown-item.active,
            .custom-dropdown .dropdown-item:active {
                background-color: #6f42c1 !important;
                color: #ffffff !important;
                border-left: 3px solid #4a1e9e;
            }

            .custom-dropdown .dropdown-item:focus {
                outline: none;
                box-shadow: 0 0 0 0.25rem rgba(111, 66, 193, 0.25);
            }

        .custom-dropdown .dropdown-toggle {
            background-color: #ffffff !important;
            border: 1px solid #ced4da !important;
            color: #212529 !important;
            text-align: right;
            width: 100%;
            padding: 0.5rem 0.75rem; /* کاهش padding */
            font-size: 0.85rem; /* کاهش سایز فونت */
            border-radius: 0.5rem;
            transition: all 0.3s ease;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .custom-dropdown .dropdown-toggle:hover {
                background-color: #ffffff !important;
                border-color: #9d7bd8 !important;
                color: #6f42c1 !important;
                box-shadow: 0 0 0 0.2rem rgba(111, 66, 193, 0.15);
            }

            .custom-dropdown .dropdown-toggle:focus,
            .custom-dropdown .dropdown-toggle:active {
                background-color: #ffffff !important;
                border-color: #6f42c1 !important;
                color: #212529 !important;
                box-shadow: 0 0 0 0.25rem rgba(111, 66, 193, 0.25) !important;
            }

            .custom-dropdown .dropdown-toggle:disabled {
                background-color: #f8f9fa !important;
                border-color: #e9ecef !important;
                color: #6c757d !important;
                cursor: not-allowed;
                opacity: 0.7;
                font-size: 0.85rem; /* کاهش سایز فونت در حالت غیرفعال */
            }

            .custom-dropdown .dropdown-toggle::after {
                color: #6f42c1;
                margin-right: auto;
                margin-left: 10px;
                transition: transform 0.3s ease;
            }

        .custom-dropdown.show .dropdown-toggle::after {
            transform: rotate(180deg);
        }

    /* استایل برای نمایش اطلاعات شماره تلفن */
    .phone-number-info {
        font-size: 0.8rem;
        margin-top: 0.25rem;
        padding: 0.375rem 0.75rem;
        background-color: #f8f9fa;
        border-radius: 0.375rem;
        color: #495057;
        border: 1px solid #e9ecef;
        transition: all 0.3s ease;
    }

        .phone-number-info:hover {
            background-color: #f3e8ff;
            border-color: #9d7bd8;
            color: #6f42c1;
        }

    /* استایل برای آیکون اطلاعات */
    .phone-info-trigger {
        cursor: pointer;
        background-color: #f3e8ff;
        border-color: #9d7bd8;
        color: #6f42c1;
        transition: all 0.3s ease;
    }

        .phone-info-trigger:hover {
            background-color: #6f42c1;
            color: #ffffff;
            transform: scale(1.1);
        }

    /* استایل برای فیلدهای اجباری تاریخ */
    .required-field label:after {
        content: " *";
        color: #dc3545;
        font-weight: bold;
    }

    .date-required-alert {
        display: none;
        margin-top: 0.5rem;
        padding: 0.5rem;
        border-radius: 0.375rem;
        background-color: #f8d7da;
        border: 1px solid #f5c6cb;
        color: #721c24;
        font-size: 0.875rem;
    }
</style>

<!-- اضافه کردن کتابخانه jQuery که برای تقویم شمسی ضروری است -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- افزودن کتابخانه تقویم شمسی -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/persian-datepicker@0.4.5/dist/css/persian-datepicker.min.css" />
<script src="https://cdn.jsdelivr.net/npm/persian-date@1.1.0/dist/persian-date.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/persian-datepicker@0.4.5/dist/js/persian-datepicker.min.js"></script>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-3">
            <div class="card sticky-top" style="top: 20px;">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">فیلترها</h4>
                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#filterCardBody" aria-expanded="true" aria-controls="filterCardBody">
                        <i class="fas fa-chevron-up" id="filterToggleIcon"></i>
                    </button>
                </div>
                <div class="card-body collapse show" id="filterCardBody">
                    <form asp-action="Search" method="post" id="filter-form" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Filter.Page" id="Filter_Page" value="1" />

                        <!-- فیلدهای تاریخ -->
                        <div class="filter-section required-field">
                            <div class="filter-section-title">
                                <i class="fas fa-calendar-alt"></i> بازه زمانی <span style="color: #dc3545; font-size: 0.9rem;">(اجباری)</span>
                            </div>
                            <!-- هشدار انتخاب تاریخ -->
                            <div class="date-required-alert" id="dateRequiredAlert">
                                <i class="fas fa-exclamation-triangle me-1"></i>
                                لطفاً تاریخ شروع و پایان را انتخاب کنید
                            </div>
                            <div class="filter-row">
                                <div class="filter-field">
                                    <label asp-for="Filter.StartDate" class="form-label"></label>
                                    <div class="input-group">
                                        <input asp-for="Filter.StartDate" type="text" class="form-control persian-date-input required-date" placeholder="تاریخ شروع را انتخاب کنید" id="Filter_StartDate" maxlength="10" required />
                                        <span class="input-group-text" id="startDateClear">
                                            <i class="fas fa-times"></i>
                                        </span>
                                    </div>
                                    <div class="text-danger small" id="startDateError"></div>
                                </div>
                                <div class="filter-field">
                                    <label asp-for="Filter.EndDate" class="form-label"></label>
                                    <div class="input-group">
                                        <input asp-for="Filter.EndDate" type="text" class="form-control persian-date-input required-date" placeholder="تاریخ پایان را انتخاب کنید" id="Filter_EndDate" maxlength="10" required />
                                        <span class="input-group-text" id="endDateClear">
                                            <i class="fas fa-times"></i>
                                        </span>
                                    </div>
                                    <div class="text-danger small" id="endDateError"></div>
                                </div>
                            </div>
                        </div>

                        <!-- فیلدهای شماره‌های مبدأ -->
                        <div class="filter-section">
                            <div class="filter-section-title">
                                <i class="fas fa-phone-alt"></i> شماره‌های مبدأ
                                <button type="button" class="btn btn-sm btn-outline-info float-end" id="addANumber">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                            <div id="anumbers-container">
                                <div class="filter-row anumber-row" data-index="0">
                                    <div class="filter-field">
                                        <label class="form-label">شماره مبدأ 1</label>
                                        <div class="input-group">
                                            <input type="text" class="form-control anumber-input" placeholder="شماره مبدأ را وارد کنید" name="Filter.ANumbers" />
                                            <button class="btn btn-outline-secondary remove-anumber" type="button" title="حذف شماره">
                                                <i class="fas fa-times"></i>
                                            </button>
                                            <span class="input-group-text phone-info-trigger" title="نمایش اطلاعات" style="display: none;">
                                                <i class="fas fa-info-circle"></i>
                                            </span>
                                            <div class="phone-info-container" style="display: none;">
                                                <div class="phone-info-content"></div>
                                            </div>
                                        </div>
                                        <div class="phone-number-info" id="anumber-info-0" style="display: none;">
                                            <i class="fas fa-map-marker-alt"></i> <span id="anumber-location-0"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- فیلدهای شماره‌های مقصد -->
                        <div class="filter-section">
                            <div class="filter-section-title">
                                <i class="fas fa-phone-alt"></i> شماره‌های مقصد
                                <button type="button" class="btn btn-sm btn-outline-info float-end" id="addBNumber">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                            <div id="bnumbers-container">
                                <div class="filter-row bnumber-row" data-index="0">
                                    <div class="filter-field">
                                        <label class="form-label">شماره مقصد 1</label>
                                        <div class="input-group">
                                            <input type="text" class="form-control bnumber-input" placeholder="شماره مقصد را وارد کنید" name="Filter.BNumbers" />
                                            <button class="btn btn-outline-secondary remove-bnumber" type="button" title="حذف شماره">
                                                <i class="fas fa-times"></i>
                                            </button>
                                            <span class="input-group-text phone-info-trigger" title="نمایش اطلاعات" style="display: none;">
                                                <i class="fas fa-info-circle"></i>
                                            </span>
                                            <div class="phone-info-container" style="display: none;">
                                                <div class="phone-info-content"></div>
                                            </div>
                                        </div>
                                        <div class="phone-number-info" id="bnumber-info-0" style="display: none;">
                                            <i class="fas fa-map-marker-alt"></i> <span id="bnumber-location-0"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- فیلدهای مبدأ -->
                        <div class="filter-section" id="origin-location-section">
                            <div class="filter-section-title">
                                <i class="fas fa-map-marker-alt"></i> اطلاعات مکان مبدأ
                                <button type="button" class="btn btn-sm btn-outline-info float-end" id="swapOriginDest">
                                    <i class="fas fa-exchange-alt"></i>
                                </button>
                            </div>
                            <div class="filter-row">
                                <div class="filter-field">
                                    <label asp-for="Filter.OriginCountryID" class="form-label"></label>
                                    <input type="hidden" asp-for="Filter.OriginCountryID" id="origin-country-input" />
                                    <div class="dropdown custom-dropdown" id="origin-country-dropdown">
                                        <button class="btn btn-secondary dropdown-toggle" type="button" id="origin-country-button" data-bs-toggle="dropdown" aria-expanded="false">
                                            انتخاب کنید
                                        </button>
                                        <ul class="dropdown-menu" aria-labelledby="origin-country-button">
                                            <li><a class="dropdown-item" href="#" data-value="">همه</a></li>
                                            @if (Model.Countries != null)
                                            {
                                                @foreach (var country in Model.Countries)
                                                {
                                                    <li><a class="dropdown-item" href="#" data-value="@country.CountryID">@country.CountryName</a></li>
                                                }
                                            }
                                        </ul>
                                    </div>
                                </div>
                                <div class="filter-field">
                                    <label asp-for="Filter.OriginCityID" class="form-label"></label>
                                    <input type="hidden" asp-for="Filter.OriginCityID" id="origin-city-input" />
                                    <div class="dropdown custom-dropdown" id="origin-city-dropdown">
                                        <button class="btn btn-secondary dropdown-toggle" type="button" id="origin-city-button" data-bs-toggle="dropdown" aria-expanded="false" disabled>
                                            ابتدا کشور را انتخاب کنید
                                        </button>
                                        <ul class="dropdown-menu" aria-labelledby="origin-city-button">
                                            <li><a class="dropdown-item" href="#" data-value="">همه</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="filter-row">
                                <div class="filter-field">
                                    <label asp-for="Filter.OriginOperatorID" class="form-label"></label>
                                    <input type="hidden" asp-for="Filter.OriginOperatorID" id="origin-operator-input" />
                                    <div class="dropdown custom-dropdown" id="origin-operator-dropdown">
                                        <button class="btn btn-secondary dropdown-toggle" type="button" id="origin-operator-button" data-bs-toggle="dropdown" aria-expanded="false" disabled>
                                            ابتدا کشور را انتخاب کنید
                                        </button>
                                        <ul class="dropdown-menu" aria-labelledby="origin-operator-button">
                                            <li><a class="dropdown-item" href="#" data-value="">همه</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- فیلدهای مقصد -->
                        <div class="filter-section" id="dest-location-section">
                            <div class="filter-section-title">
                                <i class="fas fa-map-marker-alt"></i> اطلاعات مکان مقصد
                            </div>
                            <div class="filter-row">
                                <div class="filter-field">
                                    <label asp-for="Filter.DestCountryID" class="form-label"></label>
                                    <input type="hidden" asp-for="Filter.DestCountryID" id="dest-country-input" />
                                    <div class="dropdown custom-dropdown" id="dest-country-dropdown">
                                        <button class="btn btn-secondary dropdown-toggle" type="button" id="dest-country-button" data-bs-toggle="dropdown" aria-expanded="false">
                                            انتخاب کنید
                                        </button>
                                        <ul class="dropdown-menu" aria-labelledby="dest-country-button">
                                            <li><a class="dropdown-item" href="#" data-value="">همه</a></li>
                                            @if (Model.Countries != null)
                                            {
                                                @foreach (var country in Model.Countries)
                                                {
                                                    <li><a class="dropdown-item" href="#" data-value="@country.CountryID">@country.CountryName</a></li>
                                                }
                                            }
                                        </ul>
                                    </div>
                                </div>
                                <div class="filter-field">
                                    <label asp-for="Filter.DestCityID" class="form-label"></label>
                                    <input type="hidden" asp-for="Filter.DestCityID" id="dest-city-input" />
                                    <div class="dropdown custom-dropdown" id="dest-city-dropdown">
                                        <button class="btn btn-secondary dropdown-toggle" type="button" id="dest-city-button" data-bs-toggle="dropdown" aria-expanded="false" disabled>
                                            ابتدا کشور را انتخاب کنید
                                        </button>
                                        <ul class="dropdown-menu" aria-labelledby="dest-city-button">
                                            <li><a class="dropdown-item" href="#" data-value="">همه</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="filter-row">
                                <div class="filter-field">
                                    <label asp-for="Filter.DestOperatorID" class="form-label"></label>
                                    <input type="hidden" asp-for="Filter.DestOperatorID" id="dest-operator-input" />
                                    <div class="dropdown custom-dropdown" id="dest-operator-dropdown">
                                        <button class="btn btn-secondary dropdown-toggle" type="button" id="dest-operator-button" data-bs-toggle="dropdown" aria-expanded="false" disabled>
                                            ابتدا کشور را انتخاب کنید
                                        </button>
                                        <ul class="dropdown-menu" aria-labelledby="dest-operator-button">
                                            <li><a class="dropdown-item" href="#" data-value="">همه</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- فیلدهای دیگر -->
                        <div class="filter-section">
                            <div class="filter-section-title">
                                <i class="fas fa-filter"></i> سایر فیلترها
                            </div>
                            <div class="filter-row">
                                <div class="filter-field">
                                    <label asp-for="Filter.Answer" class="form-label"></label>
                                    <input type="hidden" asp-for="Filter.Answer" id="answer-input" />
                                    <div class="dropdown custom-dropdown" id="answer-dropdown">
                                        <button class="btn btn-secondary dropdown-toggle" type="button" id="answer-button" data-bs-toggle="dropdown" aria-expanded="false">
                                            همه
                                        </button>
                                        <ul class="dropdown-menu" aria-labelledby="answer-button">
                                            <li><a class="dropdown-item" href="#" data-value="">همه</a></li>
                                            <li><a class="dropdown-item" href="#" data-value="@AnalysisCallUser._01_Domain.Core.Enums.CallAnswerStatus.Answered">پاسخ داده شده</a></li>
                                            <li><a class="dropdown-item" href="#" data-value="@AnalysisCallUser._01_Domain.Core.Enums.CallAnswerStatus.NotAnswered">پاسخ داده نشده</a></li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="filter-field">
                                    <label asp-for="Filter.PageSize" class="form-label"></label>
                                    <input type="hidden" asp-for="Filter.PageSize" id="pagesize-input" value="50" />
                                    <div class="dropdown custom-dropdown" id="pagesize-dropdown">
                                        <button class="btn btn-secondary dropdown-toggle" type="button" id="pagesize-button" data-bs-toggle="dropdown" aria-expanded="false">
                                            50
                                        </button>
                                        <ul class="dropdown-menu" aria-labelledby="pagesize-button">
                                            <li><a class="dropdown-item" href="#" data-value="10">10</a></li>
                                            <li><a class="dropdown-item" href="#" data-value="25">25</a></li>
                                            <li><a class="dropdown-item active" href="#" data-value="50">50</a></li>
                                            <li><a class="dropdown-item" href="#" data-value="100">100</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- دکمه‌ها -->
                        <div class="filter-section">
                            <div class="filter-row">
                                <button type="submit" class="btn btn-primary flex-fill" id="searchButton">
                                    <i class="fas fa-search"></i> جستجو
                                </button>
                                <button type="button" id="reset-filter" class="btn btn-warning flex-fill" style="background-color: #ffc107; border-color: #ffc107; color: #212529;">
                                    <i class="fas fa-redo"></i> بازنشانی
                                </button>
                            </div>
                            <div class="filter-row mt-2">
                                <button type="button" id="export-results" class="btn btn-success flex-fill" disabled>
                                    <i class="fas fa-file-export"></i> خروجی اکسل
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-9">
            <div id="search-results-container">
                @if (Model.Results != null)
                {
                    <partial name="_SearchResults" model="Model.Results" />
                }
                else
                {
                    <div class="text-center p-4">
                        <i class="fas fa-search fa-3x text-muted mb-3"></i>
                        <p class="text-muted">برای جستجوی تماس‌ها، فیلترهای مورد نظر را اعمال کنید.</p>
                        <div class="global-animation-container" id="globalAnimation">
                            <div class="animation-text" id="animationText">...در حال انتظار برای جستجو</div>
                            <div class="signal-pulse-container" id="signalPulse">
                                <div class="signal-pulse-point">
                                    <div class="signal-pulse-ring"></div>
                                    <div class="signal-pulse-ring"></div>
                                    <div class="signal-pulse-ring"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Toast notification -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
    <div id="notificationToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
            <i class="fas fa-info-circle text-primary me-2"></i>
            <strong class="me-auto">اطلاعیه</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body" id="toastMessage">
            پیام اطلاع‌رسانی
        </div>
    </div>
</div>

<!-- Modal for export options -->
<div class="modal fade" id="exportModal" tabindex="-1" aria-labelledby="exportModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exportModalLabel">اکسپورت نتایج جستجو</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- گزینه‌های اکسپورت -->
                <div class="mb-3">
                    <label class="form-label">نوع اکسپورت</label>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="exportType" id="exportAll" value="all" checked>
                        <label class="form-check-label" for="exportAll">
                            تمام نتایج فیلتر شده بر اساس تعداد ردیف مشخص شده
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="exportType" id="exportCurrent" value="current">
                        <label class="form-check-label" for="exportCurrent">
                            تمامی نتایج فیلتر شده
                        </label>
                    </div>
                </div>

                <!-- بخش مربوط به تمام نتایج -->
                <div id="allResultsSection">
                    <div class="mb-3">
                        <label class="form-label">تعداد کل رکوردها: <span id="totalRecords" class="badge bg-primary">100</span></label>
                    </div>
                    <div class="mb-3">
                        <label for="exportLimit" class="form-label">محدودیت تعداد رکوردها برای اکسپورت</label>
                        <div class="input-group">
                            <input type="number" class="form-control" id="exportLimit" min="1" max="10000" value="100">
                            <span class="input-group-text">ردیف</span>
                        </div>
                        <div class="form-text">حداکثر حجم فایل: <span id="estimatedSize">0</span> MB (حداکثر مجاز: 50MB)</div>
                    </div>
                </div>

                <!-- بخش مربوط به نتایج نمایش داده شده -->
                <div id="currentResultsSection" style="display: none;">
                    <div class="mb-3">
                        <label class="form-label">تعداد رکوردهای نمایش داده شده: <span id="currentRecords" class="badge bg-info">50</span></label>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">ستون‌های مورد نظر برای اکسپورت</label>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="colDetailID" checked>
                        <label class="form-check-label" for="colDetailID">شناسه تماس</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="colANumber" checked>
                        <label class="form-check-label" for="colANumber">شماره مبدأ</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="colBNumber" checked>
                        <label class="form-check-label" for="colBNumber">شماره مقصد</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="colAccountingTime" checked>
                        <label class="form-check-label" for="colAccountingTime">تاریخ و زمان</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="colLength" checked>
                        <label class="form-check-label" for="colLength">مدت زمان (ثانیه)</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="colOriginCountry" checked>
                        <label class="form-check-label" for="colOriginCountry">کشور مبدأ</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="colOriginCity">
                        <label class="form-check-label" for="colOriginCity">شهر مبدأ</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="colOriginOperator">
                        <label class="form-check-label" for="colOriginOperator">اپراتور مبدأ</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="colDestCountry" checked>
                        <label class="form-check-label" for="colDestCountry">کشور مقصد</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="colDestCity">
                        <label class="form-check-label" for="colDestCity">شهر مقصد</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="colDestOperator">
                        <label class="form-check-label" for="colDestOperator">اپراتور مقصد</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="colAnswer" checked>
                        <label class="form-check-label" for="colAnswer">وضعیت پاسخ</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" id="confirmExport">اکسپورت</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // --- تعریف متغیرهای اصلی ---
            let aNumberCount = 1;
            let bNumberCount = 1;
            let totalResultsCount = 0;
            let isResetting = false; // فلگ برای تشخیص عملیات بازنشانی

            // --- کلیدهای ذخیره‌سازی ---
            const LOCAL_STORAGE_KEY = 'callSearchFilters_v3';
            const SESSION_FLAG_KEY = 'sessionFiltersApplied';

            // --- عناصر فرم ---
            const filterForm = document.getElementById('filter-form');
            const resetBtn = document.getElementById('reset-filter');
            const exportBtn = document.getElementById('export-results');
            const searchButton = document.getElementById('searchButton');
            const searchResultsContainer = document.getElementById('search-results-container');

            // --- فیلدهای dropdown ---
            const originCountryInput = document.getElementById('origin-country-input');
            const originCityInput = document.getElementById('origin-city-input');
            const destCountryInput = document.getElementById('dest-country-input');
            const destCityInput = document.getElementById('dest-city-input');
            const originOperatorInput = document.getElementById('origin-operator-input');
            const destOperatorInput = document.getElementById('dest-operator-input');
            const answerInput = document.getElementById('answer-input');
            const pageSizeInput = document.getElementById('pagesize-input');

            const originCountryButton = document.getElementById('origin-country-button');
            const originCityButton = document.getElementById('origin-city-button');
            const destCountryButton = document.getElementById('dest-country-button');
            const destCityButton = document.getElementById('dest-city-button');
            const originOperatorButton = document.getElementById('origin-operator-button');
            const destOperatorButton = document.getElementById('dest-operator-button');
            const answerButton = document.getElementById('answer-button');
            const pageSizeButton = document.getElementById('pagesize-button');

            // --- فیلدهای تاریخ ---
            const startDateInput = document.getElementById('Filter_StartDate');
            const endDateInput = document.getElementById('Filter_EndDate');
            const startDateError = document.getElementById('startDateError');
            const endDateError = document.getElementById('endDateError');
            const startDateClear = document.getElementById('startDateClear');
            const endDateClear = document.getElementById('endDateClear');
            const dateRequiredAlert = document.getElementById('dateRequiredAlert');

            // --- عناصر دیگر ---
            const filterToggleIcon = document.getElementById('filterToggleIcon');
            const swapOriginDestBtn = document.getElementById('swapOriginDest');
            const notificationToast = new bootstrap.Toast(document.getElementById('notificationToast'));
            const toastMessage = document.getElementById('toastMessage');
            const globalAnimation = document.getElementById('globalAnimation');
            const animationText = document.getElementById('animationText');
            const signalPulse = document.getElementById('signalPulse');

            // --- عناصر مودال اکسپورت ---
            const exportModal = new bootstrap.Modal(document.getElementById('exportModal'));
            const exportLimitInput = document.getElementById('exportLimit');
            const totalRecordsSpan = document.getElementById('totalRecords');
            const currentRecordsSpan = document.getElementById('currentRecords');
            const estimatedSizeSpan = document.getElementById('estimatedSize');
            const confirmExportBtn = document.getElementById('confirmExport');
            const exportAllRadio = document.getElementById('exportAll');
            const exportCurrentRadio = document.getElementById('exportCurrent');
            const allResultsSection = document.getElementById('allResultsSection');
            const currentResultsSection = document.getElementById('currentResultsSection');

            // --- توابع کمکی ---
            function toEnglishDigits(s) {
                return s.toString().replace(/[۰-۹]/g, d => '۰۱۲۳۴۵۶۷۸۹'.indexOf(d));
            }

            function showToast(message, type = 'info') {
                toastMessage.textContent = message;
                const toastHeader = document.querySelector('#notificationToast .toast-header i');
                toastHeader.className = `fas me-2 ${type === 'success' ? 'fa-check-circle text-success' : type === 'error' ? 'fa-exclamation-circle text-danger' : 'fa-info-circle text-primary'}`;
                notificationToast.show();
            }

            function startGlobalAnimation() {
                if (!globalAnimation) return;
                signalPulse.style.opacity = '1';
                animationText.textContent = 'در حال انتظار برای جستجو...';
            }

            function stopGlobalAnimation() {
                if (signalPulse) {
                    signalPulse.style.opacity = '0';
                }
            }

            // --- اعتبارسنجی اجباری تاریخ ---
            function validateRequiredDates() {
                const startDateValue = startDateInput.value.trim();
                const endDateValue = endDateInput.value.trim();

                // بررسی آیا هر دو تاریخ پر شده‌اند
                if (!startDateValue || !endDateValue) {
                    // نمایش هشدار
                    dateRequiredAlert.style.display = 'block';

                    // هایلایت کردن فیلدهای خالی
                    if (!startDateValue) {
                        startDateInput.classList.add('is-invalid');
                        startDateInput.style.borderColor = '#dc3545';
                        startDateInput.style.boxShadow = '0 0 0 0.2rem rgba(220, 53, 69, 0.25)';
                    } else {
                        startDateInput.classList.remove('is-invalid');
                        startDateInput.style.borderColor = '';
                        startDateInput.style.boxShadow = '';
                    }

                    if (!endDateValue) {
                        endDateInput.classList.add('is-invalid');
                        endDateInput.style.borderColor = '#dc3545';
                        endDateInput.style.boxShadow = '0 0 0 0.2rem rgba(220, 53, 69, 0.25)';
                    } else {
                        endDateInput.classList.remove('is-invalid');
                        endDateInput.style.borderColor = '';
                        endDateInput.style.boxShadow = '';
                    }

                    return false;
                }

                // مخفی کردن هشدار اگر تاریخ‌ها پر شده‌اند
                dateRequiredAlert.style.display = 'none';
                startDateInput.classList.remove('is-invalid');
                endDateInput.classList.remove('is-invalid');
                startDateInput.style.borderColor = '';
                endDateInput.style.borderColor = '';
                startDateInput.style.boxShadow = '';
                endDateInput.style.boxShadow = '';

                // اعتبارسنجی فرمت تاریخ
                const datePattern = /^(\d{4})\/(\d{2})\/(\d{2})$/;
                if (!datePattern.test(startDateValue) || !datePattern.test(endDateValue)) {
                    dateRequiredAlert.style.display = 'block';
                    dateRequiredAlert.innerHTML = '<i class="fas fa-exclamation-triangle me-1"></i>فرمت تاریخ‌ها باید به صورت YYYY/MM/DD باشد';
                    return false;
                }

                // اعتبارسنجی بازه زمانی
                const rangeValidation = validateDateRangeStepByStep();
                if (!rangeValidation.isValid) {
                    dateRequiredAlert.style.display = 'block';
                    dateRequiredAlert.innerHTML = `<i class="fas fa-exclamation-triangle me-1"></i>${rangeValidation.message}`;
                    return false;
                }

                return true;
            }

            // پنهان کردن هشدار هنگام تغییر تاریخ
            function hideDateRequiredAlert() {
                dateRequiredAlert.style.display = 'none';
            }

            // --- توابع مدیریت Session و LocalStorage ---
            function saveFiltersToLocalStorage() {
                try {
                    const formData = collectFormDataForStorage();
                    localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify(formData));
                } catch (error) {
                    console.error('Error saving to localStorage:', error);
                }
            }

            function loadFiltersFromLocalStorage() {
                try {
                    const saved = localStorage.getItem(LOCAL_STORAGE_KEY);
                    return saved ? JSON.parse(saved) : null;
                } catch (error) {
                    console.error('Error loading from localStorage:', error);
                    return null;
                }
            }

            function clearLocalStorageFilters() {
                localStorage.removeItem(LOCAL_STORAGE_KEY);
            }

            function collectFormDataForStorage() {
                const filters = {};

                // جمع‌آوری مقادیر از فرم
                const formData = new FormData(filterForm);
                for (let [key, value] of formData.entries()) {
                    if (key === 'Filter.ANumbers' || key === 'Filter.BNumbers') {
                        if (!filters[key]) filters[key] = [];
                        if (value) filters[key].push(value);
                    } else if (value) {
                        filters[key] = value;
                    }
                }

                return filters;
            }

            async function clearServerFilters() {
                try {
                    const response = await fetch('@Url.Action("ClearSessionFilters", "Call")', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value,
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    if (!response.ok) {
                        throw new Error('Failed to clear server filters');
                    }
                } catch (error) {
                    console.error('Error clearing server filters:', error);
                }
            }

            // --- توابع بارگذاری فیلترهای ذخیره شده ---
            async function loadSavedFilters() {
                // اگر در حال بازنشانی هستیم، چیزی بارگذاری نکن
                if (isResetting) return;

                // بررسی وضعیت Session
                const sessionApplied = sessionStorage.getItem(SESSION_FLAG_KEY);

                // اگر قبلاً فیلترهای Session اعمال شده‌اند، از LocalStorage استفاده کن
                if (sessionApplied === 'true') {
                    const localFilters = loadFiltersFromLocalStorage();
                    if (localFilters) {
                        await applySavedFilters(localFilters);
                    }
                } else {
                    // در اولین بار، از Session سرور استفاده کن
                    try {
                        const response = await fetch('@Url.Action("GetSessionFilters", "Call")');
                        if (response.ok) {
                            const result = await response.json();
                            if (result.success && result.filters) {
                                await applySavedFiltersFromServer(result.filters);
                                // علامت بزن که Session اعمال شده
                                sessionStorage.setItem(SESSION_FLAG_KEY, 'true');
                            }
                        }
                    } catch (error) {
                        console.error('Error loading server filters:', error);
                        // اگر خطا رخ داد، از LocalStorage استفاده کن
                        const localFilters = loadFiltersFromLocalStorage();
                        if (localFilters) {
                            await applySavedFilters(localFilters);
                        }
                    }
                }
            }

            async function applySavedFiltersFromServer(filterData) {
                if (!filterData) return;

                // اعمال مقادیر اصلی
                if (filterData.StartDate) {
                    startDateInput.value = filterData.StartDate;
                }
                if (filterData.EndDate) {
                    endDateInput.value = filterData.EndDate;
                }

                // اعمال شماره‌های مبدأ
                if (filterData.ANumbers && Array.isArray(filterData.ANumbers)) {
                    filterData.ANumbers.forEach((number, index) => {
                        if (index > 0) addANumber();
                        const inputs = document.querySelectorAll('input[name="Filter.ANumbers"]');
                        if (inputs[index]) inputs[index].value = number;
                    });
                }

                // اعمال شماره‌های مقصد
                if (filterData.BNumbers && Array.isArray(filterData.BNumbers)) {
                    filterData.BNumbers.forEach((number, index) => {
                        if (index > 0) addBNumber();
                        const inputs = document.querySelectorAll('input[name="Filter.BNumbers"]');
                        if (inputs[index]) inputs[index].value = number;
                    });
                }

                // اعمال dropdown‌ها
                if (filterData.OriginCountryID) {
                    originCountryInput.value = filterData.OriginCountryID;
                    await loadCities('origin-country-input', 'origin-city-button', 'origin-city-input', 'origin-city-dropdown');
                    await loadOperators('origin-country-input', 'origin-operator-button', 'origin-operator-input', 'origin-operator-dropdown');

                    setTimeout(() => {
                        if (filterData.OriginCityID) {
                            originCityInput.value = filterData.OriginCityID;
                            setDropdownButtonText('origin-city-button', filterData.OriginCityID);
                        }
                        if (filterData.OriginOperatorID) {
                            originOperatorInput.value = filterData.OriginOperatorID;
                            setDropdownButtonText('origin-operator-button', filterData.OriginOperatorID);
                        }
                    }, 500);
                }

                if (filterData.DestCountryID) {
                    destCountryInput.value = filterData.DestCountryID;
                    await loadCities('dest-country-input', 'dest-city-button', 'dest-city-input', 'dest-city-dropdown');
                    await loadOperators('dest-country-input', 'dest-operator-button', 'dest-operator-input', 'dest-operator-dropdown');

                    setTimeout(() => {
                        if (filterData.DestCityID) {
                            destCityInput.value = filterData.DestCityID;
                            setDropdownButtonText('dest-city-button', filterData.DestCityID);
                        }
                        if (filterData.DestOperatorID) {
                            destOperatorInput.value = filterData.DestOperatorID;
                            setDropdownButtonText('dest-operator-button', filterData.DestOperatorID);
                        }
                    }, 500);
                }

                if (filterData.Answer) {
                    answerInput.value = filterData.Answer;
                    setDropdownButtonText('answer-button', filterData.Answer);
                }

                if (filterData.PageSize) {
                    pageSizeInput.value = filterData.PageSize;
                    setDropdownButtonText('pagesize-button', filterData.PageSize);
                }

                if (filterData.Page) {
                    document.getElementById('Filter_Page').value = filterData.Page;
                }

                // اگر فیلتری اعمال شده، جستجو را اجرا کن
                if (hasAnyFiltersApplied()) {
                    setTimeout(() => {
                        if (typeof performSearch === 'function') {
                            performSearch(filterData.Page || 1, false);
                        }
                    }, 1000);
                }
            }

            async function applySavedFilters(filters) {
                if (!filters) return;

                // اعمال مقادیر ساده
                Object.keys(filters).forEach(key => {
                    if (key === 'Filter.ANumbers' || key === 'Filter.BNumbers') {
                        const values = filters[key];
                        if (Array.isArray(values)) {
                            values.forEach((value, index) => {
                                if (index > 0) {
                                    if (key === 'Filter.ANumbers') addANumber();
                                    else addBNumber();
                                }
                                const inputs = document.querySelectorAll(`[name="${key}"]`);
                                if (inputs[index]) inputs[index].value = value;
                            });
                        }
                    } else {
                        const element = document.querySelector(`[name="${key}"]`);
                        if (element) {
                            element.value = filters[key];

                            // به‌روزرسانی dropdown‌ها
                            if (element.type === 'hidden') {
                                setDropdownButtonText(getDropdownButtonId(key), filters[key]);
                            }
                        }
                    }
                });

                // بارگذاری وابسته‌ها
                await loadDependentFilters(filters);

                // اگر فیلتری اعمال شده، جستجو را اجرا کن
                if (hasAnyFiltersApplied()) {
                    setTimeout(() => {
                        if (typeof performSearch === 'function') {
                            const page = filters['Filter.Page'] || 1;
                            performSearch(page, false);
                        }
                    }, 1000);
                }
            }

            function setDropdownButtonText(buttonId, value) {
                const button = document.getElementById(buttonId);
                if (!button || value === undefined) return;

                const menu = button.nextElementSibling;
                let textContent = 'انتخاب کنید';

                if (value === '') {
                    textContent = 'همه';
                } else {
                    const item = menu.querySelector(`a[data-value="${value}"]`);
                    if (item) {
                        textContent = item.textContent;
                    }
                }

                button.textContent = textContent;
            }

            function getDropdownButtonId(inputName) {
                const buttonMap = {
                    'Filter.OriginCountryID': 'origin-country-button',
                    'Filter.OriginCityID': 'origin-city-button',
                    'Filter.OriginOperatorID': 'origin-operator-button',
                    'Filter.DestCountryID': 'dest-country-button',
                    'Filter.DestCityID': 'dest-city-button',
                    'Filter.DestOperatorID': 'dest-operator-button',
                    'Filter.Answer': 'answer-button',
                    'Filter.PageSize': 'pagesize-button'
                };

                return buttonMap[inputName] || '';
            }

            async function loadDependentFilters(filters) {
                if (filters['Filter.OriginCountryID']) {
                    originCountryInput.value = filters['Filter.OriginCountryID'];
                    await loadCities('origin-country-input', 'origin-city-button', 'origin-city-input', 'origin-city-dropdown');
                    await loadOperators('origin-country-input', 'origin-operator-button', 'origin-operator-input', 'origin-operator-dropdown');

                    if (filters['Filter.OriginCityID']) {
                        setTimeout(() => {
                            originCityInput.value = filters['Filter.OriginCityID'];
                            setDropdownButtonText('origin-city-button', filters['Filter.OriginCityID']);
                        }, 300);
                    }
                    if (filters['Filter.OriginOperatorID']) {
                        setTimeout(() => {
                            originOperatorInput.value = filters['Filter.OriginOperatorID'];
                            setDropdownButtonText('origin-operator-button', filters['Filter.OriginOperatorID']);
                        }, 300);
                    }
                }

                if (filters['Filter.DestCountryID']) {
                    destCountryInput.value = filters['Filter.DestCountryID'];
                    await loadCities('dest-country-input', 'dest-city-button', 'dest-city-input', 'dest-city-dropdown');
                    await loadOperators('dest-country-input', 'dest-operator-button', 'dest-operator-input', 'dest-operator-dropdown');

                    if (filters['Filter.DestCityID']) {
                        setTimeout(() => {
                            destCityInput.value = filters['Filter.DestCityID'];
                            setDropdownButtonText('dest-city-button', filters['Filter.DestCityID']);
                        }, 300);
                    }
                    if (filters['Filter.DestOperatorID']) {
                        setTimeout(() => {
                            destOperatorInput.value = filters['Filter.DestOperatorID'];
                            setDropdownButtonText('dest-operator-button', filters['Filter.DestOperatorID']);
                        }, 300);
                    }
                }
            }

            function hasAnyFiltersApplied() {
                const hasDate = startDateInput.value || endDateInput.value;
                const hasNumbers = document.querySelectorAll('.anumber-input[value], .bnumber-input[value]').length > 0;
                const hasDropdowns = originCountryInput.value || destCountryInput.value ||
                                    originCityInput.value || destCityInput.value ||
                                    originOperatorInput.value || destOperatorInput.value ||
                                    answerInput.value || pageSizeInput.value !== '50';

                return hasDate || hasNumbers || hasDropdowns;
            }

            // --- توابع مدیریت dropdown ---
            function setupDropdownListener(buttonId, inputId, menuId) {
                const button = document.getElementById(buttonId);
                const input = document.getElementById(inputId);
                const menu = document.querySelector(`#${menuId} .dropdown-menu`);

                menu.addEventListener('click', function (e) {
                    e.preventDefault();
                    if (e.target.classList.contains('dropdown-item')) {
                        const value = e.target.getAttribute('data-value');
                        const text = e.target.textContent;

                        input.value = value;
                        button.textContent = text;
                        button.classList.remove('placeholder');

                        menu.querySelectorAll('.dropdown-item').forEach(item => item.classList.remove('active'));
                        e.target.classList.add('active');

                        const event = new Event('change', { bubbles: true });
                        input.dispatchEvent(event);
                    }
                });
            }

            async function loadCities(countryInputId, cityButtonId, cityInputId, cityMenuId) {
                const countryId = document.getElementById(countryInputId).value;
                const cityButton = document.getElementById(cityButtonId);
                const cityInput = document.getElementById(cityInputId);
                const cityMenu = document.querySelector(`#${cityMenuId} .dropdown-menu`);

                cityButton.textContent = 'در حال بارگذاری...';
                cityButton.disabled = true;
                cityMenu.innerHTML = '';

                if (!countryId) {
                    cityButton.textContent = 'ابتدا کشور را انتخاب کنید';
                    cityButton.disabled = true;
                    cityInput.value = '';
                    return;
                }

                try {
                    const response = await fetch(`/Call/GetCities?countryId=${countryId}`);
                    if (!response.ok) throw new Error('Network response was not ok.');
                    const cities = await response.json();

                    cityMenu.innerHTML = '<li><a class="dropdown-item" href="#" data-value="">همه</a></li>';
                    cities.forEach(city => {
                        const li = document.createElement('li');
                        const a = document.createElement('a');
                        a.className = 'dropdown-item';
                        a.href = '#';
                        a.setAttribute('data-value', city.cityID);
                        a.textContent = city.cityName;
                        li.appendChild(a);
                        cityMenu.appendChild(li);
                    });

                    cityButton.textContent = 'انتخاب کنید';
                    cityButton.disabled = false;
                    cityInput.value = '';

                } catch (error) {
                    console.error('Error loading cities:', error);
                    cityButton.textContent = 'خطا در بارگذاری';
                    cityButton.disabled = true;
                    showToast('خطا در بارگذاری شهرها', 'error');
                }
            }

            async function loadOperators(countryInputId, operatorButtonId, operatorInputId, operatorMenuId) {
                const countryId = document.getElementById(countryInputId).value;
                const operatorButton = document.getElementById(operatorButtonId);
                const operatorInput = document.getElementById(operatorInputId);
                const operatorMenu = document.querySelector(`#${operatorMenuId} .dropdown-menu`);

                operatorButton.textContent = 'در حال بارگذاری...';
                operatorButton.disabled = true;
                operatorMenu.innerHTML = '';

                if (!countryId) {
                    operatorButton.textContent = 'ابتدا کشور را انتخاب کنید';
                    operatorButton.disabled = true;
                    operatorInput.value = '';
                    return;
                }

                try {
                    const response = await fetch(`/Call/GetOperators?countryId=${countryId}`);
                    if (!response.ok) throw new Error('Network response was not ok.');
                    const operators = await response.json();

                    operatorMenu.innerHTML = '<li><a class="dropdown-item" href="#" data-value="">همه</a></li>';
                    operators.forEach(op => {
