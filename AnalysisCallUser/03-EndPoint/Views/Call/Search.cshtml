                anumbersContainer.innerHTML = `<div class="filter-row anumber-row" data-index="0"><div class="filter-field"><label class="form-label">شماره مبدأ 1</label><div class="input-group"><input type="text" class="form-control anumber-input" placeholder="شماره مبدأ را وارد کنید" name="Filter.ANumbers" /><button class="btn btn-outline-secondary remove-anumber" type="button" title="حذف شماره"><i class="fas fa-times"></i></button><span class="input-group-text phone-info-trigger" title="نمایش اطلاعات" style="display: none;"><i class="fas fa-info-circle"></i></span><div class="phone-info-container" style="display: none;"><div class="phone-info-content"></div></div></div><div class="phone-number-info" id="anumber-info-0" style="display: none;"><i class="fas fa-map-marker-alt"></i> <span id="anumber-location-0"></span></div></div></div>`;
                bnumbersContainer.innerHTML = `<div class="filter-row bnumber-row" data-index="0"><div class="filter-field"><label class="form-label">شماره مقصد 1</label><div class="input-group"><input type="text" class="form-control bnumber-input" placeholder="شماره مقصد را وارد کنید" name="Filter.BNumbers" /><button class="btn btn-outline-secondary remove-bnumber" type="button" title="حذف شماره"><i class="fas fa-times"></i></button><span class="input-group-text phone-info-trigger" title="نمایش اطلاعات" style="display: none;"><i class="fas fa-info-circle"></i></span><div class="phone-info-container" style="display: none;"><div class="phone-info-content"></div></div></div><div class="phone-number-info" id="bnumber-info-0" style="display: none;"><i class="fas fa-map-marker-alt"></i> <span id="bnumber-location-0"></span></div></div></div>`;
                aNumberCount = 1; bNumberCount = 1;
                document.querySelector('.anumber-row .remove-anumber').addEventListener('click', function() { removeANumber(this); });
                document.querySelector('.anumber-row .anumber-input').addEventListener('input', handlePhoneInput);
                document.querySelector('.anumber-row .phone-info-trigger').addEventListener('click', handlePhoneInfoClick);
                document.querySelector('.bnumber-row .remove-bnumber').addEventListener('click', function() { removeBNumber(this); });
                document.querySelector('.bnumber-row .bnumber-input').addEventListener('input', handlePhoneInput);
                document.querySelector('.bnumber-row .phone-info-trigger').addEventListener('click', handlePhoneInfoClick);

                // ریست کردن فیلدهای جدید
                document.getElementById('Filter_SingleNumberText').value = '';
                document.getElementById('numberListFile').value = '';
                hideFileError();

                searchResultsContainer.innerHTML = `<div class="text-center p-4"><i class="fas fa-search fa-3x text-muted mb-3"></i><p class="text-muted">برای جستجوی تماس‌ها، فیلترهای مورد نظر را اعمال کنید.</p><div class="global-animation-container" id="globalAnimation"><div class="animation-text" id="animationText">در انتظار برای انجام جستجو</div><div class="signal-pulse-container" id="signalPulse"><div class="signal-pulse-point"><div class="signal-pulse-ring"></div><div class="signal-pulse-ring"></div><div class="signal-pulse-ring"></div></div></div></div></div>`;
                window.history.pushState({}, document.title, window.location.pathname);
                setTimeout(() => { startGlobalAnimation(); }, 100);
                showToast('فیلترها با موفقیت بازنشانی شدند', 'success');
                updateLocationFieldsState();
                setTimeout(() => { isResetting = false; },2000);
            }

            // --- Export Options ---
            function estimateFileSize(recordCount, columnCount) {
                const estimatedBytes = recordCount * columnCount * 100;
                const estimatedMB = (estimatedBytes / (1024 * 1024)).toFixed(2);
                return estimatedMB;
            }
            function countSelectedColumns() {
                const checkboxes = document.querySelectorAll('#exportModal .form-check-input[type="checkbox"]');
                let count = 0;
                checkboxes.forEach(checkbox => { if (checkbox.checked) count++; });
                return count;
            }
            function updateEstimatedSize() {
                const limit = parseInt(exportLimitInput.value) || 0;
                const columnCount = countSelectedColumns();
                const estimatedSize = estimateFileSize(limit, columnCount);
                estimatedSizeSpan.textContent = estimatedSize;
                if (estimatedSize > 50) { estimatedSizeSpan.classList.add('text-danger'); confirmExportBtn.disabled = true; }
                else { estimatedSizeSpan.classList.remove('text-danger'); confirmExportBtn.disabled = false; }
            }
            function toggleExportSections() {
                if (exportAllRadio.checked) { allResultsSection.style.display = 'block'; currentResultsSection.style.display = 'none'; updateEstimatedSize(); }
                else { allResultsSection.style.display = 'none'; currentResultsSection.style.display = 'block'; }
            }
            async function performExportWithOptions() {
                const formData = await collectFormDataWithValidation();
                const exportType = document.querySelector('input[name="exportType"]:checked').value;
                formData.append('exportType', exportType);
                if (exportType === 'all') formData.append('limit', exportLimitInput.value);
                const columns = [];
                if (document.getElementById('colDetailID').checked) columns.push('DetailID');
                if (document.getElementById('colANumber').checked) columns.push('ANumber');
                if (document.getElementById('colBNumber').checked) columns.push('BNumber');
                if (document.getElementById('colAccountingTime').checked) columns.push('AccountingTime');
                if (document.getElementById('colLength').checked) columns.push('Length');
                if (document.getElementById('colOriginCountry').checked) columns.push('OriginCountryName');
                if (document.getElementById('colOriginCity').checked) columns.push('OriginCityName');
                if (document.getElementById('colOriginOperator').checked) columns.push('OriginOperatorName');
                if (document.getElementById('colDestCountry').checked) columns.push('DestCountryName');
                if (document.getElementById('colDestCity').checked) columns.push('DestCityName');
                if (document.getElementById('colDestOperator').checked) columns.push('DestOperatorName');
                if (document.getElementById('colAnswer').checked) columns.push('Answer');
                formData.append('columns', columns.join(','));
                try {
                    const response = await fetch(`/Call/ExportWithOptions`, {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value, 'X-Requested-With': 'XMLHttpRequest' },
                        body: formData
                    });
                    if (!response.ok) throw new Error('Network response was not ok.');
                    exportModal.hide();
                    showToast('در حال آماده‌سازی فایل اکسپورت...');
                    const blob = await response.blob();
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.style.display = 'none';
                    a.href = url;
                    const exportTypeText = exportType === 'all' ? 'All' : 'Current';
                    a.download = `CallExport_${exportTypeText}_${new Date().toISOString().slice(0,10)}.csv`;
                    document.body.appendChild(a);
                    a.click();
                    window.URL.revokeObjectURL(url);
                    document.body.removeChild(a);
                    showToast('خروجی با موفقیت دانلود شد', 'success');
                } catch (error) { console.error('Error:', error); showToast('خطا در آماده‌سازی خروجی', 'error'); }
            }
            function convertDatesToPersian() {
                if (typeof persianDate === 'undefined') { console.error("persianDate library is not loaded. Dates will not be converted."); return; }
                const dateElements = document.querySelectorAll('.datetime-cell, [data-datetime]');
                dateElements.forEach(element => {
                    if (element.dataset.datetime) {
                        const date = new Date(element.dataset.datetime);
                        element.textContent = new persianDate(date).format('YYYY/MM/DD HH:mm:ss');
                    }
                });
            }

            // --- Event Binding ---
            setupDropdownListener('origin-country-button', 'origin-country-input', 'origin-country-dropdown');
            setupDropdownListener('origin-city-button', 'origin-city-input', 'origin-city-dropdown');
            setupDropdownListener('dest-country-button', 'dest-country-input', 'dest-country-dropdown');
            setupDropdownListener('dest-city-button', 'dest-city-input', 'dest-city-dropdown');
            setupDropdownListener('origin-operator-button', 'origin-operator-input', 'origin-operator-dropdown');
            setupDropdownListener('dest-operator-button', 'dest-operator-input', 'dest-operator-dropdown');
            setupDropdownListener('answer-button', 'answer-input', 'answer-dropdown');
            setupDropdownListener('pagesize-button', 'pagesize-input', 'pagesize-dropdown');

            document.getElementById('origin-country-input').addEventListener('change', () => {
                const countryId = document.getElementById('origin-country-input').value;
                const cityButton = document.getElementById('origin-city-button');
                const operatorButton = document.getElementById('origin-operator-button');
                if (!countryId || countryId === '') {
                    cityButton.disabled = true; operatorButton.disabled = true;
                    cityButton.textContent = 'ابتدا کشور را انتخاب کنید'; operatorButton.textContent = 'ابتدا کشور را انتخاب کنید';
                    document.getElementById('origin-city-input').value = ''; document.getElementById('origin-operator-input').value = '';
                } else {
                    loadCities('origin-country-input', 'origin-city-button', 'origin-city-input', 'origin-city-dropdown');
                    loadOperators('origin-country-input', 'origin-operator-button', 'origin-operator-input', 'origin-operator-dropdown');
                }
            });
            document.getElementById('dest-country-input').addEventListener('change', () => {
                const countryId = document.getElementById('dest-country-input').value;
                const cityButton = document.getElementById('dest-city-button');
                const operatorButton = document.getElementById('dest-operator-button');
                if (!countryId || countryId === '') {
                    cityButton.disabled = true; operatorButton.disabled = true;
                    cityButton.textContent = 'ابتدا کشور را انتخاب کنید'; operatorButton.textContent = 'ابتدا کشور را انتخاب کنید';
                    document.getElementById('dest-city-input').value = ''; document.getElementById('dest-operator-input').value = '';
                } else {
                    loadCities('dest-country-input', 'dest-city-button', 'dest-city-input', 'dest-city-dropdown');
                    loadOperators('dest-country-input', 'dest-operator-button', 'dest-operator-input', 'dest-operator-dropdown');
                }
            });

            resetBtn.addEventListener('click', resetForm);
            document.getElementById('swapOriginDest').addEventListener('click', () => {
                const tempCountry = document.getElementById('origin-country-input').value;
                document.getElementById('origin-country-input').value = document.getElementById('dest-country-input').value;
                document.getElementById('dest-country-input').value = tempCountry;
                document.getElementById('origin-country-input').dispatchEvent(new Event('change'));
                document.getElementById('dest-country-input').dispatchEvent(new Event('change'));
                setTimeout(() => {
                    const tempCity = document.getElementById('origin-city-input').value;
                    document.getElementById('origin-city-input').value = document.getElementById('dest-city-input').value;
                    document.getElementById('dest-city-input').value = tempCity;
                    const tempOperator = document.getElementById('origin-operator-input').value;
                    document.getElementById('origin-operator-input').value = document.getElementById('dest-operator-input').value;
                    document.getElementById('dest-operator-input').value = tempOperator;
                }, 500);
                const tempButtonText = document.getElementById('origin-country-button').textContent;
                document.getElementById('origin-country-button').textContent = document.getElementById('dest-country-button').textContent;
                document.getElementById('dest-country-button').textContent = tempButtonText;
                const tempCityButtonText = document.getElementById('origin-city-button').textContent;
                document.getElementById('origin-city-button').textContent = document.getElementById('dest-city-button').textContent;
                document.getElementById('dest-city-button').textContent = tempCityButtonText;
                const tempOperatorButtonText = document.getElementById('origin-operator-button').textContent;
                document.getElementById('origin-operator-button').textContent = document.getElementById('dest-operator-button').textContent;
                document.getElementById('dest-operator-button').textContent = tempOperatorButtonText;
                showToast('مبدأ و مقصد با موفقیت جابجا شدند', 'success');
            });
            exportBtn.addEventListener('click', () => {
                totalRecordsSpan.textContent = totalResultsCount;
                exportLimitInput.value = totalResultsCount > 0 ? Math.min(totalResultsCount, 1000) :100;
                updateEstimatedSize();
                exportModal.show();
            });

            // رویداد اعتبارسنجی فایل هنگام تغییر
            numberListFileInput.addEventListener('change', async function() {
                if (this.files.length > 0) {
                    await validateNumberListFile(this.files[0]);
                } else {
                    hideFileError();
                }
            });

            filterForm.addEventListener('submit', async function(e) {
                e.preventDefault();

                // اعتبارسنجی تاریخ
                if (!validateRequiredDates()) {
                    showToast('لطفاً تاریخ شروع و پایان را انتخاب کنید', 'error');
                    return false;
                }

                const hasStartDateError = startDateError.textContent.trim() !== '';
                const hasEndDateError = endDateError.textContent.trim() !== '';
                const rangeValidation = validateDateRangeStepByStep();

                if (hasStartDateError || hasEndDateError || !rangeValidation.isValid) {
                    showToast('لطفاً تاریخ‌ها را به درستی وارد کنید', 'error');
                    return false;
                }

                // اعتبارسنجی فایل (اگر انتخاب شده)
                const fileInput = document.getElementById('numberListFile');
                if (fileInput.files.length > 0) {
                    const file = fileInput.files[0];
                    const validationResult = await validateNumberListFile(file);

                    if (!validationResult.isValid) {
                        // خطای اعتبارسنجی فایل قبلاً نمایش داده شده
                        return false;
                    }
                }

                document.getElementById('Filter_Page').value = 1;
                await performSearch(1);
                return true;
            });

            document.querySelector('[data-bs-toggle="collapse"]').addEventListener('click', function() {
                document.getElementById('filterToggleIcon').classList.toggle('fa-chevron-up');
                document.getElementById('filterToggleIcon').classList.toggle('fa-chevron-down');
            });
            confirmExportBtn.addEventListener('click', performExportWithOptions);
            exportLimitInput.addEventListener('input', updateEstimatedSize);
            document.querySelectorAll('#exportModal .form-check-input[type="checkbox"]').forEach(checkbox => { checkbox.addEventListener('change', updateEstimatedSize); });
            exportAllRadio.addEventListener('change', toggleExportSections);
            exportCurrentRadio.addEventListener('change', toggleExportSections);
            document.getElementById('addANumber').addEventListener('click', addANumber);
            document.getElementById('addBNumber').addEventListener('click', addBNumber);
            document.querySelector('.anumber-row .remove-anumber').addEventListener('click', function() { removeANumber(this); });
            document.querySelector('.anumber-row .anumber-input').addEventListener('input', handlePhoneInput);
            document.querySelector('.anumber-row .phone-info-trigger').addEventListener('click', handlePhoneInfoClick);
            document.querySelector('.bnumber-row .remove-bnumber').addEventListener('click', function() { removeBNumber(this); });
            document.querySelector('.bnumber-row .bnumber-input').addEventListener('input', handlePhoneInput);
            document.querySelector('.bnumber-row .phone-info-trigger').addEventListener('click', handlePhoneInfoClick);
            document.addEventListener('keydown', async function(e) {
                if (e.ctrlKey && e.key === 'Enter') {
                    e.preventDefault();

                    // اعتبارسنجی تاریخ
                    if (!validateRequiredDates()) {
                        showToast('لطفاً تاریخ شروع و پایان را انتخاب کنید', 'error');
                        return;
                    }

                    const hasStartDateError = startDateError.textContent.trim() !== '';
                    const hasEndDateError = endDateError.textContent.trim() !== '';
                    const rangeValidation = validateDateRangeStepByStep();

                    if (!hasStartDateError && !hasEndDateError && rangeValidation.isValid) {
                        // اعتبارسنجی فایل (اگر انتخاب شده)
                        const fileInput = document.getElementById('numberListFile');
                        if (fileInput.files.length > 0) {
                            const file = fileInput.files[0];
                            const validationResult = await validateNumberListFile(file);

                            if (!validationResult.isValid) {
                                return;
                            }
                        }

                        document.getElementById('Filter_Page').value = 1;
                        await performSearch(1);
                    }
                    else {
                        showToast('لطفاً تاریخ‌ها را به درستی وارد کنید', 'error');
                    }
                }
                if (e.ctrlKey && e.key === 'r') { e.preventDefault(); resetForm(e); }
            });
            document.getElementById('startDateClear').addEventListener('click', () => { startDateInput.value = ''; startDateError.textContent = ''; hideDateRequiredAlert(); updateSearchButtonState(); });
            document.getElementById('endDateClear').addEventListener('click', () => { endDateInput.value = ''; endDateError.textContent = ''; hideDateRequiredAlert(); updateSearchButtonState(); });
            startDateInput.addEventListener('input', function() { formatDateInput(this); hideDateRequiredAlert(); updateSearchButtonState(); });
            startDateInput.addEventListener('blur', function() { validateDate(this, startDateError); hideDateRequiredAlert(); });
            endDateInput.addEventListener('input', function() { formatDateInput(this); hideDateRequiredAlert(); updateSearchButtonState(); });
            endDateInput.addEventListener('blur', function() { validateDate(this, endDateError); hideDateRequiredAlert(); });
            document.addEventListener('click', function(e) { if (!startDateInput.contains(e.target) && !endDateInput.contains(e.target)) hideDateRequiredAlert(); });
            function formatDateInput(input) {
                let value = toEnglishDigits(input.value);
                value = value.replace(/[^\d]/g, '');
                if (value.length > 10) value = value.substring(0, 10);
                if (value.length > 4) value = value.substring(0, 4) + '/' + value.substring(4);
                if (value.length > 7) value = value.substring(0, 7) + '/' + value.substring(7);
                input.value = value;
            }
            function validateDate(input, errorElement) {
                const value = input.value;
                if (!value) { errorElement.textContent = ''; return; }
                const datePattern = /^(\d{4})\/(\d{2})\/(\d{2})$/;
                if (!datePattern.test(value)) { errorElement.textContent = 'فرمت تاریخ باید به صورت YYYY/MM/DD باشد'; return; }
                const match = value.match(datePattern);
                const year = parseInt(match[1]), month = parseInt(match[2]), day = parseInt(match[3]);
                const currentYear = new persianDate().year();
                if (year < 1390) { errorElement.textContent = 'سال نباید کمتر از 1390 باشد'; return; }
                if (year > currentYear) { errorElement.textContent = 'سال نباید از سال جاری بیشتر باشد'; return; }
                if (month <1 || month > 12) { errorElement.textContent = 'ماه باید بین 1 تا 12 باشد'; return; }
                if (day < 1 || day > 31) { errorElement.textContent = 'روز باید بین 1 تا 31 باشد'; return; }
                if (month >= 7 && month <= 11 && day > 30) { errorElement.textContent = 'این ماه حداکثر 30 روز دارد'; return; }
                if (month === 12) {
                    const isLeapYear = (year % 4 === 3);
                    const maxDay = isLeapYear ? 30 : 29;
                    if (day > maxDay) { errorElement.textContent = `اسفند در سال ${year} حداکثر ${maxDay} روز دارد`; return; }
                }
                const today = new persianDate();
                const inputDate = new persianDate([year, month, day]);
                if (inputDate.isAfter(today)) { errorElement.textContent = 'تاریخ نباید از امروز بیشتر باشد'; return; }
                errorElement.textContent = '';
            }
            function updateSearchButtonState() {
                const submitButton = document.querySelector('button[type="submit"]');
                const dateRangeErrorElement = document.getElementById('dateRangeError');
                const hasStartDateError = startDateError.textContent.trim() !== '';
                const hasEndDateError = endDateError.textContent.trim() !== '';
                const rangeValidation = validateDateRangeStepByStep();
                const hasDateRangeError = !rangeValidation.isValid;
                if (dateRangeErrorElement) { dateRangeErrorElement.textContent = rangeValidation.message; }
                else if (!rangeValidation.isValid) {
                    const errorDiv = document.createElement('div');
                    errorDiv.id = 'dateRangeError'; errorDiv.className = 'text-danger small mt-1';
                    endDateInput.closest('.filter-field').appendChild(errorDiv); errorDiv.textContent = rangeValidation.message;
                }
                if (hasStartDateError || hasEndDateError || hasDateRangeError) submitButton.disabled = true;
                else submitButton.disabled = false;
            }
            function setInitialDropdown(inputId, buttonId) {
                const input = document.getElementById(inputId);
                const button = document.getElementById(buttonId);
                if (input.value || input.value === '') setDropdownButtonText(buttonId, input.value);
            }
            function setDropdownButtonText(buttonId, value) {
                const button = document.getElementById(buttonId);
                if (!button || value === undefined) return;
                const menu = button.nextElementSibling;
                let textContent = 'انتخاب کنید';
                if (value === '') textContent = 'همه';
                else {
                    const item = menu.querySelector(`a[data-value="${value}"]`);
                    if (item) textContent = item.textContent;
                }
                button.textContent = textContent;
            }
            setInitialDropdown('origin-country-input', 'origin-country-button');
            setInitialDropdown('dest-country-input', 'dest-country-button');
            setInitialDropdown('answer-input', 'answer-button');
            setInitialDropdown('pagesize-input', 'pagesize-button');
            const initialOriginCountryId = '@Model.Filter.OriginCountryID';
            const initialDestCountryId = '@Model.Filter.DestCountryID';
            if (initialOriginCountryId) {
                document.getElementById('origin-country-input').dispatchEvent(new Event('change'));
                setTimeout(() => { setInitialDropdown('origin-city-input', 'origin-city-button'); setInitialDropdown('origin-operator-input', 'origin-operator-button'); }, 500);
            }
            if (initialDestCountryId) {
                document.getElementById('dest-country-input').dispatchEvent(new Event('change'));
                setTimeout(() => { setInitialDropdown('dest-city-input', 'dest-city-button'); setInitialDropdown('dest-operator-input', 'dest-operator-button'); }, 500);
            }
            @if (Model.Results != null)
            {
                    <text>
                        exportBtn.disabled = false;
                        totalResultsCount = @Model.Results.TotalCount;
                        setupPaginationListeners();
                        updateClientNumberPairSelects();
                        setupClientFilterEvents();
                        initializeCheckboxLogic();
                    </text>
            }
            else
            {
                    <text>
                        setTimeout(() => { startGlobalAnimation(); }, 100);
                    </text>
            }
            if (typeof $ !== 'undefined' && $.fn.persianDatepicker) {
                $(startDateInput).persianDatepicker({
                    format: 'YYYY/MM/DD', autoClose: true, observer: true, initialValue: false,
                    onSelect: function() { const persianDateString = $(this).val(); const englishDateString = toEnglishDigits(persianDateString); $(this).val(englishDateString); $(this).trigger('change'); validateDate(this, startDateError); hideDateRequiredAlert(); }
                });
                $(endDateInput).persianDatepicker({
                    format: 'YYYY/MM/DD', autoClose: true, observer: true, initialValue: false,
                    onSelect: function() { const persianDateString = $(this).val(); const englishDateString = toEnglishDigits(persianDateString); $(this).val(englishDateString); $(this).trigger('change'); validateDate(this, endDateError); hideDateRequiredAlert(); }
                });
            } else { console.warn("jQuery or persianDatepicker is not loaded. Date pickers will not be initialized."); }
            convertDatesToPersian();
            if (startDateInput.value || endDateInput.value) updateSearchButtonState();
            updateLocationFieldsState();
        });
    </script>
}