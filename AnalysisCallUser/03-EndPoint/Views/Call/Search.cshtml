            function removeANumber(button) { if (document.querySelectorAll('.anumber-row').length <= 1) { showToast('حداقل یک شماره مبدأ باید وارد کنید', 'error'); return; } button.closest('.anumber-row').remove(); aNumberCount--; updateLocationFieldsState(); }
            function removeBNumber(button) { if (document.querySelectorAll('.bnumber-row').length <= 1) { showToast('حداقل یک شماره مقصد باید وارد کنید', 'error'); return; } button.closest('.bnumber-row').remove(); bNumberCount--; updateLocationFieldsState(); }

            async function fetchAndDisplayPhoneInfo(phoneNumber, containerElement, locationElement) {
                if (!phoneNumber) { containerElement.style.display = 'none'; if (locationElement) locationElement.style.display = 'none'; return; }
                try {
                    const response = await fetch(`/Call/GetPhoneInfo?number=${phoneNumber}`);
                    if (!response.ok) throw new Error('Network response was not ok.');
                    const data = await response.json();
                    const contentDiv = containerElement.querySelector('.phone-info-content');
                    if (data.success) {
                        let infoHtml = `<strong>کشور:</strong> ${data.countryName || 'نامشخص'}<br>`; infoHtml += `<strong>شهر:</strong> ${data.cityName || 'نامشخص'}<br>`; infoHtml += `<strong>اپراتور:</strong> ${data.operatorName || 'نامشخص'}`;
                        contentDiv.innerHTML = infoHtml; containerElement.style.display = 'block';
                        if (locationElement) {
                            let locationText = '';
                            if (data.countryName) locationText += data.countryName;
                            if (data.cityName) locationText += (locationText ? ', ' : '') + data.cityName;
                            if (data.operatorName) locationText += (locationText ? ', ' : '') + data.operatorName;
                            locationElement.textContent = locationText; locationElement.parentElement.style.display = 'block';
                        }
                    } else { contentDiv.innerHTML = 'اطلاعاتی یافت نشد'; containerElement.style.display = 'block'; if (locationElement) locationElement.parentElement.style.display = 'none'; }
                } catch (error) { console.error('Error fetching phone info:', error); const contentDiv = containerElement.querySelector('.phone-info-content'); contentDiv.innerHTML = 'خطا در دریافت اطلاعات'; containerElement.style.display = 'block'; if (locationElement) locationElement.parentElement.style.display = 'none'; }
            }
            function handlePhoneInput(event) {
                const input = event.target;
                const row = input.closest('.filter-row');
                const trigger = row.querySelector('.phone-info-trigger');
                const container = row.querySelector('.phone-info-container');
                const index = row.dataset.index;
                const isANumber = input.classList.contains('anumber-input');
                const locationElement = document.getElementById(`${isANumber ? 'anumber' : 'bnumber'}-location-${index}`);
                if (input.value.trim().length > 0) { trigger.style.display = 'flex'; container.style.display = 'none'; fetchAndDisplayPhoneInfo(input.value, container, locationElement); }
                else { trigger.style.display = 'none'; container.style.display = 'none'; if (locationElement) locationElement.parentElement.style.display = 'none'; }
                updateLocationFieldsState();
            }
            function handlePhoneInfoClick(event) {
                const trigger = event.currentTarget;
                const row = trigger.closest('.filter-row');
                const input = row.querySelector('.anumber-input, .bnumber-input');
                const container = row.querySelector('.phone-info-container');
                if (container.style.display === 'block') container.style.display = 'none';
                else {
                    const index = row.dataset.index;
                    const isANumber = input.classList.contains('anumber-input');
                    const locationElement = document.getElementById(`${isANumber ? 'anumber' : 'bnumber'}-location-${index}`);
                    fetchAndDisplayPhoneInfo(input.value, container, locationElement);
                }
            }

            async function updateLocationFieldsState() {
                const aNumbers = Array.from(document.querySelectorAll('.anumber-input')).map(input => input.value.trim()).filter(v => v);
                const bNumbers = Array.from(document.querySelectorAll('.bnumber-input')).map(input => input.value.trim()).filter(v => v);
                const originLocationSection = document.getElementById('origin-location-section');
                const destLocationSection = document.getElementById('dest-location-section');
                if (aNumbers.length === 0 && bNumbers.length === 0) { enableLocationFields(originLocationSection); enableLocationFields(destLocationSection); return; }
                if (aNumbers.length > 0 && bNumbers.length === 0) { disableLocationFields(originLocationSection); enableLocationFields(destLocationSection); if (aNumbers.length === 1) await populateOriginLocationFromPhone(aNumbers[0]); return; }
                if (aNumbers.length === 0 && bNumbers.length > 0) { enableLocationFields(originLocationSection); disableLocationFields(destLocationSection); if (bNumbers.length === 1) await populateDestLocationFromPhone(bNumbers[0]); return; }
                if (aNumbers.length > 0 && bNumbers.length > 0) { disableLocationFields(originLocationSection); disableLocationFields(destLocationSection); if (aNumbers.length === 1 && bNumbers.length === 1) { await Promise.all([populateOriginLocationFromPhone(aNumbers[0]), populateDestLocationFromPhone(bNumbers[0])]); } return; }
            }
            function disableLocationFields(section) { section.querySelectorAll('button, input, select').forEach(el => el.disabled = true); section.style.opacity = '0.6'; }
            function enableLocationFields(section) { section.querySelectorAll('button, input, select').forEach(el => el.disabled = false); section.style.opacity = '1'; }
            async function populateOriginLocationFromPhone(phoneNumber) {
                if (!phoneNumber) return;
                try {
                    const response = await fetch(`/Call/GetPhoneInfo?number=${phoneNumber}`);
                    if (!response.ok) throw new Error('Network response was not ok.');
                    const data = await response.json();
                    if (data.success) {
                        if (data.countryID) {
                            document.getElementById('origin-country-input').value = data.countryID;
                            document.getElementById('origin-country-button').textContent = data.countryName || 'انتخاب کنید';
                            await loadCities('origin-country-input', 'origin-city-button', 'origin-city-input', 'origin-city-dropdown');
                            await loadOperators('origin-country-input', 'origin-operator-button', 'origin-operator-input', 'origin-operator-dropdown');
                            if (data.cityID) { document.getElementById('origin-city-input').value = data.cityID; document.getElementById('origin-city-button').textContent = data.cityName || 'انتخاب کنید'; }
                            if (data.operatorID) { document.getElementById('origin-operator-input').value = data.operatorID; document.getElementById('origin-operator-button').textContent = data.operatorName || 'انتخاب کنید'; }
                        }
                    }
                } catch (error) { console.error('Error populating origin location from phone:', error); }
            }
            async function populateDestLocationFromPhone(phoneNumber) {
                if (!phoneNumber) return;
                try {
                    const response = await fetch(`/Call/GetPhoneInfo?number=${phoneNumber}`);
                    if (!response.ok) throw new Error('Network response was not ok.');
                    const data = await response.json();
                    if (data.success) {
                        if (data.countryID) {
                            document.getElementById('dest-country-input').value = data.countryID;
                            document.getElementById('dest-country-button').textContent = data.countryName || 'انتخاب کنید';
                            await loadCities('dest-country-input', 'dest-city-button', 'dest-city-input', 'dest-city-dropdown');
                            await loadOperators('dest-country-input', 'dest-operator-button', 'dest-operator-input', 'dest-operator-dropdown');
                            if (data.cityID) { document.getElementById('dest-city-input').value = data.cityID; document.getElementById('dest-city-button').textContent = data.cityName || 'انتخاب کنید'; }
                            if (data.operatorID) { document.getElementById('dest-operator-input').value = data.operatorID; document.getElementById('dest-operator-button').textContent = data.operatorName || 'انتخاب کنید'; }
                        }
                    }
                } catch (error) { console.error('Error populating dest location from phone:', error); }
            }

            // --- Search & Results ---
            async function collectFormDataWithValidation() {
                const formData = new FormData(filterForm);

                // اعتبارسنجی فایل شماره‌ها
                const fileInput = document.getElementById('numberListFile');
                if (fileInput.files.length > 0) {
                    const file = fileInput.files[0];
                    const validationResult = await validateNumberListFile(file);

                    if (!validationResult.isValid) {
                        throw new Error('اعتبارسنجی فایل ناموفق بود');
                    }

                    // اگر اعتبارسنجی موفق بود، محتوای فایل را اضافه کن
                    if (validationResult.numbers.length > 0) {
                        formData.set('Filter.NumberList', validationResult.numbers.join(','));
                    }
                }

                return formData;
            }

            async function performSearch(page = 1, pushHistory = true, isDeepSearch = false) {
                // اعتبارسنجی تاریخ
                if (!validateRequiredDates()) {
                    showToast('لطفاً تاریخ شروع و پایان را انتخاب کنید', 'error');
                    return;
                }

                try {
                    // اعتبارسنجی فایل
                    const fileInput = document.getElementById('numberListFile');
                    if (fileInput.files.length > 0) {
                        const file = fileInput.files[0];
                        const validationResult = await validateNumberListFile(file);

                        if (!validationResult.isValid) {
                            // خطای اعتبارسنجی فایل قبلاً نمایش داده شده
                            return;
                        }
                    }

                    stopGlobalAnimation();
                    document.getElementById('Filter_Page').value = page;
                    const formData = await collectFormDataWithValidation();

                    if (isDeepSearch) formData.append('deepSearch', 'true');

                    searchResultsContainer.innerHTML = `<div class="text-center p-4"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">در حال بارگذاری...</span></div><p class="mt-2">در حال جستجو...</p></div>`;

                    try {
                        const response = await fetch(`/Call/Search?deepSearch=${isDeepSearch}`, {
                            method: 'POST',
                            headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value, 'X-Requested-With': 'XMLHttpRequest' },
                            body: formData
                        });

                        if (!response.ok) {
                            const errorData = await response.json();
                            throw new Error(errorData.message || 'خطا در سرور');
                        }

                        const html = await response.text();

                        if (html.includes('<html') || html.includes('<!DOCTYPE')) {
                            console.error("Error: Received full page HTML instead of partial view.");
                            searchResultsContainer.innerHTML = `<div class="alert alert-danger" role="alert">خطا در سرور. (Full page received)</div>`;
                            showToast('خطا در جستجو', 'error');
                            return;
                        }

                        searchResultsContainer.innerHTML = html;
                        exportBtn.disabled = false;
                        convertDatesToPersian();
                        const totalCountMatch = html.match(/نتایج جستجو \((\d+) رکورد\)/);
                        if (totalCountMatch) totalResultsCount = parseInt(totalCountMatch[1]);
                        setupPaginationListeners();
                        updateClientNumberPairSelects();
                        setupClientFilterEvents();
                        initializeCheckboxLogic();

                        if (pushHistory) {
                            const params = new URLSearchParams();
                            const formElements = filterForm.elements;
                            for (let i = 0; i < formElements.length; i++) {
                                const element = formElements[i];
                                if (element.name && element.value) {
                                    if (element.name === 'Filter.ANumbers' || element.name === 'Filter.BNumbers') params.append(element.name, element.value);
                                    else params.set(element.name, element.value);
                                }
                            }
                            if (isDeepSearch) params.set('deepSearch', 'true');
                            const newUrl = `${window.location.pathname}?${params.toString()}`;
                            window.history.pushState({ path: newUrl }, '', newUrl);
                            saveFiltersToLocalStorage();
                        }

                    } catch (error) {
                        console.error('Error during search fetch:', error);
                        searchResultsContainer.innerHTML = `<div class="alert alert-danger" role="alert">${error.message || 'خطا در دریافت نتایج جستجو'}</div>`;
                        showToast(error.message || 'خطا در جستجو', 'error');
                    }

                } catch (error) {
                    console.error('Error in form validation:', error);
                    // خطای اعتبارسنجی فایل قبلاً نمایش داده شده
                }
            }

            function setupPaginationListeners() {
                document.querySelectorAll('#search-results-container .pagination .page-link').forEach(link => {
                    link.addEventListener('click', function(e) {
                        e.preventDefault();
                        const page = this.getAttribute('data-page');
                        if (page) performSearch(parseInt(page));
                    });
                });
            }
            function updateClientNumberPairSelects() {
                const aNumbers = Array.from(document.querySelectorAll('.anumber-input')).map(input => input.value.trim()).filter(v => v);
                const bNumbers = Array.from(document.querySelectorAll('.bnumber-input')).map(input => input.value.trim()).filter(v => v);
                const clientANumberSelect = document.querySelector('.client-anumber-select');
                const clientBNumberSelect = document.querySelector('.client-bnumber-select');
                if (!clientANumberSelect || !clientBNumberSelect) return;
                const currentValueA = clientANumberSelect.value;
                const currentValueB = clientBNumberSelect.value;
                clientANumberSelect.innerHTML = '<option value="">همه</option>';
                aNumbers.sort().forEach(number => {
                    const option = document.createElement('option');
                    option.value = number; option.textContent = number;
                    if (currentValueA === number) option.selected = true;
                    clientANumberSelect.appendChild(option);
                });
                clientBNumberSelect.innerHTML = '<option value="">همه</option>';
                bNumbers.sort().forEach(number => {
                    const option = document.createElement('option');
                    option.value = number; option.textContent = number;
                    if (currentValueB === number) option.selected = true;
                    clientBNumberSelect.appendChild(option);
                });
            }
            function setupClientFilterEvents() {
                const clientANumberSelect = document.querySelector('.client-anumber-select');
                const clientBNumberSelect = document.querySelector('.client-bnumber-select');
                const deepSearchBtn = document.getElementById('btnDeepSearch');
                const sortSelect = document.getElementById('sort-select');
                if (clientANumberSelect) clientANumberSelect.addEventListener('change', () => handleClientSideFilter(false));
                if (clientBNumberSelect) clientBNumberSelect.addEventListener('change', () => handleClientSideFilter(false));
                if (deepSearchBtn) deepSearchBtn.addEventListener('click', () => handleClientSideFilter(true));
                if (sortSelect) sortSelect.addEventListener('change', handleClientSort);
            }
            function handleClientSort() {
                const sortSelect = document.getElementById('sort-select');
                if (!sortSelect) return;
                const sortValue = sortSelect.value;
                const [column, direction] = sortValue.split('-');
                const isAscending = direction === 'asc';
                const tbody = document.querySelector('#search-results-container tbody');
                if (!tbody) return;
                const rows = Array.from(tbody.querySelectorAll('tr'));
                rows.sort((a, b) => {
                    let aValue, bValue;
                    switch(column) {
                        case 'AccountingTime':
                            const aTimeElem = a.querySelector('[data-datetime]');
                            const bTimeElem = b.querySelector('[data-datetime]');
                            aValue = aTimeElem ? new Date(aTimeElem.dataset.datetime) : new Date(0);
                            bValue = bTimeElem ? new Date(bTimeElem.dataset.datetime) : new Date(0);
                            break;
                        case 'ANumber':
                            aValue = a.cells[1].textContent.trim();
                            bValue = b.cells[1].textContent.trim();
                            break;
                        case 'BNumber':
                            aValue = a.cells[2].textContent.trim();
                            bValue = b.cells[2].textContent.trim();
                            break;
                        case 'Length':
                            aValue = parseInt(a.cells[4].textContent.trim()) || 0;
                            bValue = parseInt(b.cells[4].textContent.trim()) || 0;
                            break;
                        default: return 0;
                    }
                    if (aValue < bValue) return isAscending ? -1 : 1;
                    if (aValue > bValue) return isAscending ? 1 : -1;
                    return 0;
                });
                tbody.innerHTML = '';
                rows.forEach(row => tbody.appendChild(row));
            }
            function handleClientSideFilter(isDeepSearch = false) {
                if (isDeepSearch) {
                    if (!validateRequiredDates()) { showToast('لطفاً تاریخ شروع و پایان را انتخاب کنید', 'error'); return; }
                const allRows = document.querySelectorAll('#search-results-container tbody tr');
                const aSelect = document.querySelector('.client-anumber-select');
                const bSelect = document.querySelector('.client-bnumber-select');
                if (!aSelect || !bSelect) return;
                const selectedA = aSelect.value;
                const selectedB = bSelect.value;
                if (!selectedA && !selectedB) { showToast('لطفاً حداقل یک شماره برای جستجوی عمیق انتخاب کنید', 'info'); return; }
                const aInputs = filterForm.querySelectorAll('input[name="Filter.ANumbers"]');
                aInputs.forEach(input => input.value = '');
                const bInputs = filterForm.querySelectorAll('input[name="Filter.BNumbers"]');
                bInputs.forEach(input => input.value = '');
                if (selectedA) {
                    const firstAInput = aInputs[0];
                    if (firstAInput) firstAInput.value = selectedA;
                }
                if (selectedB) {
                    const firstBInput = bInputs[0];
                    if (firstBInput) firstBInput.value = selectedB;
                }
                const pageInput = document.getElementById('Filter_Page');
                if (pageInput) pageInput.value =1;
                performSearch(1, true, true);
                return;
            }
            const allRows = document.querySelectorAll('tbody tr');
            const aSelect = document.querySelector('.client-anumber-select');
            const bSelect = document.querySelector('.client-bnumber-select');
            if (!aSelect || !bSelect) return;
            const selectedA = aSelect.value;
            const selectedB = bSelect.value;
            if (!selectedA && !selectedB) { allRows.forEach(row => row.style.display = ''); return; }
            allRows.forEach(row => {
                const aNum = row.cells[1].textContent.trim();
                const bNum = row.cells[2].textContent.trim();
                let isVisible = false;
                if (selectedA && selectedB) { if ((aNum === selectedA && bNum === selectedB) || (aNum === selectedB && bNum === selectedA)) isVisible = true; }
                else if (selectedA && (aNum === selectedA || bNum === selectedA)) isVisible = true;
                else if (selectedB && (aNum === selectedB || bNum === selectedB)) isVisible = true;
                row.style.display = isVisible ? '' : 'none';
            });
            setTimeout(() => {
                const selectAllCb = document.getElementById('selectAllCurrentPage');
                if (selectAllCb) {
                    const visibleCheckboxes = Array.from(document.querySelectorAll('tbody .call-checkbox')).filter(cb => cb.offsetParent !== null);
                    if (visibleCheckboxes.length ===0) { selectAllCb.checked = false; selectAllCb.indeterminate = false; }
                    else {
                        const checkedCount = visibleCheckboxes.filter(cb => cb.checked).length;
                        if (checkedCount ===0) { selectAllCb.checked = false; selectAllCb.indeterminate = false; }
                        else if (checkedCount === visibleCheckboxes.length) { selectAllCb.checked = true; selectAllCb.indeterminate = false; }
                        else { selectAllCb.checked = false; selectAllCb.indeterminate = true; }
                    }
                }
            }, 50);
        }

