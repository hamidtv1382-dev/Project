            // تابع برای پر کردن فیلدها بر اساس اطلاعات شماره
            async function populateFieldsFromPhoneInfo(phoneNumber, countryInputId, cityButtonId, cityInputId, cityMenuId, operatorButtonId, operatorInputId, operatorMenuId) {
                if (!phoneNumber || phoneNumber.length < 5) return;

                try {
                    showToast('در حال تشخیص اطلاعات شماره تلفن...');
                    const response = await fetch(`/Call/GetPhoneInfo?number=${encodeURIComponent(phoneNumber)}`);
                    if (!response.ok) throw new Error('Network response was not ok.');
                    const info = await response.json();

                    if (!info.success) {
                        showToast('اطلاعات شماره تلفن یافت نشد', 'error');
                        return;
                    }

                    const countryInput = document.getElementById(countryInputId);
                    const countryButton = document.getElementById(countryInputId.replace('-input', '-button'));
                    const countryMenu = document.querySelector(`#${countryInputId.replace('-input', '-dropdown')} .dropdown-menu`);

                    if (info.countryId) {
                        countryInput.value = info.countryId;
                        const selectedOption = countryMenu.querySelector(`a[data-value="${info.countryId}"]`);
                        if (selectedOption) {
                            countryButton.textContent = selectedOption.textContent;
                            countryMenu.querySelectorAll('.dropdown-item').forEach(item => item.classList.remove('active'));
                            selectedOption.classList.add('active');
                        }
                        countryInput.dispatchEvent(new Event('change'));
                    }

                    setTimeout(() => {
                        if (info.cityId) {
                            const cityMenu = document.querySelector(`#${cityMenuId} .dropdown-menu`);
                            const selectedCityOption = cityMenu.querySelector(`a[data-value="${info.cityId}"]`);
                            if (selectedCityOption) {
                                document.getElementById(cityInputId).value = info.cityId;
                                document.getElementById(cityButtonId).textContent = selectedCityOption.textContent;
                                cityMenu.querySelectorAll('.dropdown-item').forEach(item => item.classList.remove('active'));
                                selectedCityOption.classList.add('active');
                            }
                        }
                        if (info.operatorId) {
                            const operatorMenu = document.querySelector(`#${operatorMenuId} .dropdown-menu`);
                            const selectedOperatorOption = operatorMenu.querySelector(`a[data-value="${info.operatorId}"]`);
                            if (selectedOperatorOption) {
                                document.getElementById(operatorInputId).value = info.operatorId;
                                document.getElementById(operatorButtonId).textContent = selectedOperatorOption.textContent;
                                operatorMenu.querySelectorAll('.dropdown-item').forEach(item => item.classList.remove('active'));
                                selectedOperatorOption.classList.add('active');
                            }
                        }
                        showToast('اطلاعات شماره تلفن با موفقیت تشخیص داده شد', 'success');
                    }, 400);

                } catch (error) {
                    console.error('Error fetching phone info:', error);
                    showToast('خطا در تشخیص اطلاعات شماره تلفن', 'error');
                }
            }

            // تابع برای اتصال رویداد کلیک به لینک‌های صفحه‌بندی
            function setupPaginationListeners() {
                document.querySelectorAll('#search-results-container .pagination .page-link').forEach(link => {
                    link.addEventListener('click', function(e) {
                        e.preventDefault();
                        const page = this.getAttribute('data-page');
                        if (page) {
                            performSearch(parseInt(page));
                        }
                    });
                });
            }

            // تابع برای جستجو (منطق اصلی با تغییرات جزئی)
            async function performSearch(page = 1) {
                stopGlobalAnimation();

                // مقدار صفحه را در فیلد مخفی فرم تنظیم می‌کنیم
                document.getElementById('Filter_Page').value = page;

                const formData = new FormData(filterForm);
                // نیازی به تنظیم مجدد Page نیست چون در فرم تنظیم شده است

                searchResultsContainer.innerHTML = `
                    <div class="text-center p-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">در حال بارگذاری...</span>
                        </div>
                        <p class="mt-2">در حال جستجو...</p>
                    </div>
                `;

                try {
                    const response = await fetch(`/Call/Search`, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value,
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: formData
                    });

                    if (!response.ok) throw new Error(`Network response was not ok: ${response.statusText}`);

                    const contentType = response.headers.get("content-type");
                    if (contentType && contentType.indexOf("application/json") !== -1) {
                        const errorData = await response.json();
                        console.error("Server-side validation errors:", errorData);
                        searchResultsContainer.innerHTML = `<div class="alert alert-danger" role="alert">خطای اعتبارسنجی در سرور. جزئیات در کنسول.</div>`;
                        showToast('خطای اعتبارسنجی', 'error');
                        return;
                    }

                    const html = await response.text();
                    if (html.includes('<html') || html.includes('<!DOCTYPE')) {
                        console.error("Error: Received full page HTML instead of partial view.");
                        searchResultsContainer.innerHTML = `<div class="alert alert-danger" role="alert">خطا در سرور. (Full page received)</div>`;
                        showToast('خطا در جستجو', 'error');
                        return;
                    }

                    searchResultsContainer.innerHTML = html;
                    exportBtn.disabled = false;
                    convertDatesToPersian();

                    // استخراج تعداد کل نتایج از HTML بازگشتی
                    const totalCountMatch = html.match(/نتایج جستجو \((\d+) رکورد\)/);
                    if (totalCountMatch) {
                        totalResultsCount = parseInt(totalCountMatch[1]);
                    }

                    // اتصال مجدد رویدادهای صفحه‌بندی
                    setupPaginationListeners();

                } catch (error) {
                    console.error('Error during search fetch:', error);
                    searchResultsContainer.innerHTML = `<div class="alert alert-danger" role="alert">خطا در دریافت نتایج جستجو. (${error.message})</div>`;
                    showToast('خطا در جستجو', 'error');
                }
            }

            // تابع برای اکسپورت با گزینه‌های انتخاب شده
            async function performExportWithOptions() {
                const formData = new FormData(filterForm);
                const exportType = document.querySelector('input[name="exportType"]:checked').value;
                formData.append('exportType', exportType);
                if (exportType === 'all') {
                    formData.append('limit', exportLimitInput.value);
                }

                const columns = [];
                if (document.getElementById('colDetailID').checked) columns.push('DetailID');
                if (document.getElementById('colANumber').checked) columns.push('ANumber');
                if (document.getElementById('colBNumber').checked) columns.push('BNumber');
                if (document.getElementById('colAccountingTime').checked) columns.push('AccountingTime');
                if (document.getElementById('colLength').checked) columns.push('Length');
                if (document.getElementById('colOriginCountry').checked) columns.push('OriginCountryName');
                if (document.getElementById('colOriginCity').checked) columns.push('OriginCityName');
                if (document.getElementById('colOriginOperator').checked) columns.push('OriginOperatorName');
                if (document.getElementById('colDestCountry').checked) columns.push('DestCountryName');
                if (document.getElementById('colDestCity').checked) columns.push('DestCityName');
                if (document.getElementById('colDestOperator').checked) columns.push('DestOperatorName');
                if (document.getElementById('colAnswer').checked) columns.push('Answer');
                formData.append('columns', columns.join(','));

                try {
                    const response = await fetch(`/Call/ExportWithOptions`, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value,
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: formData
                    });

                    if (!response.ok) throw new Error('Network response was not ok.');

                    exportModal.hide();
                    showToast('در حال آماده‌سازی فایل اکسپورت...');

                    const blob = await response.blob();
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.style.display = 'none';
                    a.href = url;
                    const exportTypeText = exportType === 'all' ? 'All' : 'Current';
                    a.download = `CallExport_${exportTypeText}_${new Date().toISOString().slice(0,10)}.csv`;
                    document.body.appendChild(a);
                    a.click();
                    window.URL.revokeObjectURL(url);
                    document.body.removeChild(a);

                    showToast('خروجی با موفقیت دانلود شد', 'success');
                } catch (error) {
                    console.error('Error:', error);
                    showToast('خطا در آماده‌سازی خروجی', 'error');
                }
            }

            // تابع برای قالب‌بندی و اعتبارسنجی تاریخ (غیرمسدودکننده)
            function formatDateInput(input) {
                let value = toEnglishDigits(input.value);
                value = value.replace(/[^\d]/g, '');
                if (value.length > 10) value = value.substring(0, 10);
                if (value.length > 4) value = value.substring(0, 4) + '/' + value.substring(4);
                if (value.length > 7) value = value.substring(0, 7) + '/' + value.substring(7);
                input.value = value;
            }

            // تابع کمکی برای تبدیل تاریخ شمسی به آرایه [سال, ماه, روز]
            function parsePersianDate(dateString) {
                if (!dateString || dateString.length !== 10) return null;
                const parts = dateString.split('/');
                if (parts.length !== 3) return null;
                const year = parseInt(parts[0]);
                const month = parseInt(parts[1]);
                const day = parseInt(parts[2]);
                if (isNaN(year) || isNaN(month) || isNaN(day)) return null;
                return [year, month, day];
            }

            /**
             * تابع جدید برای مقایسه مرحله‌ای تاریخ شروع و پایان
             */
            function validateDateRangeStepByStep() {
                const startDateValue = startDateInput.value;
                const endDateValue = endDateInput.value;
                const dateRangeErrorElement = document.getElementById('dateRangeError');

                // اگر یکی از تاریخ‌ها خالی باشد، خطای محدوده را پاک کن و معتبر در نظر بگیر
                if (!startDateValue || !endDateValue) {
                    if (dateRangeErrorElement) {
                        dateRangeErrorElement.textContent = '';
                    }
                    return { isValid: true, message: '' };
                }

                const start = parsePersianDate(startDateValue);
                const end = parsePersianDate(endDateValue);

                // اگر فرمت تاریخ‌ها نامعتبر بود، خطا را پاک کن (خطای فرمت در جای دیگر نمایش داده می‌شود)
                if (!start || !end) {
                    if (dateRangeErrorElement) {
                        dateRangeErrorElement.textContent = '';
                    }
                    return { isValid: true, message: '' };
                }

                const [startYear, startMonth, startDay] = start;
                const [endYear, endMonth, endDay] = end;

                // 1. بررسی سال
                if (startYear > endYear) {
                    return { isValid: false, message: 'سال شروع نباید از سال پایان بزرگتر باشد.' };
                }
                if (startYear < endYear) {
                    // سال شروع کوچکتر است، نیازی به بررسی ماه و روز نیست
                    return { isValid: true, message: '' };
                }

                // سال‌ها برابر است، به سراغ بررسی ماه برویم
                // 2. بررسی ماه
                if (startMonth > endMonth) {
                    return { isValid: false, message: 'ماه شروع نباید از ماه پایان بزرگتر باشد.' };
                }
                if (startMonth < endMonth) {
                    // ماه شروع کوچکتر است، نیازی به بررسی روز نیست
                    return { isValid: true, message: '' };
                }

                // ماه‌ها نیز برابر است، به سراغ بررسی روز برویم
                // 3. بررسی روز
                if (startDay > endDay) {
                    return { isValid: false, message: 'روز شروع نباید از روز پایان بزرگتر باشد.' };
                }

                // همه چیز برابر یا صحیح است
                return { isValid: true, message: '' };
            }

            // تابع برای به‌روزرسانی وضعیت دکمه جستجو و نمایش خطای محدوده
            function updateSearchButtonState() {
                const submitButton = document.querySelector('button[type="submit"]');
                const dateRangeErrorElement = document.getElementById('dateRangeError');

                // ابتدا خطاهای تک تک فیلدها را بررسی کن
                const hasStartDateError = startDateError.textContent.trim() !== '';
                const hasEndDateError = endDateError.textContent.trim() !== '';

                // سپس خطای محدوده را بررسی کن
                const rangeValidation = validateDateRangeStepByStep();
                const hasDateRangeError = !rangeValidation.isValid;

                // نمایش یا پنهان کردن پیام خطای محدوده
                if (dateRangeErrorElement) {
                    dateRangeErrorElement.textContent = rangeValidation.message;
                } else if (!rangeValidation.isValid) {
                    // اگر عنصر خطا وجود ندارد و خطایی رخ داده، آن را بساز
                    const errorDiv = document.createElement('div');
                    errorDiv.id = 'dateRangeError';
                    errorDiv.className = 'text-danger small mt-1';
                    // این عنصر باید بعد از input-group تاریخ پایان قرار گیرد
                    endDateInput.closest('.filter-field').appendChild(errorDiv);
                    errorDiv.textContent = rangeValidation.message;
                }

                // غیرفعال کردن دکمه جستجو اگر هر نوع خطایی وجود داشته باشد
                if (hasStartDateError || hasEndDateError || hasDateRangeError) {
                    submitButton.disabled = true;
                } else {
                    submitButton.disabled = false;
                }
            }

            // تابع برای اعتبارسنجی و نمایش خطا (غیرمسدودکننده) - این تابع را جایگزین کنید
            function validateDate(input, errorElement) {
                const value = input.value;
                if (!value) {
                    errorElement.textContent = '';
                    updateSearchButtonState(); // همیشه وضعیت دکمه را به‌روز کن
                    return;
                }

                const datePattern = /^(\d{4})\/(\d{2})\/(\d{2})$/;
                if (!datePattern.test(value)) {
                    errorElement.textContent = 'فرمت تاریخ باید به صورت YYYY/MM/DD باشد';
                    updateSearchButtonState();
                    return;
                }

                const match = value.match(datePattern);
                const year = parseInt(match[1]);
                const month = parseInt(match[2]);
                const day = parseInt(match[3]);
                const currentYear = new persianDate().year();

                if (year < 1390) {
                    errorElement.textContent = 'سال نباید کمتر از 1390 باشد';
                    updateSearchButtonState();
                    return;
                }
                if (year > currentYear) {
                    errorElement.textContent = 'سال نباید از سال جاری بیشتر باشد';
                    updateSearchButtonState();
                    return;
                }
                if (month < 1 || month > 12) {
                    errorElement.textContent = 'ماه باید بین 1 تا 12 باشد';
                    updateSearchButtonState();
                    return;
                }
                if (day < 1 || day > 31) {
                    errorElement.textContent = 'روز باید بین 1 تا 31 باشد';
                    updateSearchButtonState();
                    return;
                }
                if (month >= 7 && month <= 11 && day > 30) {
                    errorElement.textContent = 'این ماه حداکثر 30 روز دارد';
                    updateSearchButtonState();
                    return;
                }
                if (month === 12) {
                    const isLeapYear = (year % 4 === 3);
                    const maxDay = isLeapYear ? 30 : 29;
                    if (day > maxDay) {
                        errorElement.textContent = `اسفند در سال ${year} حداکثر ${maxDay} روز دارد`;
                        updateSearchButtonState();
                        return;
                    }
                }

                const today = new persianDate();
                const inputDate = new persianDate([year, month, day]);
                if (inputDate.isAfter(today)) {
                    errorElement.textContent = 'تاریخ نباید از امروز بیشتر باشد';
                    updateSearchButtonState();
                    return;
                }

                errorElement.textContent = '';
                updateSearchButtonState(); // بعد از پاک کردن خطا، وضعیت دکمه را به‌روز کن
            }

            // تابع برای بازنشانی کامل فرم
            function resetForm() {
                filterForm.reset();
                // Reset page to 1
                document.getElementById('Filter_Page').value = 1;

                document.getElementById('origin-country-input').value = '';
                document.getElementById('origin-city-input').value = '';
                document.getElementById('origin-operator-input').value = '';
                document.getElementById('dest-country-input').value = '';
                document.getElementById('dest-city-input').value = '';
                document.getElementById('dest-operator-input').value = '';
                document.getElementById('answer-input').value = '';
                document.getElementById('pagesize-input').value = '50';

                document.querySelectorAll('.custom-dropdown .dropdown-toggle').forEach(button => {
                    if (button.id.includes('country')) {
                        button.textContent = 'انتخاب کنید';
                    } else if (button.id.includes('city') || button.id.includes('operator')) {
                        button.textContent = 'ابتدا کشور را انتخاب کنید';
                    } else if (button.id === 'answer-button') {
                        button.textContent = 'همه';
                    } else if (button.id === 'pagesize-button') {
                        button.textContent = '50';
                    }
                    button.disabled = button.id.includes('city') || button.id.includes('operator');
                });

                document.querySelectorAll('.custom-dropdown .dropdown-menu').forEach(menu => {
                    menu.querySelectorAll('.dropdown-item').forEach(item => item.classList.remove('active'));
                    if (menu.closest('#pagesize-dropdown')) {
                        const defaultItem = menu.querySelector('a[data-value="50"]');
                        if (defaultItem) {
                            defaultItem.classList.add('active');
                        }
                    }
                });

                startDateError.textContent = '';
                endDateError.textContent = '';
                // پاک کردن خطای محدوده در هنگام بازنشانی
                const dateRangeError = document.getElementById('dateRangeError');
                if (dateRangeError) {
                    dateRangeError.textContent = '';
                }

                exportBtn.disabled = true;

                searchResultsContainer.innerHTML = `
                    <div class="text-center p-4">
                        <i class="fas fa-search fa-3x text-muted mb-3"></i>
                        <p class="text-muted">برای جستجوی تماس‌ها، فیلترهای مورد نظر را اعمال کنید.</p>
                        <div class="global-animation-container" id="globalAnimation">
                            <div class="animation-text" id="animationText">در انتظار برای انجام جستجو</div>
                            <div class="signal-pulse-container" id="signalPulse">
                                <div class="signal-pulse-point">
                                    <div class="signal-pulse-ring"></div>
                                    <div class="signal-pulse-ring"></div>
                                    <div class="signal-pulse-ring"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;

                setTimeout(() => {
                    startGlobalAnimation();
                }, 100);

                showToast('فیلترها با موفقیت بازنشانی شدند', 'success');
            }

            // --- اتصال رویدادها ---
            setupDropdownListener('origin-country-button', 'origin-country-input', 'origin-country-dropdown');
            setupDropdownListener('origin-city-button', 'origin-city-input', 'origin-city-dropdown');
            setupDropdownListener('dest-country-button', 'dest-country-input', 'dest-country-dropdown');
            setupDropdownListener('dest-city-button', 'dest-city-input', 'dest-city-dropdown');
            setupDropdownListener('origin-operator-button', 'origin-operator-input', 'origin-operator-dropdown');
            setupDropdownListener('dest-operator-button', 'dest-operator-input', 'dest-operator-dropdown');
            setupDropdownListener('answer-button', 'answer-input', 'answer-dropdown');
            setupDropdownListener('pagesize-button', 'pagesize-input', 'pagesize-dropdown');

            originCountryInput.addEventListener('change', () => {
                loadCities('origin-country-input', 'origin-city-button', 'origin-city-input', 'origin-city-dropdown');
                loadOperators('origin-country-input', 'origin-operator-button', 'origin-operator-input', 'origin-operator-dropdown');
            });

            destCountryInput.addEventListener('change', () => {
                loadCities('dest-country-input', 'dest-city-button', 'dest-city-input', 'dest-city-dropdown');
                loadOperators('dest-country-input', 'dest-operator-button', 'dest-operator-input', 'dest-operator-dropdown');
            });

            detectOriginBtn.addEventListener('click', () => {
                populateFieldsFromPhoneInfo(aNumberInput.value, 'origin-country-input', 'origin-city-button', 'origin-city-input', 'origin-city-dropdown', 'origin-operator-button', 'origin-operator-input', 'origin-operator-dropdown');
            });

            detectDestBtn.addEventListener('click', () => {
                populateFieldsFromPhoneInfo(bNumberInput.value, 'dest-country-input', 'dest-city-button', 'dest-city-input', 'dest-city-dropdown', 'dest-operator-button', 'dest-operator-input', 'dest-operator-dropdown');
            });

            startDateClear.addEventListener('click', () => {
                startDateInput.value = '';
                startDateError.textContent = '';
                updateSearchButtonState(); // وضعیت دکمه را به‌روز کن
            });
            endDateClear.addEventListener('click', () => {
                endDateInput.value = '';
                endDateError.textContent = '';
                updateSearchButtonState(); // وضعیت دکمه را به‌روز کن
            });

            swapOriginDestBtn.addEventListener('click', () => {
                const tempCountry = originCountryInput.value;
                originCountryInput.value = destCountryInput.value;
                destCountryInput.value = tempCountry;
                originCountryInput.dispatchEvent(new Event('change'));
                destCountryInput.dispatchEvent(new Event('change'));

                setTimeout(() => {
                    const tempCity = originCityInput.value;
                    originCityInput.value = destCityInput.value;
                    destCityInput.value = tempCity;
                    const tempOperator = originOperatorInput.value;
                    originOperatorInput.value = destOperatorInput.value;
                    destOperatorInput.value = tempOperator;
                }, 500);

                const tempButtonText = originCountryButton.textContent;
                originCountryButton.textContent = destCountryButton.textContent;
                destCountryButton.textContent = tempButtonText;
                const tempCityButtonText = originCityButton.textContent;
                originCityButton.textContent = destCityButton.textContent;
                destCityButton.textContent = tempCityButtonText;
                const tempOperatorButtonText = originOperatorButton.textContent;
                originOperatorButton.textContent = destOperatorButton.textContent;
                destOperatorButton.textContent = tempOperatorButtonText;
                const tempANumber = aNumberInput.value;
                aNumberInput.value = bNumberInput.value;
                bNumberInput.value = tempANumber;

                showToast('مبدأ و مقصد با موفقیت جابجا شدند', 'success');
            });

            resetBtn.addEventListener('click', resetForm);
            exportBtn.addEventListener('click', () => {
                totalRecordsSpan.textContent = totalResultsCount;
                exportLimitInput.value = totalResultsCount > 0 ? Math.min(totalResultsCount, 1000) : 100;
                updateEstimatedSize();
                exportModal.show();
            });
            confirmExportBtn.addEventListener('click', () => { performExportWithOptions(); });
            filterForm.addEventListener('submit', function(e) {
                e.preventDefault();
                // فقط در صورتی که اعتبارسنجی موفقیت‌آمیز بود، جستجو را انجام بده
                if (!document.querySelector('button[type="submit"]').disabled) {
                    // Reset page to 1 on new search
                    document.getElementById('Filter_Page').value = 1;
                    performSearch(1);
                }
            });
            document.querySelector('[data-bs-toggle="collapse"]').addEventListener('click', function() {
                filterToggleIcon.classList.toggle('fa-chevron-up');
                filterToggleIcon.classList.toggle('fa-chevron-down');
            });
            exportLimitInput.addEventListener('input', updateEstimatedSize);
            document.querySelectorAll('#exportModal .form-check-input[type="checkbox"]').forEach(checkbox => {
                checkbox.addEventListener('change', updateEstimatedSize);
            });
            exportAllRadio.addEventListener('change', toggleExportSections);
            exportCurrentRadio.addEventListener('change', toggleExportSections);

            aNumberInput.addEventListener('blur', () => {
                populateFieldsFromPhoneInfo(
                    aNumberInput.value,
                    'origin-country-input',
                    'origin-city-button',
                    'origin-city-input',
                    'origin-city-dropdown',
                    'origin-operator-button',
                    'origin-operator-input',
                    'origin-operator-dropdown'
                );
            });

            bNumberInput.addEventListener('blur', () => {
                populateFieldsFromPhoneInfo(
                    bNumberInput.value,
                    'dest-country-input',
                    'dest-city-button',
                    'dest-city-input',
                    'dest-city-dropdown',
                    'dest-operator-button',
                    'dest-operator-input',
                    'dest-operator-dropdown'
                );
            });

            document.addEventListener('keydown', function(e) {
                if (e.ctrlKey && e.key === 'Enter') {
                    e.preventDefault();
                    // فقط در صورتی که اعتبارسنجی موفقیت‌آمیز بود، جستجو را انجام بده
                    if (!document.querySelector('button[type="submit"]').disabled) {
                        // Reset page to 1 on new search
                        document.getElementById('Filter_Page').value = 1;
                        performSearch(1);
                    }
                }
                if (e.ctrlKey && e.key === 'r') { e.preventDefault(); resetForm(); }
            });

            // رویدادهای مربوط به تاریخ‌ها را به‌روز کنید
            startDateInput.addEventListener('input', function() {
                formatDateInput(this);
                // در حین تایپ، وضعیت دکمه را به‌روز کن تا کاربر بازخورد فوری ببیند
                updateSearchButtonState();
            });
            startDateInput.addEventListener('blur', function() {
                validateDate(this, startDateError);
            });
            endDateInput.addEventListener('input', function() {
                formatDateInput(this);
                // در حین تایپ، وضعیت دکمه را به‌روز کن
                updateSearchButtonState();
            });
            endDateInput.addEventListener('blur', function() {
                validateDate(this, endDateError);
            });

            // مقداردهی اولیه از مدل
            function setInitialDropdown(inputId, buttonId) {
                const input = document.getElementById(inputId);
                const button = document.getElementById(buttonId);
                if (input.value) {
                    const menu = button.nextElementSibling;
                    const item = menu.querySelector(`a[data-value="${input.value}"]`);
                    if (item) {
                        button.textContent = item.textContent;
                        menu.querySelectorAll('.dropdown-item').forEach(i => i.classList.remove('active'));
                        item.classList.add('active');
                    }
                }
            }

            setInitialDropdown('origin-country-input', 'origin-country-button');
            setInitialDropdown('dest-country-input', 'dest-country-button');
            setInitialDropdown('answer-input', 'answer-button');
            setInitialDropdown('pagesize-input', 'pagesize-button');

            const initialOriginCountryId = '@Model.Filter.OriginCountryID';
            const initialDestCountryId = '@Model.Filter.DestCountryID';

            if (initialOriginCountryId) {
                originCountryInput.dispatchEvent(new Event('change'));
                setTimeout(() => {
                    setInitialDropdown('origin-city-input', 'origin-city-button');
                    setInitialDropdown('origin-operator-input', 'origin-operator-button');
                }, 500);
            }

            if (initialDestCountryId) {
                destCountryInput.dispatchEvent(new Event('change'));
                setTimeout(() => {
                    setInitialDropdown('dest-city-input', 'dest-city-button');
                    setInitialDropdown('dest-operator-input', 'dest-operator-button');
                }, 500);
            }

            @if (Model.Results != null)
            {
                                <text>
                                    exportBtn.disabled = false;
                                    totalResultsCount = @Model.Results.TotalCount;
                                    setupPaginationListeners();
                                </text>
            }
            else
            {
                                <text>
                                    setTimeout(() => {
                                        startGlobalAnimation();
                                    }, 100);
                                </text>
            }

            if (typeof $ !== 'undefined' && $.fn.persianDatepicker) {
                $(startDateInput).persianDatepicker({
                    format: 'YYYY/MM/DD',
                    autoClose: true,
                    observer: true,
                    initialValue: false,
                    onSelect: function() {
                        const persianDateString = $(this).val();
                        const englishDateString = toEnglishDigits(persianDateString);
                        $(this).val(englishDateString);
                        $(this).trigger('change');
                        validateDate(this, startDateError);
                    }
                });
                $(endDateInput).persianDatepicker({
                    format: 'YYYY/MM/DD',
                    autoClose: true,
                    observer: true,
                    initialValue: false,
                    onSelect: function() {
                        const persianDateString = $(this).val();
                        const englishDateString = toEnglishDigits(persianDateString);
                        $(this).val(englishDateString);
                        $(this).trigger('change');
                        validateDate(this, endDateError);
                    }
                });
            } else {
                console.warn("jQuery or persianDatepicker is not loaded. Date pickers will not be initialized.");
            }

            convertDatesToPersian();

            // در انتهای اسکریپت، این خط را برای بررسی اولیه اضافه کنید:
            // این کار باعث می‌شود اگر فرم با مقادیر اولیه لود شده، دکمه جستجو وضعیت درستی داشته باشد.
            if (startDateInput.value || endDateInput.value) {
                updateSearchButtonState();
            }
        });
    </script>
}