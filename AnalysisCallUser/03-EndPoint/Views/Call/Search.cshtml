@model AnalysisCallUser._03_EndPoint.Models.ViewModels.Call.CallSearchViewModel
@{
    ViewData["Title"] = "جستجوی تماس";
}
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@{
    var tokenSet = Antiforgery.GetAndStoreTokens(Context);
}
<!-- استایل‌ها -->
<style>
    .phone-info-container {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 1050;
        padding: 0.75rem;
        margin-top: 0.25rem;
        background-color: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        color: #212529;
    }

    .input-group {
        position: relative;
    }

    .phone-info-trigger {
        cursor: pointer;
    }

    .phone-info-content {
        font-size: 0.875rem;
        line-height: 1.5;
    }

        .phone-info-content strong {
            color: #6f42c1;
        }

    /* استایل دراپ‌داون */
    .custom-dropdown {
        width: 100%;
    }

        .custom-dropdown .dropdown-menu {
            background-color: #ffffff !important;
            border-color: #dee2e6 !important;
            color: #212529 !important;
            box-shadow: 0 0.5rem 1rem rgba(111, 66, 193, 0.2);
            max-height: 300px;
            overflow-y: auto;
            border-radius: 0.5rem;
            padding: 0.5rem 0;
            border: 1px solid #e9ecef;
        }

        .custom-dropdown .dropdown-item {
            color: #212529 !important;
            padding: 0.5rem 1rem;
            font-size: 0.85rem;
            text-align: right;
            transition: all 0.2s ease;
            border-radius: 0.25rem;
            margin: 0.125rem 0.5rem;
            border-left: 3px solid transparent;
        }

            .custom-dropdown .dropdown-item:hover {
                background-color: #f3e8ff !important;
                color: #6f42c1 !important;
                transform: translateX(-3px);
                border-left: 3px solid #6f42c1;
            }

        .custom-dropdown .dropdown-toggle {
            background-color: #ffffff !important;
            border: 1px solid #ced4da !important;
            color: #212529 !important;
            text-align: right;
            width: 100%;
            padding: 0.5rem 0.75rem;
            font-size: 0.85rem;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .custom-dropdown .dropdown-toggle:hover {
                background-color: #ffffff !important;
                border-color: #9d7bd8 !important;
                color: #6f42c1 !important;
                box-shadow: 0 0 0 0.2rem rgba(111, 66, 193, 0.15);
            }

            .custom-dropdown .dropdown-toggle::after {
                color: #6f42c1;
                margin-right: auto;
                margin-left: 10px;
                transition: transform 0.3s ease;
            }

        .custom-dropdown.show .dropdown-toggle::after {
            transform: rotate(180deg);
        }

    .phone-number-info {
        font-size: 0.8rem;
        margin-top: 0.25rem;
        padding: 0.375rem 0.75rem;
        background-color: #f8f9fa;
        border-radius: 0.375rem;
        color: #495057;
        border: 1px solid #e9ecef;
        transition: all 0.3s ease;
    }

        .phone-number-info:hover {
            background-color: #f3e8ff;
            border-color: #9d7bd8;
            color: #6f42c1;
        }

    .phone-info-trigger {
        cursor: pointer;
        background-color: #f3e8ff;
        border-color: #9d7bd8;
        color: #6f42c1;
        transition: all 0.3s ease;
    }

        .phone-info-trigger:hover {
            background-color: #6f42c1;
            color: #ffffff;
            transform: scale(1.1);
        }

    .required-field label:after {
        content: " *";
        color: #dc3545;
        font-weight: bold;
    }

    .date-required-alert {
        display: none;
        margin-top: 0.5rem;
        padding: 0.5rem;
        border-radius: 0.375rem;
        background-color: #f8d7da;
        border: 1px solid #f5c6cb;
        color: #721c24;
        font-size: 0.875rem;
    }

    .file-error-alert {
        display: none;
        margin-top: 0.5rem;
        padding: 0.5rem;
        border-radius: 0.375rem;
        background-color: #f8d7da;
        border: 1px solid #f5c6cb;
        color: #721c24;
        font-size: 0.875rem;
    }
</style>

<!-- Scripts Externos -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/persian-datepicker@0.4.5/dist/css/persian-datepicker.min.css" />
<script src="https://cdn.jsdelivr.net/npm/persian-date@1.1.0/dist/persian-date.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/persian-datepicker@0.4.5/dist/js/persian-datepicker.min.js"></script>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-3">
            <div class="card sticky-top" style="top: 20px;">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">فیلترها</h4>
                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#filterCardBody" aria-expanded="true" aria-controls="filterCardBody">
                        <i class="fas fa-chevron-up" id="filterToggleIcon"></i>
                    </button>
                </div>
                <div class="card-body collapse show" id="filterCardBody">
                    <form asp-action="Search" method="post" id="filter-form" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Filter.Page" id="Filter_Page" value="1" />

                        <!-- تاریخ -->
                        <div class="filter-section required-field">
                            <div class="filter-section-title">
                                <i class="fas fa-calendar-alt"></i> بازه زمانی <span style="color: #dc3545; font-size: 0.9rem;">(اجباری)</span>
                            </div>
                            <div class="date-required-alert" id="dateRequiredAlert">
                                <i class="fas fa-exclamation-triangle me-1"></i>
                                لطفاً تاریخ شروع و پایان را انتخاب کنید
                            </div>
                            <div class="filter-row">
                                <div class="filter-field">
                                    <label asp-for="Filter.StartDate" class="form-label"></label>
                                    <div class="input-group">
                                        <input asp-for="Filter.StartDate" type="text" class="form-control persian-date-input required-date" placeholder="تاریخ شروع را انتخاب کنید" id="Filter_StartDate" maxlength="10" required />
                                        <span class="input-group-text" id="startDateClear"><i class="fas fa-times"></i></span>
                                    </div>
                                    <div class="text-danger small" id="startDateError"></div>
                                </div>
                                <div class="filter-field">
                                    <label asp-for="Filter.EndDate" class="form-label"></label>
                                    <div class="input-group">
                                        <input asp-for="Filter.EndDate" type="text" class="form-control persian-date-input required-date" placeholder="تاریخ پایان را انتخاب کنید" id="Filter_EndDate" maxlength="10" required />
                                        <span class="input-group-text" id="endDateClear"><i class="fas fa-times"></i></span>
                                    </div>
                                    <div class="text-danger small" id="endDateError"></div>
                                </div>
                            </div>
                        </div>

                        <!-- --- افزودن شده: جستجوی شماره‌ها (لیست/تک) --- -->
                        <div class="filter-section">
                            <div class="filter-section-title">
                                <i class="fas fa-phone-square"></i> جستجوی شماره‌ها (لیست/تک)
                                <span style="font-size: 0.75rem; color: #6c757d; font-weight: normal; margin-right: 10px;">
                                    (جستجو در مبدا یا مقصد)
                                </span>
                            </div>

                            <div class="filter-row">
                                <div class="filter-field w-100">
                                    <label class="form-label">تک شماره</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" placeholder="شماره تکی را وارد کنید..." name="Filter.SingleNumberText" id="Filter_SingleNumberText" value="" />
                                        <span class="input-group-text text-muted">یا</span>
                                    </div>
                                </div>
                            </div>

                            <div class="filter-row mt-2">
                                <div class="filter-field w-100">
                                    <label class="form-label">لیست شماره‌ها (فایل متنی یا CSV)</label>
                                    <div class="input-group">
                                        <input type="file" class="form-control" name="numberListFile" id="numberListFile" accept=".txt, .csv" />
                                        <span class="input-group-text" style="font-size: 0.8rem; max-width: 150px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            حداکثر 50 شماره (هر خط یک شماره)
                                        </span>
                                    </div>
                                    <!-- خطای اعتبارسنجی فایل -->
                                    <div class="file-error-alert alert alert-danger mt-2" id="fileErrorAlert" style="display: none; font-size: 0.85rem;">
                                        <i class="fas fa-exclamation-triangle me-1"></i>
                                        <span id="fileErrorMessage"></span>
                                    </div>
                                    <div class="form-text text-muted mt-1" style="font-size: 0.8rem;">
                                        فایل باید شامل شماره‌ها باشد که در هر خط یک شماره قرار دارد. فاصله یا کاما نادیده گرفته می‌شود.
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- ---------------------------------------------- -->
                        <!-- شماره‌های مبدأ -->
                        <div class="filter-section">
                            <div class="filter-section-title">
                                <i class="fas fa-phone-alt"></i> شماره‌های مبدأ
                                <button type="button" class="btn btn-sm btn-outline-info float-end" id="addANumber"><i class="fas fa-plus"></i></button>
                            </div>
                            <div id="anumbers-container">
                                <div class="filter-row anumber-row" data-index="0">
                                    <div class="filter-field">
                                        <label class="form-label">شماره مبدأ 1</label>
                                        <div class="input-group">
                                            <input type="text" class="form-control anumber-input" placeholder="شماره مبدأ را وارد کنید" name="Filter.ANumbers" />
                                            <button class="btn btn-outline-secondary remove-anumber" type="button" title="حذف شماره"><i class="fas fa-times"></i></button>
                                            <span class="input-group-text phone-info-trigger" title="نمایش اطلاعات" style="display: none;"><i class="fas fa-info-circle"></i></span>
                                            <div class="phone-info-container" style="display: none;"><div class="phone-info-content"></div></div>
                                        </div>
                                        <div class="phone-number-info" id="anumber-info-0" style="display: none;"><i class="fas fa-map-marker-alt"></i> <span id="anumber-location-0"></span></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- شماره‌های مقصد -->
                        <div class="filter-section">
                            <div class="filter-section-title">
                                <i class="fas fa-phone-alt"></i> شماره‌های مقصد
                                <button type="button" class="btn btn-sm btn-outline-info float-end" id="addBNumber"><i class="fas fa-plus"></i></button>
                            </div>
                            <div id="bnumbers-container">
                                <div class="filter-row bnumber-row" data-index="0">
                                    <div class="filter-field">
                                        <label class="form-label">شماره مقصد 1</label>
                                        <div class="input-group">
                                            <input type="text" class="form-control bnumber-input" placeholder="شماره مقصد را وارد کنید" name="Filter.BNumbers" />
                                            <button class="btn btn-outline-secondary remove-bnumber" type="button" title="حذف شماره"><i class="fas fa-times"></i></button>
                                            <span class="input-group-text phone-info-trigger" title="نمایش اطلاعات" style="display: none;"><i class="fas fa-info-circle"></i></span>
                                            <div class="phone-info-container" style="display: none;"><div class="phone-info-content"></div></div>
                                        </div>
                                        <div class="phone-number-info" id="bnumber-info-0" style="display: none;"><i class="fas fa-map-marker-alt"></i> <span id="bnumber-location-0"></span></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- فیلدهای مبدأ -->
                        <div class="filter-section" id="origin-location-section">
                            <div class="filter-section-title">
                                <i class="fas fa-map-marker-alt"></i> اطلاعات مکان مبدأ
                                <button type="button" class="btn btn-sm btn-outline-info float-end" id="swapOriginDest"><i class="fas fa-exchange-alt"></i></button>
                            </div>
                            <div class="filter-row">
                                <div class="filter-field">
                                    <label asp-for="Filter.OriginCountryID" class="form-label"></label>
                                    <input type="hidden" asp-for="Filter.OriginCountryID" id="origin-country-input" />
                                    <div class="dropdown custom-dropdown" id="origin-country-dropdown">
                                        <button class="btn btn-secondary dropdown-toggle" type="button" id="origin-country-button" data-bs-toggle="dropdown" aria-expanded="false">انتخاب کنید</button>
                                        <ul class="dropdown-menu" aria-labelledby="origin-country-button">
                                            <li><a class="dropdown-item" href="#" data-value="">همه</a></li>
                                            @if (Model.Countries != null)
                                            {
                                                @foreach (var country in Model.Countries)
                                                {
                                                    <li><a class="dropdown-item" href="#" data-value="@country.CountryID">@country.CountryName</a></li>
                                                }
                                            }
                                        </ul>
                                    </div>
                                </div>
                                <div class="filter-field">
                                    <label asp-for="Filter.OriginCityID" class="form-label"></label>
                                    <input type="hidden" asp-for="Filter.OriginCityID" id="origin-city-input" />
                                    <div class="dropdown custom-dropdown" id="origin-city-dropdown">
                                        <button class="btn btn-secondary dropdown-toggle" type="button" id="origin-city-button" data-bs-toggle="dropdown" aria-expanded="false" disabled>ابتدا کشور را انتخاب کنید</button>
                                        <ul class="dropdown-menu" aria-labelledby="origin-city-button"><li><a class="dropdown-item" href="#" data-value="">همه</a></li></ul>
                                    </div>
                                </div>
                            </div>
                            <div class="filter-row">
                                <div class="filter-field">
                                    <label asp-for="Filter.OriginOperatorID" class="form-label"></label>
                                    <input type="hidden" asp-for="Filter.OriginOperatorID" id="origin-operator-input" />
                                    <div class="dropdown custom-dropdown" id="origin-operator-dropdown">
                                        <button class="btn btn-secondary dropdown-toggle" type="button" id="origin-operator-button" data-bs-toggle="dropdown" aria-expanded="false" disabled>ابتدا کشور را انتخاب کنید</button>
                                        <ul class="dropdown-menu" aria-labelledby="origin-operator-button"><li><a class="dropdown-item" href="#" data-value="">همه</a></li></ul>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- فیلدهای مقصد -->
                        <div class="filter-section" id="dest-location-section">
                            <div class="filter-section-title">
                                <i class="fas fa-map-marker-alt"></i> اطلاعات مکان مقصد
                            </div>
                            <div class="filter-row">
                                <div class="filter-field">
                                    <label asp-for="Filter.DestCountryID" class="form-label"></label>
                                    <input type="hidden" asp-for="Filter.DestCountryID" id="dest-country-input" />
                                    <div class="dropdown custom-dropdown" id="dest-country-dropdown">
                                        <button class="btn btn-secondary dropdown-toggle" type="button" id="dest-country-button" data-bs-toggle="dropdown" aria-expanded="false">انتخاب کنید</button>
                                        <ul class="dropdown-menu" aria-labelledby="dest-country-button">
                                            <li><a class="dropdown-item" href="#" data-value="">همه</a></li>
                                            @if (Model.Countries != null)
                                            {
                                                @foreach (var country in Model.Countries)
                                                {
                                                    <li><a class="dropdown-item" href="#" data-value="@country.CountryID">@country.CountryName</a></li>
                                                }
                                            }
                                        </ul>
                                    </div>
                                </div>
                                <div class="filter-field">
                                    <label asp-for="Filter.DestCityID" class="form-label"></label>
                                    <input type="hidden" asp-for="Filter.DestCityID" id="dest-city-input" />
                                    <div class="dropdown custom-dropdown" id="dest-city-dropdown">
                                        <button class="btn btn-secondary dropdown-toggle" type="button" id="dest-city-button" data-bs-toggle="dropdown" aria-expanded="false" disabled>ابتدا کشور را انتخاب کنید</button>
                                        <ul class="dropdown-menu" aria-labelledby="dest-city-button"><li><a class="dropdown-item" href="#" data-value="">همه</a></li></ul>
                                    </div>
                                </div>
                            </div>
                            <div class="filter-row">
                                <div class="filter-field">
                                    <label asp-for="Filter.DestOperatorID" class="form-label"></label>
                                    <input type="hidden" asp-for="Filter.DestOperatorID" id="dest-operator-input" />
                                    <div class="dropdown custom-dropdown" id="dest-operator-dropdown">
                                        <button class="btn btn-secondary dropdown-toggle" type="button" id="dest-operator-button" data-bs-toggle="dropdown" aria-expanded="false" disabled>ابتدا کشور را انتخاب کنید</button>
                                        <ul class="dropdown-menu" aria-labelledby="dest-operator-button"><li><a class="dropdown-item" href="#" data-value="">همه</a></li></ul>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- فیلدهای دیگر -->
                        <div class="filter-section">
                            <div class="filter-section-title"><i class="fas fa-filter"></i> سایر فیلترها</div>
                            <div class="filter-row">
                                <div class="filter-field">
                                    <label asp-for="Filter.Answer" class="form-label"></label>
                                    <input type="hidden" asp-for="Filter.Answer" id="answer-input" />
                                    <div class="dropdown custom-dropdown" id="answer-dropdown">
                                        <button class="btn btn-secondary dropdown-toggle" type="button" id="answer-button" data-bs-toggle="dropdown" aria-expanded="false">همه</button>
                                        <ul class="dropdown-menu" aria-labelledby="answer-button">
                                            <li><a class="dropdown-item" href="#" data-value="">همه</a></li>
                                            <li><a class="dropdown-item" href="#" data-value="@AnalysisCallUser._01_Domain.Core.Enums.CallAnswerStatus.Answered">پاسخ داده شده</a></li>
                                            <li><a class="dropdown-item" href="#" data-value="@AnalysisCallUser._01_Domain.Core.Enums.CallAnswerStatus.NotAnswered">پاسخ داده نشده</a></li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="filter-field">
                                    <label asp-for="Filter.PageSize" class="form-label"></label>
                                    <input type="hidden" asp-for="Filter.PageSize" id="pagesize-input" value="50" />
                                    <div class="dropdown custom-dropdown" id="pagesize-dropdown">
                                        <button class="btn btn-secondary dropdown-toggle" type="button" id="pagesize-button" data-bs-toggle="dropdown" aria-expanded="false">50</button>
                                        <ul class="dropdown-menu" aria-labelledby="pagesize-button">
                                            <li><a class="dropdown-item" href="#" data-value="10">10</a></li>
                                            <li><a class="dropdown-item" href="#" data-value="25">25</a></li>
                                            <li><a class="dropdown-item active" href="#" data-value="50">50</a></li>
                                            <li><a class="dropdown-item" href="#" data-value="100">100</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- دکمه‌ها -->
                        <div class="filter-section">
                            <div class="filter-row">
                                <button type="submit" class="btn btn-primary flex-fill" id="searchButton"><i class="fas fa-search"></i> جستجو</button>
                                <button type="button" id="reset-filter" class="btn btn-warning flex-fill" style="background-color: #ffc107; border-color: #ffc107; color: #212529;"><i class="fas fa-redo"></i> بازنشانی</button>
                            </div>
                            <div class="filter-row mt-2">
                                <button type="button" id="export-results" class="btn btn-success flex-fill" disabled><i class="fas fa-file-export"></i> خروجی اکسل</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-9">
            <div id="search-results-container">
                @if (Model.Results != null)
                {
                    <partial name="_SearchResults" model="Model.Results" />
                }
                else
                {
                    <div class="text-center p-4">
                        <i class="fas fa-search fa-3x text-muted mb-3"></i>
                        <p class="text-muted">برای جستجوی تماس‌ها، فیلترهای مورد نظر را اعمال کنید.</p>
                        <div class="global-animation-container" id="globalAnimation">
                            <div class="animation-text" id="animationText">...در حال انتظار برای جستجو</div>
                            <div class="signal-pulse-container" id="signalPulse">
                                <div class="signal-pulse-point">
                                    <div class="signal-pulse-ring"></div>
                                    <div class="signal-pulse-ring"></div>
                                    <div class="signal-pulse-ring"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Toast notification -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
    <div id="notificationToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
            <i class="fas fa-info-circle text-primary me-2"></i>
            <strong class="me-auto">اطلاعیه</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body" id="toastMessage">پیام اطلاع‌رسانی</div>
    </div>
</div>

<!-- Modal for export options -->
<div class="modal fade" id="exportModal" tabindex="-1" aria-labelledby="exportModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exportModalLabel">اکسپورت نتایج جستجو</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">نوع اکسپورت</label>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="exportType" id="exportAll" value="all" checked>
                        <label class="form-check-label" for="exportAll">تمام نتایج فیلتر شده بر اساس تعداد ردیف مشخص شده</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="exportType" id="exportCurrent" value="current">
                        <label class="form-check-label" for="exportCurrent">تمامی نتایج فیلتر شده</label>
                    </div>
                </div>
                <div id="allResultsSection">
                    <div class="mb-3">
                        <label class="form-label">تعداد کل رکوردها: <span id="totalRecords" class="badge bg-primary">100</span></label>
                    </div>
                    <div class="mb-3">
                        <label for="exportLimit" class="form-label">محدودیت تعداد رکوردها برای اکسپورت</label>
                        <div class="input-group">
                            <input type="number" class="form-control" id="exportLimit" min="1" max="10000" value="100">
                            <span class="input-group-text">ردیف</span>
                        </div>
                        <div class="form-text">حداکثر حجم فایل: <span id="estimatedSize">0</span> MB (حداکثر مجاز: 50MB)</div>
                    </div>
                </div>
                <div id="currentResultsSection" style="display: none;">
                    <div class="mb-3">
                        <label class="form-label">تعداد رکوردهای نمایش داده شده: <span id="currentRecords" class="badge bg-info">50</span></label>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">ستون‌های مورد نظر برای اکسپورت</label>
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="colDetailID" checked><label class="form-check-label" for="colDetailID">شناسه تماس</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="colANumber" checked><label class="form-check-label" for="colANumber">شماره مبدأ</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="colBNumber" checked><label class="form-check-label" for="colBNumber">شماره مقصد</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="colAccountingTime" checked><label class="form-check-label" for="colAccountingTime">تاریخ و زمان</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="colLength" checked><label class="form-check-label" for="colLength">مدت زمان (ثانیه)</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="colOriginCountry" checked><label class="form-check-label" for="colOriginCountry">کشور مبدأ</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="colOriginCity"><label class="form-check-label" for="colOriginCity">شهر مبدأ</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="colOriginOperator"><label class="form-check-label" for="colOriginOperator">اپراتور مبدأ</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="colDestCountry" checked><label class="form-check-label" for="colDestCountry">کشور مقصد</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="colDestCity"><label class="form-check-label" for="colDestCity">شهر مقصد</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="colDestOperator"><label class="form-check-label" for="colDestOperator">اپراتور مقصد</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="colAnswer" checked><label class="form-check-label" for="colAnswer">وضعیت پاسخ</label></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" id="confirmExport">اکسپورت</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // --- تعریف متغیرهای اصلی ---
            let aNumberCount = 1, bNumberCount = 1, totalResultsCount = 0, isResetting = false;
            const LOCAL_STORAGE_KEY = 'callSearchFilters_v3';
            const SESSION_FLAG_KEY = 'sessionFiltersApplied';

            const filterForm = document.getElementById('filter-form');
            const resetBtn = document.getElementById('reset-filter');
            const exportBtn = document.getElementById('export-results');
            const searchButton = document.getElementById('searchButton');
            const searchResultsContainer = document.getElementById('search-results-container');
            const dateRequiredAlert = document.getElementById('dateRequiredAlert');
            const startDateInput = document.getElementById('Filter_StartDate');
            const endDateInput = document.getElementById('Filter_EndDate');
            const startDateError = document.getElementById('startDateError');
            const endDateError = document.getElementById('endDateError');
            const notificationToast = new bootstrap.Toast(document.getElementById('notificationToast'));
            const toastMessage = document.getElementById('toastMessage');
            const globalAnimation = document.getElementById('globalAnimation');
            const animationText = document.getElementById('animationText');
            const signalPulse = document.getElementById('signalPulse');

            // Modal Elements
            const exportModal = new bootstrap.Modal(document.getElementById('exportModal'));
            const exportLimitInput = document.getElementById('exportLimit');
            const totalRecordsSpan = document.getElementById('totalRecords');
            const currentRecordsSpan = document.getElementById('currentRecords');
            const estimatedSizeSpan = document.getElementById('estimatedSize');
            const confirmExportBtn = document.getElementById('confirmExport');
            const exportAllRadio = document.getElementById('exportAll');
            const exportCurrentRadio = document.getElementById('exportCurrent');
            const allResultsSection = document.getElementById('allResultsSection');
            const currentResultsSection = document.getElementById('currentResultsSection');

            // عناصر اعتبارسنجی فایل
            const fileErrorAlert = document.getElementById('fileErrorAlert');
            const fileErrorMessage = document.getElementById('fileErrorMessage');
            const numberListFileInput = document.getElementById('numberListFile');

            // --- Helpers ---
            function toEnglishDigits(s) { return s.toString().replace(/[۰-۹]/g, d => '۰۱۲۳۴۵۶۷۸۹'.indexOf(d)); }
            function showToast(message, type = 'info') {
                toastMessage.textContent = message;
                const toastHeader = document.querySelector('#notificationToast .toast-header i');
                toastHeader.className = `fas me-2 ${type === 'success' ? 'fa-check-circle text-success' : type === 'error' ? 'fa-exclamation-circle text-danger' : 'fa-info-circle text-primary'}`;
                notificationToast.show();
            }
            function startGlobalAnimation() { if (!globalAnimation) return; signalPulse.style.opacity = '1'; animationText.textContent = 'در حال انتظار برای جستجو...'; }
            function stopGlobalAnimation() { if (signalPulse) { signalPulse.style.opacity = '0'; } }

            // --- Validation ---
            function validateRequiredDates() {
                const startDateValue = startDateInput.value.trim();
                const endDateValue = endDateInput.value.trim();
                if (!startDateValue || !endDateValue) {
                    dateRequiredAlert.style.display = 'block';
                    if (!startDateValue) { startDateInput.classList.add('is-invalid'); startDateInput.style.borderColor = '#dc3545'; startDateInput.style.boxShadow = '0 0 0 0.2rem rgba(220, 53, 69, 0.25)'; }
                    else { startDateInput.classList.remove('is-invalid'); startDateInput.style.borderColor = ''; startDateInput.style.boxShadow = ''; }
                    if (!endDateValue) { endDateInput.classList.add('is-invalid'); endDateInput.style.borderColor = '#dc3545'; endDateInput.style.boxShadow = '0 0 0 0.2rem rgba(220, 53, 69, 0.25)'; }
                    else { endDateInput.classList.remove('is-invalid'); endDateInput.style.borderColor = ''; endDateInput.style.boxShadow = ''; }
                    return false;
                }
                dateRequiredAlert.style.display = 'none';
                startDateInput.classList.remove('is-invalid');
                endDateInput.classList.remove('is-invalid');
                startDateInput.style.borderColor = ''; endDateInput.style.borderColor = '';
                startDateInput.style.boxShadow = ''; endDateInput.style.boxShadow = '';

                const datePattern = /^(\d{4})\/(\d{2})\/(\d{2})$/;
                if (!datePattern.test(startDateValue) || !datePattern.test(endDateValue)) {
                    dateRequiredAlert.style.display = 'block'; dateRequiredAlert.innerHTML = '<i class="fas fa-exclamation-triangle me-1"></i>فرمت تاریخ‌ها باید به صورت YYYY/MM/DD باشد'; return false;
                }
                const rangeValidation = validateDateRangeStepByStep();
                if (!rangeValidation.isValid) { dateRequiredAlert.style.display = 'block'; dateRequiredAlert.innerHTML = `<i class="fas fa-exclamation-triangle me-1"></i>${rangeValidation.message}`; return false; }
                return true;
            }
            function hideDateRequiredAlert() { dateRequiredAlert.style.display = 'none'; }
            function parsePersianDate(dateString) {
                if (!dateString || dateString.length !== 10) return null;
                const parts = dateString.split('/');
                if (parts.length !== 3) return null;
                const year = parseInt(parts[0]), month = parseInt(parts[1]), day = parseInt(parts[2]);
                if (isNaN(year) || isNaN(month) || isNaN(day)) return null;
                return [year, month, day];
            }
            function validateDateRangeStepByStep() {
                const startDateValue = startDateInput.value;
                const endDateValue = endDateInput.value;
                const dateRangeErrorElement = document.getElementById('dateRangeError');
                if (!startDateValue || !endDateValue) {
                    if (dateRangeErrorElement) dateRangeErrorElement.textContent = '';
                    return { isValid: true, message: '' };
                }
                const start = parsePersianDate(startDateValue);
                const end = parsePersianDate(endDateValue);
                if (!start || !end) {
                    if (dateRangeErrorElement) dateRangeErrorElement.textContent = '';
                    return { isValid: true, message: '' };
                }
                const [startYear, startMonth, startDay] = start;
                const [endYear, endMonth, endDay] = end;
                if (startYear > endYear) { return { isValid: false, message: 'سال شروع نباید از سال پایان بزرگتر باشد.' }; }
                if (startYear < endYear) { return { isValid: true, message: '' }; }
                if (startMonth > endMonth) { return { isValid: false, message: 'ماه شروع نباید از ماه پایان بزرگتر باشد.' }; }
                if (startMonth < endMonth) { return { isValid: true, message: '' }; }
                if (startDay > endDay) { return { isValid: false, message: 'روز شروع نباید از روز پایان بزرگتر باشد.' }; }
                return { isValid: true, message: '' };
            }

            // --- اعتبارسنجی فایل شماره‌ها ---
            async function validateNumberListFile(file) {
                // مخفی کردن خطاهای قبلی
                hideFileError();

                // بررسی وجود فایل
                if (!file) {
                    return { isValid: true, numbers: [] };
                }

                // بررسی نوع فایل
                const validTypes = ['text/plain', 'text/csv', 'application/vnd.ms-excel'];
                const fileExtension = file.name.split('.').pop().toLowerCase();

                if (!validTypes.includes(file.type) && !['txt', 'csv'].includes(fileExtension)) {
                    showFileError('فقط فایل‌های متنی (txt) و CSV مجاز هستند.');
                    return { isValid: false, numbers: [] };
                }

                // بررسی اندازه فایل (حداکثر 500KB)
                const maxSize = 500 * 1024; // 500KB
                if (file.size > maxSize) {
                    showFileError('حجم فایل نباید بیشتر از 500KB باشد.');
                    return { isValid: false, numbers: [] };
                }

                try {
                    const text = await file.text();
                    const lines = text.split(/\r?\n/);
                    const numbers = [];

                    for (let line of lines) {
                        // حذف فضای خالی و کاراکترهای خاص
                        line = line.trim();
                        if (!line) continue;

                        // جدا کردن با کاما یا فاصله
                        const lineNumbers = line.split(/[,،\s]+/);

                        for (let num of lineNumbers) {
                            num = num.trim();
                            if (!num) continue;

                            // حذف کاراکترهای غیرعددی (فقط اعداد و +)
                            const cleanNum = num.replace(/[^\d+]/g, '');
                            if (cleanNum.length >= 3) { // حداقل 3 رقم
                                numbers.push(cleanNum);
                            }
                        }
                    }

                    // بررسی تعداد شماره‌ها
                    if (numbers.length === 0) {
                        showFileError('فایل انتخاب شده حاوی شماره معتبر نیست.');
                        return { isValid: false, numbers: [] };
                    }

                    if (numbers.length > 50) {
                        showFileError('تعداد شماره‌های فایل نباید بیشتر از 50 مورد باشد.');
                        return { isValid: false, numbers: [] };
                    }

                    // بررسی شماره‌های تکراری
                    const uniqueNumbers = [...new Set(numbers)];
                    if (uniqueNumbers.length !== numbers.length) {
                        showToast('توجه: شماره‌های تکراری در فایل شناسایی شدند و حذف می‌شوند.', 'warning');
                    }

                    return {
                        isValid: true,
                        numbers: uniqueNumbers,
                        rawText: text
                    };

                } catch (error) {
                    console.error('Error reading file:', error);
                    showFileError('خطا در خواندن فایل. لطفاً فایل معتبری انتخاب کنید.');
                    return { isValid: false, numbers: [] };
                }
            }

            function showFileError(message) {
                fileErrorMessage.textContent = message;
                fileErrorAlert.style.display = 'block';
                numberListFileInput.classList.add('is-invalid');
            }

            function hideFileError() {
                fileErrorAlert.style.display = 'none';
                fileErrorMessage.textContent = '';
                numberListFileInput.classList.remove('is-invalid');
            }

            // --- Filters & Storage ---
            function saveFiltersToLocalStorage() {
                try {
                    const formData = collectFormDataForStorage();
                    localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify(formData));
                } catch (error) { console.error('Error saving to localStorage:', error); }
            }
            function loadFiltersFromLocalStorage() {
                try { const saved = localStorage.getItem(LOCAL_STORAGE_KEY); return saved ? JSON.parse(saved) : null; }
                catch (error) { console.error('Error loading from localStorage:', error); return null; }
            }
            function clearLocalStorageFilters() { localStorage.removeItem(LOCAL_STORAGE_KEY); }
            function collectFormDataForStorage() {
                const filters = {};
                const formData = new FormData(filterForm);
                for (let [key, value] of formData.entries()) {
                    if (key === 'Filter.ANumbers' || key === 'Filter.BNumbers') { if (!filters[key]) filters[key] = []; if (value) filters[key].push(value); }
                    else if (value) filters[key] = value;
                }
                return filters;
            }
            async function clearServerFilters() {
                try {
                    const response = await fetch('@Url.Action("ClearSessionFilters", "Call")', {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value, 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    if (!response.ok) throw new Error('Failed to clear server filters');
                } catch (error) { console.error('Error clearing server filters:', error); }
            }

            // --- Checkbox Logic (Integrado) ---
            function initializeCheckboxLogic() {
                const SELECTED_CALLS_KEY = 'selected_call_ids_v4';
                const SELECTED_CALLS_DATA_KEY = 'selected_call_data_v4';
                let selectedCalls = new Set();
                let selectedCallsData = new Map();

                function loadSelectedCalls() {
                    try {
                        const savedIds = JSON.parse(localStorage.getItem(SELECTED_CALLS_KEY) || '[]');
                        const savedData = JSON.parse(localStorage.getItem(SELECTED_CALLS_DATA_KEY) || '{}');
                        selectedCalls = new Set(savedIds);
                        selectedCallsData = new Map(Object.entries(savedData));
                        syncUI();
                    } catch (e) { console.error('Error loading selected calls:', e); }
                }

                function saveSelectedCalls() {
                    try {
                        localStorage.setItem(SELECTED_CALLS_KEY, JSON.stringify(Array.from(selectedCalls)));
                        const dataObj = {};
                        selectedCallsData.forEach((value, key) => { dataObj[key] = value; });
                        localStorage.setItem(SELECTED_CALLS_DATA_KEY, JSON.stringify(dataObj));
                    } catch (e) { console.error('Error saving selected calls:', e); }
                }

                function syncUI() {
                    const badge = document.getElementById('selectedCountBadge');
                    if (badge) badge.textContent = `${selectedCalls.size} انتخاب شده`;
                    const section = document.getElementById('bulkExportSection');
                    if (section) {
                        if (selectedCalls.size > 0) { section.style.display = 'flex'; section.classList.remove('d-none'); }
                        else { section.style.display = 'none'; section.classList.add('d-none'); }
                    }
                    const checkboxes = document.querySelectorAll('tbody .call-checkbox');
                    checkboxes.forEach(cb => {
                        const id = cb.dataset.callId;
                        const isChecked = selectedCalls.has(id.toString());
                        if (cb.checked !== isChecked) cb.checked = isChecked;
                        const row = cb.closest('tr');
                        if (row) { if (isChecked) row.classList.add('table-primary'); else row.classList.remove('table-primary'); }
                    });
                    const selectAllCb = document.getElementById('selectAllCurrentPage');
                    if (selectAllCb) {
                        const visibleCheckboxes = Array.from(document.querySelectorAll('tbody .call-checkbox')).filter(cb => cb.offsetParent !== null);
                        if (visibleCheckboxes.length === 0) { selectAllCb.checked = false; selectAllCb.indeterminate = false; }
                        else {
                            const checkedCount = visibleCheckboxes.filter(cb => cb.checked).length;
                            if (checkedCount === 0) { selectAllCb.checked = false; selectAllCb.indeterminate = false; }
                            else if (checkedCount === visibleCheckboxes.length) { selectAllCb.checked = true; selectAllCb.indeterminate = false; }
                            else { selectAllCb.checked = false; selectAllCb.indeterminate = true; }
                        }
                    }
                }

                function toggleCallSelection(callId, aNumber, bNumber, forceState = null) {
                    const idStr = callId.toString();
                    const isSelected = selectedCalls.has(idStr);
                    const newState = forceState !== null ? forceState : !isSelected;
                    if (newState) { selectedCalls.add(idStr); selectedCallsData.set(idStr, { callId, aNumber, bNumber, selectedAt: new Date().toISOString() }); }
                    else { selectedCalls.delete(idStr); selectedCallsData.delete(idStr); }
                    syncUI();
                    saveSelectedCalls();
                }

                const tableBody = document.querySelector('tbody');
                if (tableBody) {
                    loadSelectedCalls();
                    tableBody.addEventListener('change', function(e) {
                        if (e.target.classList.contains('call-checkbox')) {
                            const cb = e.target;
                            toggleCallSelection(cb.dataset.callId, cb.dataset.aNumber, cb.dataset.bNumber, cb.checked);
                        }
                    });
                    const selectAllCb = document.getElementById('selectAllCurrentPage');
                    if (selectAllCb) {
                        selectAllCb.addEventListener('change', function() {
                            const visibleCheckboxes = Array.from(document.querySelectorAll('tbody .call-checkbox')).filter(cb => cb.offsetParent !== null);
                            visibleCheckboxes.forEach(cb => toggleCallSelection(cb.dataset.callId, cb.dataset.aNumber, cb.dataset.bNumber, this.checked));
                        });
                    }
                    const exportBtn = document.getElementById('btnExportSelected');
                    if (exportBtn) {
                        exportBtn.addEventListener('click', function() {
                            if (selectedCalls.size === 0) { showToast('لطفاً حداقل یک مورد را انتخاب کنید', 'warning'); return; }
                            const selectedData = Array.from(selectedCallsData.values());
                            fetch('/Call/ExportSelectedCalls', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
                                body: JSON.stringify({ selectedCallIds: Array.from(selectedCalls), selectedCallsData: selectedData })
                            })
                            .then(response => { if (response.ok) return response.blob(); throw new Error('خطا در اکسپورت'); })
                            .then(blob => {
                                const url = window.URL.createObjectURL(blob);
                                const a = document.createElement('a');
                                a.href = url;
                                a.download = `SelectedCalls_${new Date().toISOString().slice(0, 19).replace(/[:]/g, '-')}.csv`;
                                document.body.appendChild(a);
                                a.click();
                                window.URL.revokeObjectURL(url);
                                document.body.removeChild(a);
                                showToast('اکسپورت با موفقیت انجام شد', 'success');
                            })
                            .catch(error => { console.error('Export error:', error); showToast('خطا در اکسپورت داده‌ها', 'error'); });
                        });
                    }
                    const clearBtn = document.getElementById('btnClearAllSelection');
                    if (clearBtn) {
                        clearBtn.addEventListener('click', function() {
                            selectedCalls.clear(); selectedCallsData.clear(); syncUI(); saveSelectedCalls();
                        });
                    }
                }
            }

            // --- Dropdowns ---
            function setupDropdownListener(buttonId, inputId, menuId) {
                const button = document.getElementById(buttonId);
                const input = document.getElementById(inputId);
                const menu = document.querySelector(`#${menuId} .dropdown-menu`);
                menu.addEventListener('click', function(e) {
                    e.preventDefault();
                    if (e.target.classList.contains('dropdown-item')) {
                        const value = e.target.getAttribute('data-value');
                        const text = e.target.textContent;
                        input.value = value;
                        button.textContent = text;
                        button.classList.remove('placeholder');
                        menu.querySelectorAll('.dropdown-item').forEach(item => item.classList.remove('active'));
                        e.target.classList.add('active');
                        const event = new Event('change', { bubbles: true });
                        input.dispatchEvent(event);
                    }
                });
            }
            async function loadCities(countryInputId, cityButtonId, cityInputId, cityMenuId) {
                const countryId = document.getElementById(countryInputId).value;
                const cityButton = document.getElementById(cityButtonId);
                const cityInput = document.getElementById(cityInputId);
                const cityMenu = document.querySelector(`#${cityMenuId} .dropdown-menu`);
                cityButton.textContent = 'در حال بارگذاری...';
                cityButton.disabled = true;
                cityMenu.innerHTML = '';
                if (!countryId) { cityButton.textContent = 'ابتدا کشور را انتخاب کنید'; cityButton.disabled = true; cityInput.value = ''; return; }
                try {
                    const response = await fetch(`/Call/GetCities?countryId=${countryId}`);
                    if (!response.ok) throw new Error('Network response was not ok.');
                    const cities = await response.json();
                    cityMenu.innerHTML = '<li><a class="dropdown-item" href="#" data-value="">همه</a></li>';
                    cities.forEach(city => {
                        const li = document.createElement('li');
                        const a = document.createElement('a');
                        a.className = 'dropdown-item'; a.href = '#'; a.setAttribute('data-value', city.cityID); a.textContent = city.cityName;
                        li.appendChild(a); cityMenu.appendChild(li);
                    });
                    cityButton.textContent = 'انتخاب کنید'; cityButton.disabled = false; cityInput.value = '';
                } catch (error) { console.error('Error loading cities:', error); cityButton.textContent = 'خطا در بارگذاری'; cityButton.disabled = true; showToast('خطا در بارگذاری شهرها', 'error'); }
            }
            async function loadOperators(countryInputId, operatorButtonId, operatorInputId, operatorMenuId) {
                const countryId = document.getElementById(countryInputId).value;
                const operatorButton = document.getElementById(operatorButtonId);
                const operatorInput = document.getElementById(operatorInputId);
                const operatorMenu = document.querySelector(`#${operatorMenuId} .dropdown-menu`);
                operatorButton.textContent = 'در حال بارگذاری...'; operatorButton.disabled = true; operatorMenu.innerHTML = '';
                if (!countryId) { operatorButton.textContent = 'ابتدا کشور را انتخاب کنید'; operatorButton.disabled = true; operatorInput.value = ''; return; }
                try {
                    const response = await fetch(`/Call/GetOperators?countryId=${countryId}`);
                    if (!response.ok) throw new Error('Network response was not ok.');
                    const operators = await response.json();
                    operatorMenu.innerHTML = '<li><a class="dropdown-item" href="#" data-value="">همه</a></li>';
                    operators.forEach(op => {
                        const li = document.createElement('li');
                        const a = document.createElement('a');
                        a.className = 'dropdown-item'; a.href = '#'; a.setAttribute('data-value', op.operatorID); a.textContent = op.operatorName;
                        li.appendChild(a); operatorMenu.appendChild(li);
                    });
                    operatorButton.textContent = 'انتخاب کنید'; operatorButton.disabled = false; operatorInput.value = '';
                } catch (error) { console.error('Error loading operators:', error); operatorButton.textContent = 'خطا در بارگذاری'; operatorButton.disabled = true; showToast('خطا در بارگذاری اپراتورها', 'error'); }
            }

            // --- Numbers ---
            function addANumber() {
                if (aNumberCount >= 5) { showToast('حداکثر 5 شماره مبدأ می‌توانید وارد کنید', 'error'); return; }
                const container = document.getElementById('anumbers-container');
                const newRow = document.createElement('div');
                newRow.className = 'filter-row anumber-row'; newRow.dataset.index = aNumberCount;
