            // --- توابع مدیریت تاریخ ---
            function formatDateInput(input) {
                let value = toEnglishDigits(input.value);
                value = value.replace(/[^\d]/g, '');
                if (value.length > 10) value = value.substring(0, 10);
                if (value.length > 4) value = value.substring(0, 4) + '/' + value.substring(4);
                if (value.length > 7) value = value.substring(0, 7) + '/' + value.substring(7);
                input.value = value;

                // پنهان کردن هشدار هنگام تغییر تاریخ
                hideDateRequiredAlert();
            }

            function validateDate(input, errorElement) {
                const value = input.value;
                if (!value) {
                    errorElement.textContent = '';
                    updateSearchButtonState();
                    return;
                }

                const datePattern = /^(\d{4})\/(\d{2})\/(\d{2})$/;
                if (!datePattern.test(value)) {
                    errorElement.textContent = 'فرمت تاریخ باید به صورت YYYY/MM/DD باشد';
                    updateSearchButtonState();
                    return;
                }

                const match = value.match(datePattern);
                const year = parseInt(match[1]);
                const month = parseInt(match[2]);
                const day = parseInt(match[3]);
                const currentYear = new persianDate().year();

                if (year < 1390) {
                    errorElement.textContent = 'سال نباید کمتر از 1390 باشد';
                    updateSearchButtonState();
                    return;
                }
                if (year > currentYear) {
                    errorElement.textContent = 'سال نباید از سال جاری بیشتر باشد';
                    updateSearchButtonState();
                    return;
                }
                if (month < 1 || month > 12) {
                    errorElement.textContent = 'ماه باید بین 1 تا 12 باشد';
                    updateSearchButtonState();
                    return;
                }
                if (day < 1 || day > 31) {
                    errorElement.textContent = 'روز باید بین 1 تا 31 باشد';
                    updateSearchButtonState();
                    return;
                }
                if (month >= 7 && month <= 11 && day > 30) {
                    errorElement.textContent = 'این ماه حداکثر 30 روز دارد';
                    updateSearchButtonState();
                    return;
                }
                if (month === 12) {
                    const isLeapYear = (year % 4 === 3);
                    const maxDay = isLeapYear ? 30 : 29;
                    if (day > maxDay) {
                        errorElement.textContent = `اسفند در سال ${year} حداکثر ${maxDay} روز دارد`;
                        updateSearchButtonState();
                        return;
                    }
                }

                const today = new persianDate();
                const inputDate = new persianDate([year, month, day]);
                if (inputDate.isAfter(today)) {
                    errorElement.textContent = 'تاریخ نباید از امروز بیشتر باشد';
                    updateSearchButtonState();
                    return;
                }

                errorElement.textContent = '';
                updateSearchButtonState();
            }

            function parsePersianDate(dateString) {
                if (!dateString || dateString.length !== 10) return null;
                const parts = dateString.split('/');
                if (parts.length !== 3) return null;
                const year = parseInt(parts[0]);
                const month = parseInt(parts[1]);
                const day = parseInt(parts[2]);
                if (isNaN(year) || isNaN(month) || isNaN(day)) return null;
                return [year, month, day];
            }

            function validateDateRangeStepByStep() {
                const startDateValue = startDateInput.value;
                const endDateValue = endDateInput.value;
                const dateRangeErrorElement = document.getElementById('dateRangeError');

                if (!startDateValue || !endDateValue) {
                    if (dateRangeErrorElement) {
                        dateRangeErrorElement.textContent = '';
                    }
                    return { isValid: true, message: '' };
                }

                const start = parsePersianDate(startDateValue);
                const end = parsePersianDate(endDateValue);

                if (!start || !end) {
                    if (dateRangeErrorElement) {
                        dateRangeErrorElement.textContent = '';
                    }
                    return { isValid: true, message: '' };
                }

                const [startYear, startMonth, startDay] = start;
                const [endYear, endMonth, endDay] = end;

                if (startYear > endYear) {
                    return { isValid: false, message: 'سال شروع نباید از سال پایان بزرگتر باشد.' };
                }
                if (startYear < endYear) {
                    return { isValid: true, message: '' };
                }

                if (startMonth > endMonth) {
                    return { isValid: false, message: 'ماه شروع نباید از ماه پایان بزرگتر باشد.' };
                }
                if (startMonth < endMonth) {
                    return { isValid: true, message: '' };
                }

                if (startDay > endDay) {
                    return { isValid: false, message: 'روز شروع نباید از روز پایان بزرگتر باشد.' };
                }

                return { isValid: true, message: '' };
            }

            function updateSearchButtonState() {
                const submitButton = document.querySelector('button[type="submit"]');
                const dateRangeErrorElement = document.getElementById('dateRangeError');

                const hasStartDateError = startDateError.textContent.trim() !== '';
                const hasEndDateError = endDateError.textContent.trim() !== '';

                const rangeValidation = validateDateRangeStepByStep();
                const hasDateRangeError = !rangeValidation.isValid;

                if (dateRangeErrorElement) {
                    dateRangeErrorElement.textContent = rangeValidation.message;
                } else if (!rangeValidation.isValid) {
                    const errorDiv = document.createElement('div');
                    errorDiv.id = 'dateRangeError';
                    errorDiv.className = 'text-danger small mt-1';
                    endDateInput.closest('.filter-field').appendChild(errorDiv);
                    errorDiv.textContent = rangeValidation.message;
                }

                if (hasStartDateError || hasEndDateError || hasDateRangeError) {
                    submitButton.disabled = true;
                } else {
                    submitButton.disabled = false;
                }
            }

            // --- توابع جستجو و نتایج ---
            function collectFormData() {
                const formData = new FormData(filterForm);
                return formData;
            }

            async function performSearch(page = 1, pushHistory = true, isDeepSearch = false) {
                // اعتبارسنجی تاریخ قبل از جستجو
                if (!validateRequiredDates()) {
                    showToast('لطفاً تاریخ شروع و پایان را انتخاب کنید', 'error');
                    return;
                }

                stopGlobalAnimation();
                document.getElementById('Filter_Page').value = page;
                const formData = collectFormData();

                if (isDeepSearch) {
                    formData.append('deepSearch', 'true');
                }

                searchResultsContainer.innerHTML = `
                    <div class="text-center p-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">در حال بارگذاری...</span>
                        </div>
                        <p class="mt-2">در حال جستجو...</p>
                    </div>
                `;

                try {
                    const response = await fetch(`/Call/Search?deepSearch=${isDeepSearch}`, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value,
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: formData
                    });

                    if (!response.ok) throw new Error(`Network response was not ok: ${response.statusText}`);

                    const contentType = response.headers.get("content-type");
                    if (contentType && contentType.indexOf("application/json") !== -1) {
                        const errorData = await response.json();
                        console.error("Server-side validation errors:", errorData);
                        searchResultsContainer.innerHTML = `<div class="alert alert-danger" role="alert">خطای اعتبارسنجی در سرور. جزئیات در کنسول.</div>`;
                        showToast('خطای اعتبارسنجی', 'error');
                        return;
                    }

                    const html = await response.text();
                    if (html.includes('<html') || html.includes('<!DOCTYPE')) {
                        console.error("Error: Received full page HTML instead of partial view.");
                        searchResultsContainer.innerHTML = `<div class="alert alert-danger" role="alert">خطا در سرور. (Full page received)</div>`;
                        showToast('خطا در جستجو', 'error');
                        return;
                    }

                    searchResultsContainer.innerHTML = html;
                    exportBtn.disabled = false;
                    convertDatesToPersian();

                    const totalCountMatch = html.match(/نتایج جستجو \((\d+) رکورد\)/);
                    if (totalCountMatch) {
                        totalResultsCount = parseInt(totalCountMatch[1]);
                    }

                    setupPaginationListeners();
                    updateClientNumberPairSelects();
                    setupClientFilterEvents();

                    if (pushHistory) {
                        const params = new URLSearchParams();
                        const formElements = filterForm.elements;

                        for (let i = 0; i < formElements.length; i++) {
                            const element = formElements[i];
                            if (element.name && element.value) {
                                if (element.name === 'Filter.ANumbers' || element.name === 'Filter.BNumbers') {
                                    params.append(element.name, element.value);
                                } else {
                                    params.set(element.name, element.value);
                                }
                            }
                        }

                        if (isDeepSearch) {
                            params.set('deepSearch', 'true');
                        }

                        const newUrl = `${window.location.pathname}?${params.toString()}`;
                        window.history.pushState({ path: newUrl }, '', newUrl);

                        // ذخیره فیلترها در LocalStorage
                        saveFiltersToLocalStorage();
                    }

                } catch (error) {
                    console.error('Error during search fetch:', error);
                    searchResultsContainer.innerHTML = `<div class="alert alert-danger" role="alert">خطا در دریافت نتایج جستجو. (${error.message})</div>`;
                    showToast('خطا در جستجو', 'error');
                }
            }

            function setupPaginationListeners() {
                document.querySelectorAll('#search-results-container .pagination .page-link').forEach(link => {
                    link.addEventListener('click', function(e) {
                        e.preventDefault();
                        const page = this.getAttribute('data-page');
                        if (page) {
                            performSearch(parseInt(page));
                        }
                    });
                });
            }

            // --- توابع فیلتر سمت کلاینت ---
            function updateClientNumberPairSelects() {
                const aNumbers = Array.from(document.querySelectorAll('.anumber-input')).map(input => input.value.trim()).filter(v => v);
                const bNumbers = Array.from(document.querySelectorAll('.bnumber-input')).map(input => input.value.trim()).filter(v => v);

                const clientANumberSelect = document.querySelector('.client-anumber-select');
                const clientBNumberSelect = document.querySelector('.client-bnumber-select');

                if (!clientANumberSelect || !clientBNumberSelect) return;

                const currentValueA = clientANumberSelect.value;
                const currentValueB = clientBNumberSelect.value;

                clientANumberSelect.innerHTML = '<option value="">همه</option>';
                aNumbers.sort().forEach(number => {
                    const option = document.createElement('option');
                    option.value = number;
                    option.textContent = number;
                    if (currentValueA === number) {
                        option.selected = true;
                    }
                    clientANumberSelect.appendChild(option);
                });

                clientBNumberSelect.innerHTML = '<option value="">همه</option>';
                bNumbers.sort().forEach(number => {
                    const option = document.createElement('option');
                    option.value = number;
                    option.textContent = number;
                    if (currentValueB === number) {
                        option.selected = true;
                    }
                    clientBNumberSelect.appendChild(option);
                });
            }

            function setupClientFilterEvents() {
                const clientANumberSelect = document.querySelector('.client-anumber-select');
                const clientBNumberSelect = document.querySelector('.client-bnumber-select');
                const deepSearchBtn = document.getElementById('btnDeepSearch');
                const sortSelect = document.getElementById('sort-select');

                if (clientANumberSelect) {
                    clientANumberSelect.addEventListener('change', () => handleClientSideFilter(false));
                }
                if (clientBNumberSelect) {
                    clientBNumberSelect.addEventListener('change', () => handleClientSideFilter(false));
                }
                if (deepSearchBtn) {
                    deepSearchBtn.addEventListener('click', () => handleClientSideFilter(true));
                }
                if (sortSelect) {
                    sortSelect.addEventListener('change', handleClientSort);
                }
            }

            function handleClientSort() {
                const sortSelect = document.getElementById('sort-select');
                if (!sortSelect) return;

                const sortValue = sortSelect.value;
                const [column, direction] = sortValue.split('-');
                const isAscending = direction === 'asc';

                const tbody = document.querySelector('#search-results-container tbody');
                if (!tbody) return;

                const rows = Array.from(tbody.querySelectorAll('tr'));

                rows.sort((a, b) => {
                    let aValue, bValue;

                    switch(column) {
                        case 'AccountingTime':
                            const aTimeElem = a.querySelector('[data-datetime]');
                            const bTimeElem = b.querySelector('[data-datetime]');
                            aValue = aTimeElem ? new Date(aTimeElem.dataset.datetime) : new Date(0);
                            bValue = bTimeElem ? new Date(bTimeElem.dataset.datetime) : new Date(0);
                            break;
                        case 'ANumber':
                            aValue = a.cells[0].textContent.trim();
                            bValue = b.cells[0].textContent.trim();
                            break;
                        case 'BNumber':
                            aValue = a.cells[1].textContent.trim();
                            bValue = b.cells[1].textContent.trim();
                            break;
                        case 'Length':
                            aValue = parseInt(a.cells[3].textContent.trim()) || 0;
                            bValue = parseInt(b.cells[3].textContent.trim()) || 0;
                            break;
                        default:
                            return 0;
                    }

                    if (aValue < bValue) return isAscending ? -1 : 1;
                    if (aValue > bValue) return isAscending ? 1 : -1;
                    return 0;
                });

                tbody.innerHTML = '';
                rows.forEach(row => tbody.appendChild(row));
            }

            function handleClientSideFilter(isDeepSearch = false) {
                // برای جستجوی عمیق، اعتبارسنجی تاریخ انجام می‌شود
                if (isDeepSearch) {
                    if (!validateRequiredDates()) {
                        showToast('لطفاً تاریخ شروع و پایان را انتخاب کنید', 'error');
                        return;
                    }
                }

                const allRows = document.querySelectorAll('#search-results-container tbody tr');
                const aSelect = document.querySelector('.client-anumber-select');
                const bSelect = document.querySelector('.client-bnumber-select');

                if (!aSelect || !bSelect) return;

                const selectedA = aSelect.value;
                const selectedB = bSelect.value;

                // منطق جستجوی عمیق
                if (isDeepSearch) {
                    if (!selectedA && !selectedB) {
                        showToast('لطفاً حداقل یک شماره برای جستجوی عمیق انتخاب کنید', 'info');
                        return;
                    }

                    // پاک کردن ورودی‌های شماره‌ها در فرم اصلی
                    const aInputs = filterForm.querySelectorAll('input[name="Filter.ANumbers"]');
                    aInputs.forEach(input => input.value = '');

                    const bInputs = filterForm.querySelectorAll('input[name="Filter.BNumbers"]');
                    bInputs.forEach(input => input.value = '');

                    // مقداردهی دوباره ورودی‌ها
                    if (selectedA) {
                        const firstAInput = aInputs[0];
                        if (firstAInput) firstAInput.value = selectedA;
                    }

                    if (selectedB) {
                        const firstBInput = bInputs[0];
                        if (firstBInput) firstBInput.value = selectedB;
                    }

                    const pageInput = document.getElementById('Filter_Page');
                    if (pageInput) pageInput.value = 1;

                    performSearch(1, true, true);
                    return;
                }

                // منطق فیلتر سریع
                if (!selectedA && !selectedB) {
                    allRows.forEach(row => row.style.display = '');
                    return;
                }

                allRows.forEach(row => {
                    const aNum = row.cells[0].textContent.trim();
                    const bNum = row.cells[1].textContent.trim();

                    let isVisible = false;

                    if (selectedA && selectedB) {
                        if ((aNum === selectedA && bNum === selectedB) ||
                            (aNum === selectedB && bNum === selectedA)) {
                            isVisible = true;
                        }
                    }
                    else if (selectedA && (aNum === selectedA || bNum === selectedA)) {
                        isVisible = true;
                    }
                    else if (selectedB && (aNum === selectedB || bNum === selectedB)) {
                        isVisible = true;
                    }

                    row.style.display = isVisible ? '' : 'none';
                });
            }

