            // --- توابع اطلاعات شماره تلفن ---
            async function fetchAndDisplayPhoneInfo(phoneNumber, containerElement, locationElement) {
                if (!phoneNumber) {
                    containerElement.style.display = 'none';
                    if (locationElement) locationElement.style.display = 'none';
                    return;
                }

                try {
                    const response = await fetch(`/Call/GetPhoneInfo?number=${phoneNumber}`);
                    if (!response.ok) throw new Error('Network response was not ok.');
                    const data = await response.json();

                    const contentDiv = containerElement.querySelector('.phone-info-content');
                    if (data.success) {
                        let infoHtml = `<strong>کشور:</strong> ${data.countryName || 'نامشخص'}<br>`;
                        infoHtml += `<strong>شهر:</strong> ${data.cityName || 'نامشخص'}<br>`;
                        infoHtml += `<strong>اپراتور:</strong> ${data.operatorName || 'نامشخص'}`;
                        contentDiv.innerHTML = infoHtml;
                        containerElement.style.display = 'block';

                        if (locationElement) {
                            let locationText = '';
                            if (data.countryName) locationText += data.countryName;
                            if (data.cityName) locationText += (locationText ? ', ' : '') + data.cityName;
                            if (data.operatorName) locationText += (locationText ? ', ' : '') + data.operatorName;

                            locationElement.textContent = locationText;
                            locationElement.parentElement.style.display = 'block';
                        }
                    } else {
                        contentDiv.innerHTML = 'اطلاعاتی یافت نشد';
                        containerElement.style.display = 'block';
                        if (locationElement) locationElement.parentElement.style.display = 'none';
                    }
                } catch (error) {
                    console.error('Error fetching phone info:', error);
                    const contentDiv = containerElement.querySelector('.phone-info-content');
                    contentDiv.innerHTML = 'خطا در دریافت اطلاعات';
                    containerElement.style.display = 'block';
                    if (locationElement) locationElement.parentElement.style.display = 'none';
                }
            }

            function handlePhoneInput(event) {
                const input = event.target;
                const row = input.closest('.filter-row');
                const trigger = row.querySelector('.phone-info-trigger');
                const container = row.querySelector('.phone-info-container');
                const index = row.dataset.index;
                const isANumber = input.classList.contains('anumber-input');
                const locationElement = document.getElementById(`${isANumber ? 'anumber' : 'bnumber'}-location-${index}`);

                if (input.value.trim().length > 0) {
                    trigger.style.display = 'flex';
                    container.style.display = 'none';
                    fetchAndDisplayPhoneInfo(input.value, container, locationElement);
                } else {
                    trigger.style.display = 'none';
                    container.style.display = 'none';
                    if (locationElement) locationElement.parentElement.style.display = 'none';
                }

                updateLocationFieldsState();
            }

            function handlePhoneInfoClick(event) {
                const trigger = event.currentTarget;
                const row = trigger.closest('.filter-row');
                const input = row.querySelector('.anumber-input, .bnumber-input');
                const container = row.querySelector('.phone-info-container');

                if (container.style.display === 'block') {
                    container.style.display = 'none';
                } else {
                    const index = row.dataset.index;
                    const isANumber = input.classList.contains('anumber-input');
                    const locationElement = document.getElementById(`${isANumber ? 'anumber' : 'bnumber'}-location-${index}`);
                    fetchAndDisplayPhoneInfo(input.value, container, locationElement);
                }
            }

            // --- توابع مدیریت مکان ---
            function disableLocationFields(section) {
                section.querySelectorAll('button, input, select').forEach(el => el.disabled = true);
                section.style.opacity = '0.6';
            }

            function enableLocationFields(section) {
                section.querySelectorAll('button, input, select').forEach(el => el.disabled = false);
                section.style.opacity = '1';
            }

            async function updateLocationFieldsState() {
                const aNumbers = Array.from(document.querySelectorAll('.anumber-input')).map(input => input.value.trim()).filter(v => v);
                const bNumbers = Array.from(document.querySelectorAll('.bnumber-input')).map(input => input.value.trim()).filter(v => v);

                const originLocationSection = document.getElementById('origin-location-section');
                const destLocationSection = document.getElementById('dest-location-section');

                if (aNumbers.length === 0 && bNumbers.length === 0) {
                    enableLocationFields(originLocationSection);
                    enableLocationFields(destLocationSection);
                    return;
                }

                if (aNumbers.length > 0 && bNumbers.length === 0) {
                    disableLocationFields(originLocationSection);
                    enableLocationFields(destLocationSection);

                    if (aNumbers.length === 1) {
                        await populateOriginLocationFromPhone(aNumbers[0]);
                    }
                    return;
                }

                if (aNumbers.length === 0 && bNumbers.length > 0) {
                    enableLocationFields(originLocationSection);
                    disableLocationFields(destLocationSection);

                    if (bNumbers.length === 1) {
                        await populateDestLocationFromPhone(bNumbers[0]);
                    }
                    return;
                }

                if (aNumbers.length > 0 && bNumbers.length > 0) {
                    disableLocationFields(originLocationSection);
                    disableLocationFields(destLocationSection);

                    if (aNumbers.length === 1 && bNumbers.length === 1) {
                        await Promise.all([
                            populateOriginLocationFromPhone(aNumbers[0]),
                            populateDestLocationFromPhone(bNumbers[0])
                        ]);
                    }
                    return;
                }
            }

            async function populateOriginLocationFromPhone(phoneNumber) {
                if (!phoneNumber) return;

                try {
                    const response = await fetch(`/Call/GetPhoneInfo?number=${phoneNumber}`);
                    if (!response.ok) throw new Error('Network response was not ok.');
                    const data = await response.json();

                    if (data.success) {
                        if (data.countryID) {
                            originCountryInput.value = data.countryID;
                            originCountryButton.textContent = data.countryName || 'انتخاب کنید';

                            await loadCities('origin-country-input', 'origin-city-button', 'origin-city-input', 'origin-city-dropdown');
                            await loadOperators('origin-country-input', 'origin-operator-button', 'origin-operator-input', 'origin-operator-dropdown');

                            if (data.cityID) {
                                originCityInput.value = data.cityID;
                                originCityButton.textContent = data.cityName || 'انتخاب کنید';
                            }

                            if (data.operatorID) {
                                originOperatorInput.value = data.operatorID;
                                originOperatorButton.textContent = data.operatorName || 'انتخاب کنید';
                            }
                        }
                    }
                } catch (error) {
                    console.error('Error populating origin location from phone:', error);
                }
            }

