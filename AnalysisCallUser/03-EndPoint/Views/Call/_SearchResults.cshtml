@using AnalysisCallUser._01_Domain.Core.Enums
@model AnalysisCallUser._02_Infrastructure.Helpers.PagedResult<AnalysisCallUser._01_Domain.Core.DTOs.CallDetailDto>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center">
        <div class="me-3">
            @if (Model.TotalItems > 0)
            {
                <span class="text-muted">نمایش رکوردهای @((Model.PageNumber - 1) * Model.PageSize + 1) تا @(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalItems)) از @Model.TotalItems</span>
            }
            else
            {
                <span class="text-muted">هیچ رکوردی یافت نشد</span>
            }
        </div>
        @if (Model.TotalItems > 0)
        {
            <div class="btn-group" role="group">
                <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-download"></i> خروجی
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="#" id="exportCurrentPage"><i class="fas fa-file-export me-2"></i>خروجی صفحه فعلی</a></li>
                    <li><a class="dropdown-item" href="#" id="exportAllResults"><i class="fas fa-file-export me-2"></i>خروجی تمام نتایج</a></li>
                    <li><a class="dropdown-item" href="#" id="exportCustom"><i class="fas fa-cog me-2"></i>خروجی با گزینه‌های دلخواه</a></li>
                </ul>
            </div>
        }
    </div>
    <!-- بخش اکسپورت انتخابی -->
    <div id="bulkExportSection" class="d-none align-items-center">
        <span id="selectedCountBadge" class="badge bg-primary me-2">0 انتخاب شده</span>
        <button type="button" id="btnExportSelected" class="btn btn-sm btn-success me-2" title="اکسپورت موارد انتخاب شده">
            <i class="fas fa-file-export"></i> اکسپورت انتخابی
        </button>
        <button type="button" id="btnClearAllSelection" class="btn btn-sm btn-outline-danger" title="پاک کردن تمام انتخاب‌ها">
            <i class="fas fa-times"></i> پاک کردن
        </button>
    </div>
</div>

<!-- فیلتر ترکیبی شماره‌ها (نوار باریک) -->
@if (Model.TotalItems > 0)
{
    <div class="card mb-3 client-side-filter-bar">
        <div class="card-body py-2">
            <div class="row align-items-center g-2">
                <div class="col-auto">
                    <label for="client-anumber-select" class="col-form-label">فیلتر شماره مبدأ:</label>
                </div>
                <div class="col-auto">
                    <select class="form-select form-select-sm client-anumber-select" id="client-anumber-select">
                        <option value="">همه</option>
                    </select>
                </div>
                <div class="col-auto">
                    <label for="client-bnumber-select" class="col-form-label">فیلتر شماره مقصد:</label>
                </div>
                <div class="col-auto">
                    <select class="form-select form-select-sm client-bnumber-select" id="client-bnumber-select">
                        <option value="">همه</option>
                    </select>
                </div>
                <div class="col-auto">
                    <label for="sort-select" class="col-form-label">مرتب‌سازی:</label>
                </div>
                <div class="col-auto">
                    <select class="form-select form-select-sm" id="sort-select">
                        <option value="AccountingTime-desc">جدیدترین</option>
                        <option value="AccountingTime-asc">قدیمی‌ترین</option>
                        <option value="ANumber-asc">شماره مبدأ (صعودی)</option>
                        <option value="BNumber-asc">شماره مقصد (صعودی)</option>
                        <option value="Length-desc">مدت زمان (بیشترین به کمترین)</option>
                        <option value="Length-asc">مدت زمان (کمترین به بیشترین)</option>
                    </select>
                </div>

                @* --- دکمه جستجوی عمیق (بخش جدید) --- *@
                <div class="col-auto ms-2">
                    <button type="button" id="btnDeepSearch" class="btn btn-sm btn-primary" title="اعمال فیلتر روی تمام صفحات نتایج">
                        <i class="fas fa-layer-group"></i> جستجوی عمیق
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th style="width: 50px;">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="selectAllCurrentPage">
                        <label class="form-check-label" for="selectAllCurrentPage" title="انتخاب/عدم انتخاب تمام ردیف‌های صفحه جاری"></label>
                    </div>
                </th>
                <th>شماره مبدأ</th>
                <th>شماره مقصد</th>
                <th>تاریخ و زمان</th>
                <th>مدت (ثانیه)</th>
                <th>کشور مبدأ</th>
                <th>کشور مقصد</th>
                <th>وضعیت</th>
                <th>جزئیات</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Data.Any())
            {
                @foreach (var call in Model.Data)
                {
                    <tr data-call-id="@call.DetailID">
                        <td>
                            <div class="form-check">
                                <input class="form-check-input call-checkbox" type="checkbox" 
                                       data-call-id="@call.DetailID"
                                       data-a-number="@call.ANumber"
                                       data-b-number="@call.BNumber">
                            </div>
                        </td>
                        <td>@call.ANumber</td>
                        <td>@call.BNumber</td>
                        <td data-datetime="@call.AccountingTime.ToString("yyyy-MM-ddTHH:mm:ss")" class="datetime-cell">
                            @call.AccountingTime.ToString("yyyy/MM/dd HH:mm:ss")
                        </td>
                        <td>@call.Length</td>
                        <td>@call.OriginCountryName</td>
                        <td>@call.DestCountryName</td>
                        <td>
                            @if (call.Answer == CallAnswerStatus.Answered)
                            {
                                <span class="badge bg-success">پاسخ داده شده</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">پاسخ داده نشده</span>
                            }
                        </td>
                        <td style="min-width: 120px;">
                            <div class="d-flex gap-1 justify-content-center">
                                <a asp-action="Details" asp-route-id="@call.DetailID" class="btn btn-sm btn-outline-primary" title="نمایش جزئیات">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center text-muted">هیچ تماسی یافت نشد</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* نمایش بخش صفحه‌بندی *@
@if (Model != null && Model.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            @if (Model.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" href="#" data-page="1" aria-label="First">
                        <span aria-hidden="true">&laquo;&laquo;</span>
                    </a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="#" data-page="@(Model.PageNumber - 1)" aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                        <span aria-hidden="true">&laquo;&laquo;</span>
                    </a>
                </li>
                <li class="page-item disabled">
                    <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>
            }

            @{
                int startPage = Math.Max(1, Model.PageNumber - 2);
                int endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);

                if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="#" data-page="1">1</a>
                    </li>
                    if (startPage > 2)
                    {
                        <li class="page-item disabled">
                            <a class="page-link" href="#" tabindex="-1" aria-disabled="true">...</a>
                        </li>
                    }
                }

                for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" href="#" data-page="@i">@i</a>
                    </li>
                }

                if (endPage < Model.TotalPages)
                {
                    if (endPage < Model.TotalPages - 1)
                    {
                        <li class="page-item disabled">
                            <a class="page-link" href="#" tabindex="-1" aria-disabled="true">...</a>
                        </li>
                    }
                    <li class="page-item">
                        <a class="page-link" href="#" data-page="@Model.TotalPages">@Model.TotalPages</a>
                    </li>
                }
            }

            @if (Model.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link" href="#" data-page="@(Model.PageNumber + 1)" aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="#" data-page="@Model.TotalPages" aria-label="Last">
                        <span aria-hidden="true">&raquo;&raquo;</span>
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
                <li class="page-item disabled">
                    <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                        <span aria-hidden="true">&raquo;&raquo;</span>
                    </a>
                </li>
            }
        </ul>
    </nav>
}

@* --- اسکریپت اختصاصی این Partial View --- *@
<script>
    (function() {
        // کلید ذخیره‌سازی در localStorage
        const SELECTED_CALLS_KEY = 'selected_call_ids_v2';
        const SELECTED_CALLS_DATA_KEY = 'selected_call_data_v2';
        
        // مدیریت انتخاب‌ها
        let selectedCalls = new Set();
        let selectedCallsData = new Map(); // برای ذخیره اطلاعات اضافی

        // بارگذاری انتخاب‌های قبلی از localStorage
        function loadSelectedCalls() {
            try {
                const savedIds = JSON.parse(localStorage.getItem(SELECTED_CALLS_KEY) || '[]');
                const savedData = JSON.parse(localStorage.getItem(SELECTED_CALLS_DATA_KEY) || '{}');
                
                selectedCalls = new Set(savedIds);
                selectedCallsData = new Map(Object.entries(savedData));
                
                updateSelectedCount();
                updateCheckboxes();
                toggleBulkExportSection();
            } catch (e) {
                console.error('Error loading selected calls:', e);
                clearAllSelection();
            }
        }

        // ذخیره انتخاب‌ها در localStorage
        function saveSelectedCalls() {
            try {
                localStorage.setItem(SELECTED_CALLS_KEY, JSON.stringify(Array.from(selectedCalls)));
                
                const dataObj = {};
                selectedCallsData.forEach((value, key) => {
                    dataObj[key] = value;
                });
                localStorage.setItem(SELECTED_CALLS_DATA_KEY, JSON.stringify(dataObj));
            } catch (e) {
                console.error('Error saving selected calls:', e);
            }
        }

        // اضافه کردن تماس به انتخاب‌ها
        function addCallToSelection(callId, aNumber, bNumber) {
            selectedCalls.add(callId.toString());
            selectedCallsData.set(callId.toString(), {
                callId: callId,
                aNumber: aNumber,
                bNumber: bNumber,
                selectedAt: new Date().toISOString()
            });
            updateSelectedCount();
            toggleBulkExportSection();
            saveSelectedCalls();
        }

        // حذف تماس از انتخاب‌ها
        function removeCallFromSelection(callId) {
            selectedCalls.delete(callId.toString());
            selectedCallsData.delete(callId.toString());
            updateSelectedCount();
            toggleBulkExportSection();
            saveSelectedCalls();
        }

        // به‌روزرسانی تعداد انتخاب‌شده
        function updateSelectedCount() {
            const badge = document.getElementById('selectedCountBadge');
            if (badge) {
                badge.textContent = `${selectedCalls.size} انتخاب شده`;
            }
        }

        // نمایش/پنهان بخش اکسپورت انتخابی
        function toggleBulkExportSection() {
            const section = document.getElementById('bulkExportSection');
            if (section) {
                if (selectedCalls.size > 0) {
                    section.classList.remove('d-none');
                } else {
                    section.classList.add('d-none');
                }
            }
        }

        // به‌روزرسادی چک‌باکس‌ها
        function updateCheckboxes() {
            document.querySelectorAll('.call-checkbox').forEach(checkbox => {
                const callId = checkbox.dataset.callId;
                checkbox.checked = selectedCalls.has(callId);
                
                // بروزرسانی وضعیت ردیف
                const row = checkbox.closest('tr');
                if (row) {
                    if (checkbox.checked) {
                        row.classList.add('table-primary');
                    } else {
                        row.classList.remove('table-primary');
                    }
                }
            });
            
            // بروزرسانی چک‌باکس "انتخاب همه"
            updateSelectAllCheckbox();
        }

        // بروزرسانی چک‌باکس "انتخاب همه"
        function updateSelectAllCheckbox() {
            const selectAll = document.getElementById('selectAllCurrentPage');
            if (!selectAll) return;
            
            const visibleCheckboxes = Array.from(document.querySelectorAll('.call-checkbox:not([style*="display: none"])'));
            if (visibleCheckboxes.length === 0) {
                selectAll.checked = false;
                selectAll.indeterminate = false;
                return;
            }
            
            const checkedCount = visibleCheckboxes.filter(cb => cb.checked).length;
            
            if (checkedCount === 0) {
                selectAll.checked = false;
                selectAll.indeterminate = false;
            } else if (checkedCount === visibleCheckboxes.length) {
                selectAll.checked = true;
                selectAll.indeterminate = false;
            } else {
                selectAll.checked = false;
                selectAll.indeterminate = true;
            }
        }

        // انتخاب تمام ردیف‌های صفحه جاری
        function selectAllCurrentPage() {
            const checkboxes = document.querySelectorAll('.call-checkbox:not([style*="display: none"])');
            checkboxes.forEach(checkbox => {
                const callId = checkbox.dataset.callId;
                const aNumber = checkbox.dataset.aNumber;
                const bNumber = checkbox.dataset.bNumber;
                
                if (!checkbox.checked) {
                    addCallToSelection(callId, aNumber, bNumber);
                }
            });
            updateCheckboxes();
        }

        // عدم انتخاب تمام ردیف‌های صفحه جاری
        function deselectAllCurrentPage() {
            const checkboxes = document.querySelectorAll('.call-checkbox:not([style*="display: none"])');
            checkboxes.forEach(checkbox => {
                const callId = checkbox.dataset.callId;
                if (checkbox.checked) {
                    removeCallFromSelection(callId);
                }
            });
            updateCheckboxes();
        }

        // انتخاب تمام صفحات
        function selectAllPages() {
            if (typeof showToast === 'function') {
                showToast('برای انتخاب تمام صفحات، لطفاً ابتدا گزینه "خروجی تمام نتایج" را استفاده کنید.', 'info');
            } else {
                alert('برای انتخاب تمام صفحات، لطفاً ابتدا گزینه "خروجی تمام نتایج" را استفاده کنید.');
            }
        }

        // عدم انتخاب تمام صفحات
        function deselectAllPages() {
            clearAllSelection();
        }

        // پاک کردن تمام انتخاب‌ها
        function clearAllSelection() {
            selectedCalls.clear();
            selectedCallsData.clear();
            updateSelectedCount();
            toggleBulkExportSection();
            updateCheckboxes();
            saveSelectedCalls();
        }

        // اکسپورت موارد انتخابی
        function exportSelectedCalls() {
            if (selectedCalls.size === 0) {
                if (typeof showToast === 'function') {
                    showToast('لطفاً حداقل یک مورد را انتخاب کنید', 'warning');
                } else {
                    alert('لطفاً حداقل یک مورد را انتخاب کنید');
                }
                return;
            }

            // ساخت آرایه از اطلاعات انتخاب‌شده
            const selectedData = Array.from(selectedCallsData.values());
            
            // درخواست به سرور برای اکسپورت
            fetch('/Call/ExportSelectedCalls', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify({
                    selectedCallIds: Array.from(selectedCalls),
                    selectedCallsData: selectedData
                })
            })
            .then(response => {
                if (response.ok) {
                    return response.blob();
                }
                throw new Error('خطا در اکسپورت');
            })
            .then(blob => {
                // ایجاد لینک دانلود
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `SelectedCalls_${new Date().toISOString().slice(0, 19).replace(/[:]/g, '-')}.csv`;
                document.body.appendChild(a);
                a.click();
                window.URL.revokeObjectURL(url);
                document.body.removeChild(a);
                
                if (typeof showToast === 'function') {
                    showToast('اکسپورت با موفقیت انجام شد', 'success');
                }
            })
            .catch(error => {
                console.error('Export error:', error);
                if (typeof showToast === 'function') {
                    showToast('خطا در اکسپورت داده‌ها', 'error');
                } else {
                    alert('خطا در اکسپورت داده‌ها');
                }
            });
        }

        // تابعی برای فیلتر کردن سطرها (سمت کلاینت) و جستجوی عمیق (سمت سرور)
        function handleClientSideFilter(isDeepSearch = false) {
            const allRows = document.querySelectorAll('#search-results-container tbody tr');
            const aSelect = document.getElementById('client-anumber-select');
            const bSelect = document.getElementById('client-bnumber-select');

            if (!aSelect || !bSelect) return;

            const selectedA = aSelect.value;
            const selectedB = bSelect.value;

            // --- منطق جستجوی عمیق (Deep Search) ---
            if (isDeepSearch) {
                // اگر دکمه جستجوی عمیق زده شده، باید فرم اصلی را پر کرده و سابمیت کنیم
                if (!selectedA && !selectedB) {
                    // استفاده از تابع showToast از صفحه اصلی اگر موجود باشد
                    if (typeof showToast === 'function') {
                        showToast('لطفاً حداقل یک شماره برای جستجوی عمیق انتخاب کنید', 'info');
                    } else {
                        alert('لطفاً حداقل یک شماره برای جستجوی عمیق انتخاب کنید');
                    }
                    return;
                }

                // 1. دسترسی به فرم اصلی و کانتینرهای شماره
                const filterForm = document.getElementById('filter-form');
                if (!filterForm) return;

                // 2. پاک کردن ورودی‌های شماره‌ها در فرم اصلی
                const aInputs = filterForm.querySelectorAll('input[name="Filter.ANumbers"]');
                aInputs.forEach(input => input.value = '');

                const bInputs = filterForm.querySelectorAll('input[name="Filter.BNumbers"]');
                bInputs.forEach(input => input.value = '');

                // 3. مقداردهی دوباره ورودی‌ها بر اساس انتخاب کاربر در دراپ‌داون
                // فرض بر این است که حداقل یک ورودی خالی وجود دارد (مقدار اولیه فرم)
                if (selectedA) {
                    const firstAInput = aInputs[0];
                    if (firstAInput) firstAInput.value = selectedA;
                }

                if (selectedB) {
                    const firstBInput = bInputs[0];
                    if (firstBInput) firstBInput.value = selectedB;
                }

                // 4. بازنشانی صفحه به 1 و اجرای جستجو
                const pageInput = document.getElementById('Filter_Page');
                if (pageInput) pageInput.value = 1;

                // فراخوانی تابع performSearch از صفحه اصلی
                if (typeof performSearch === 'function') {
                    performSearch(1);
                } else {
                    filterForm.dispatchEvent(new Event('submit'));
                }
                return;
            }

            // --- منطق فیلتر سریع (Client-Side Quick Filter) ---
            if (!selectedA && !selectedB) {
                allRows.forEach(row => row.style.display = '');
                return;
            }

            // منطق پیشرفته: نمایش روابط بین شماره‌ها
            allRows.forEach(row => {
                const aNum = row.cells[1].textContent.trim(); // سلول شماره مبدأ
                const bNum = row.cells[2].textContent.trim(); // سلول شماره مقصد

                let isVisible = false;

                // اگر هر دو شماره انتخاب شده‌اند، فقط روابط مستقیم بین آنها
                if (selectedA && selectedB) {
                    // روابط مستقیم: تماس از A به B یا از B به A
                    if ((aNum === selectedA && bNum === selectedB) ||
                        (aNum === selectedB && bNum === selectedA)) {
                        isVisible = true;
                    }
                }
                // اگر فقط یک شماره انتخاب شده، همه تماس‌های مربوط به آن
                else if (selectedA && (aNum === selectedA || bNum === selectedA)) {
                    isVisible = true;
                }
                else if (selectedB && (aNum === selectedB || bNum === selectedB)) {
                    isVisible = true;
                }

                row.style.display = isVisible ? '' : 'none';
            });
            
            // بعد از فیلتر، چک‌باکس انتخاب همه را به‌روزرسانی کن
            setTimeout(updateSelectAllCheckbox, 100);
        }

        // تابع مرتب‌سازی
        function handleClientSort() {
            const sortSelect = document.getElementById('sort-select');
            if (!sortSelect) return;

            const sortValue = sortSelect.value;
            const [column, direction] = sortValue.split('-');
            const isAscending = direction === 'asc';

            const tbody = document.querySelector('#search-results-container tbody');
            if (!tbody) return;

            const rows = Array.from(tbody.querySelectorAll('tr'));

            rows.sort((a, b) => {
                let aValue, bValue;

                switch(column) {
                    case 'AccountingTime':
                        const aTimeElem = a.querySelector('[data-datetime]');
                        const bTimeElem = b.querySelector('[data-datetime]');
                        aValue = aTimeElem ? new Date(aTimeElem.dataset.datetime) : new Date(0);
                        bValue = bTimeElem ? new Date(bTimeElem.dataset.datetime) : new Date(0);
                        break;
                    case 'ANumber':
                        aValue = a.cells[1].textContent.trim(); // سلول شماره مبدأ
                        bValue = b.cells[1].textContent.trim();
                        break;
                    case 'BNumber':
                        aValue = a.cells[2].textContent.trim(); // سلول شماره مقصد
                        bValue = b.cells[2].textContent.trim();
                        break;
                    case 'Length':
                        aValue = parseInt(a.cells[4].textContent.trim()) || 0; // سلول مدت زمان
                        bValue = parseInt(b.cells[4].textContent.trim()) || 0;
                        break;
                    default:
                        return 0;
                }

                if (aValue < bValue) return isAscending ? -1 : 1;
                if (aValue > bValue) return isAscending ? 1 : -1;
                return 0;
            });

            tbody.innerHTML = '';
            rows.forEach(row => tbody.appendChild(row));
            
            // بعد از مرتب‌سازی، چک‌باکس‌ها را به‌روزرسانی کن
            updateCheckboxes();
        }

        // اتصال رویدادها بعد از لود شدن این پارشیال
        function initClientSideFilters() {
            // بارگذاری انتخاب‌های قبلی
            loadSelectedCalls();

            // اتصال چک‌باکس‌های تک‌تک ردیف‌ها
            document.addEventListener('change', function(e) {
                if (e.target.classList.contains('call-checkbox')) {
                    const callId = e.target.dataset.callId;
                    const aNumber = e.target.dataset.aNumber;
                    const bNumber = e.target.dataset.bNumber;
                    
                    if (e.target.checked) {
                        addCallToSelection(callId, aNumber, bNumber);
                    } else {
                        removeCallFromSelection(callId);
                    }
                    updateCheckboxes();
                }
            });

            // اتصال چک‌باکس انتخاب همه
            const selectAll = document.getElementById('selectAllCurrentPage');
            if (selectAll) {
                selectAll.addEventListener('change', function() {
                    if (this.checked) {
                        selectAllCurrentPage();
                    } else {
                        deselectAllCurrentPage();
                    }
                });
            }

            // اتصال دکمه‌های اکسپورت
            const exportSelectedBtn = document.getElementById('btnExportSelected');
            if (exportSelectedBtn) {
                exportSelectedBtn.addEventListener('click', exportSelectedCalls);
            }

            // اتصال دکمه پاک کردن همه
            const clearAllBtn = document.getElementById('btnClearAllSelection');
            if (clearAllBtn) {
                clearAllBtn.addEventListener('click', clearAllSelection);
            }

            // اتصال به دراپ‌داون‌ها برای فیلتر سریع
            const clientANumberSelect = document.getElementById('client-anumber-select');
            const clientBNumberSelect = document.getElementById('client-bnumber-select');

            if (clientANumberSelect) {
                clientANumberSelect.addEventListener('change', () => handleClientSideFilter(false));
            }
            if (clientBNumberSelect) {
                clientBNumberSelect.addEventListener('change', () => handleClientSideFilter(false));
            }

            // اتصال به دراپ‌داون مرتب‌سازی
            const sortSelect = document.getElementById('sort-select');
            if (sortSelect) {
                sortSelect.addEventListener('change', handleClientSort);
            }

            // اتصال به دکمه جستجوی عمیق
            const deepSearchBtn = document.getElementById('btnDeepSearch');
            if (deepSearchBtn) {
                deepSearchBtn.addEventListener('click', function () {
                    handleClientSideFilter(true);
                });
            }
        }

        // فراخوانی مقداردهی اولیه
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initClientSideFilters);
        } else {
            initClientSideFilters();
        }
    })();
</script>

