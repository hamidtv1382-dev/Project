@using AnalysisCallUser._01_Domain.Core.Enums
@model AnalysisCallUser._02_Infrastructure.Helpers.PagedResult<AnalysisCallUser._01_Domain.Core.DTOs.CallDetailDto>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center">
        <div class="me-3">
            @if (Model.TotalItems > 0)
            {
                <span class="text-muted">نمایش رکوردهای @((Model.PageNumber - 1) * Model.PageSize + 1) تا @(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalItems)) از @Model.TotalItems</span>
            }
            else
            {
                <span class="text-muted">هیچ رکوردی یافت نشد</span>
            }
        </div>
        @if (Model.TotalItems > 0)
        {
            <div class="btn-group" role="group">
                <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-download"></i> خروجی
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="#" id="exportCurrentPage"><i class="fas fa-file-export me-2"></i>خروجی صفحه فعلی</a></li>
                    <li><a class="dropdown-item" href="#" id="exportAllResults"><i class="fas fa-file-export me-2"></i>خروجی تمام نتایج</a></li>
                    <li><a class="dropdown-item" href="#" id="exportCustom"><i class="fas fa-cog me-2"></i>خروجی با گزینه‌های دلخواه</a></li>
                </ul>
            </div>
        }
    </div>
</div>

<!-- فیلتر ترکیبی شماره‌ها (نوار باریک) -->
@if (Model.TotalItems > 0)
{
    <div class="card mb-3 client-side-filter-bar">
        <div class="card-body py-2">
            <div class="row align-items-center g-2">
                <div class="col-auto">
                    <label for="client-anumber-select" class="col-form-label">فیلتر شماره مبدأ:</label>
                </div>
                <div class="col-auto">
                    <select class="form-select form-select-sm client-anumber-select" id="client-anumber-select">
                        <option value="">همه</option>
                    </select>
                </div>
                <div class="col-auto">
                    <label for="client-bnumber-select" class="col-form-label">فیلتر شماره مقصد:</label>
                </div>
                <div class="col-auto">
                    <select class="form-select form-select-sm client-bnumber-select" id="client-bnumber-select">
                        <option value="">همه</option>
                    </select>
                </div>
                <div class="col-auto">
                    <label for="sort-select" class="col-form-label">مرتب‌سازی:</label>
                </div>
                <div class="col-auto">
                    <select class="form-select form-select-sm" id="sort-select">
                        <option value="AccountingTime-desc">جدیدترین</option>
                        <option value="AccountingTime-asc">قدیمی‌ترین</option>
                        <option value="ANumber-asc">شماره مبدأ (صعودی)</option>
                        <option value="BNumber-asc">شماره مقصد (صعودی)</option>
                        <option value="Length-desc">مدت زمان (بیشترین به کمترین)</option>
                        <option value="Length-asc">مدت زمان (کمترین به بیشترین)</option>
                    </select>
                </div>

                @* --- دکمه جستجوی عمیق (بخش جدید) --- *@
                <div class="col-auto ms-2">
                    <button type="button" id="btnDeepSearch" class="btn btn-sm btn-primary" title="اعمال فیلتر روی تمام صفحات نتایج">
                        <i class="fas fa-layer-group"></i> جستجوی عمیق
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>شماره مبدأ</th>
                <th>شماره مقصد</th>
                <th>تاریخ و زمان</th>
                <th>مدت (ثانیه)</th>
                <th>کشور مبدأ</th>
                <th>کشور مقصد</th>
                <th>وضعیت</th>
                <th>عملیات</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Data.Any())
            {
                @foreach (var call in Model.Data)
                {
                    <tr>
                        <td>@call.ANumber</td>
                        <td>@call.BNumber</td>
                        <td data-datetime="@call.AccountingTime.ToString("yyyy-MM-ddTHH:mm:ss")" class="datetime-cell">
                            @call.AccountingTime.ToString("yyyy/MM/dd HH:mm:ss")
                        </td>
                        <td>@call.Length</td>
                        <td>@call.OriginCountryName</td>
                        <td>@call.DestCountryName</td>
                        <td>
                            @if (call.Answer == CallAnswerStatus.Answered)
                            {
                                <span class="badge bg-success">پاسخ داده شده</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">پاسخ داده نشده</span>
                            }
                        </td>
                        <td style="min-width: 160px;">
                            <div class="d-flex gap-1 justify-content-center">
                                @* لینک جزئیات ساده شده است. چون وضعیت فیلتر در TempData ذخیره شده، نیازی به ارسال پارامتر نیست. *@
                                <a asp-action="Details" asp-route-id="@call.DetailID" class="btn btn-sm btn-outline-primary" title="نمایش جزئیات">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="ExportDetails" asp-route-id="@call.DetailID" class="btn btn-sm btn-outline-success" title="اکسپورت جزئیات">
                                    <i class="fas fa-file-export"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted">هیچ تماسی یافت نشد</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* نمایش بخش صفحه‌بندی *@
@if (Model != null && Model.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            @if (Model.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" href="#" data-page="1" aria-label="First">
                        <span aria-hidden="true">&laquo;&laquo;</span>
                    </a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="#" data-page="@(Model.PageNumber - 1)" aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                        <span aria-hidden="true">&laquo;&laquo;</span>
                    </a>
                </li>
                <li class="page-item disabled">
                    <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>
            }

            @{
                int startPage = Math.Max(1, Model.PageNumber - 2);
                int endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);

                if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="#" data-page="1">1</a>
                    </li>
                    if (startPage > 2)
                    {
                        <li class="page-item disabled">
                            <a class="page-link" href="#" tabindex="-1" aria-disabled="true">...</a>
                        </li>
                    }
                }

                for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" href="#" data-page="@i">@i</a>
                    </li>
                }

                if (endPage < Model.TotalPages)
                {
                    if (endPage < Model.TotalPages - 1)
                    {
                        <li class="page-item disabled">
                            <a class="page-link" href="#" tabindex="-1" aria-disabled="true">...</a>
                        </li>
                    }
                    <li class="page-item">
                        <a class="page-link" href="#" data-page="@Model.TotalPages">@Model.TotalPages</a>
                    </li>
                }
            }

            @if (Model.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link" href="#" data-page="@(Model.PageNumber + 1)" aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="#" data-page="@Model.TotalPages" aria-label="Last">
                        <span aria-hidden="true">&raquo;&raquo;</span>
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
                <li class="page-item disabled">
                    <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                        <span aria-hidden="true">&raquo;&raquo;</span>
                    </a>
                </li>
            }
        </ul>
    </nav>
}

@* --- اسکریپت اختصاصی این Partial View --- *@
<script>
    (function() {
        // تابعی برای فیلتر کردن سطرها (سمت کلاینت) و جستجوی عمیق (سمت سرور)
        function handleClientSideFilter(isDeepSearch = false) {
            const allRows = document.querySelectorAll('#search-results-container tbody tr');
            const aSelect = document.getElementById('client-anumber-select');
            const bSelect = document.getElementById('client-bnumber-select');

            if (!aSelect || !bSelect) return;

            const selectedA = aSelect.value;
            const selectedB = bSelect.value;

            // --- منطق جستجوی عمیق (Deep Search) ---
            if (isDeepSearch) {
                // اگر دکمه جستجوی عمیق زده شده، باید فرم اصلی را پر کرده و سابمیت کنیم
                if (!selectedA && !selectedB) {
                    // استفاده از تابع showToast از صفحه اصلی اگر موجود باشد
                    if (typeof showToast === 'function') {
                        showToast('لطفاً حداقل یک شماره برای جستجوی عمیق انتخاب کنید', 'info');
                    } else {
                        alert('لطفاً حداقل یک شماره برای جستجوی عمیق انتخاب کنید');
                    }
                    return;
                }

                // 1. دسترسی به فرم اصلی و کانتینرهای شماره
                const filterForm = document.getElementById('filter-form');
                if (!filterForm) return;

                // 2. پاک کردن ورودی‌های شماره‌ها در فرم اصلی
                const aInputs = filterForm.querySelectorAll('input[name="Filter.ANumbers"]');
                aInputs.forEach(input => input.value = '');

                const bInputs = filterForm.querySelectorAll('input[name="Filter.BNumbers"]');
                bInputs.forEach(input => input.value = '');

                // 3. مقداردهی دوباره ورودی‌ها بر اساس انتخاب کاربر در دراپ‌داون
                // فرض بر این است که حداقل یک ورودی خالی وجود دارد (مقدار اولیه فرم)
                if (selectedA) {
                    const firstAInput = aInputs[0];
                    if (firstAInput) firstAInput.value = selectedA;
                }

                if (selectedB) {
                    const firstBInput = bInputs[0];
                    if (firstBInput) firstBInput.value = selectedB;
                }

                // 4. بازنشانی صفحه به 1 و اجرای جستجو
                const pageInput = document.getElementById('Filter_Page');
                if (pageInput) pageInput.value = 1;

                // فراخوانی تابع performSearch از صفحه اصلی
                if (typeof performSearch === 'function') {
                    performSearch(1);
                } else {
                    filterForm.dispatchEvent(new Event('submit'));
                }
                return;
            }

            // --- منطق فیلتر سریع (Client-Side Quick Filter) ---
            if (!selectedA && !selectedB) {
                allRows.forEach(row => row.style.display = '');
                return;
            }

            // منطق پیشرفته: نمایش روابط بین شماره‌ها
            allRows.forEach(row => {
                const aNum = row.cells[0].textContent.trim();
                const bNum = row.cells[1].textContent.trim();

                let isVisible = false;

                // اگر هر دو شماره انتخاب شده‌اند، فقط روابط مستقیم بین آنها
                if (selectedA && selectedB) {
                    // روابط مستقیم: تماس از A به B یا از B به A
                    if ((aNum === selectedA && bNum === selectedB) ||
                        (aNum === selectedB && bNum === selectedA)) {
                        isVisible = true;
                    }
                }
                // اگر فقط یک شماره انتخاب شده، همه تماس‌های مربوط به آن
                else if (selectedA && (aNum === selectedA || bNum === selectedA)) {
                    isVisible = true;
                }
                else if (selectedB && (aNum === selectedB || bNum === selectedB)) {
                    isVisible = true;
                }

                row.style.display = isVisible ? '' : 'none';
            });
        }

        // تابع مرتب‌سازی
        function handleClientSort() {
            const sortSelect = document.getElementById('sort-select');
            if (!sortSelect) return;

            const sortValue = sortSelect.value;
            const [column, direction] = sortValue.split('-');
            const isAscending = direction === 'asc';

            const tbody = document.querySelector('#search-results-container tbody');
            if (!tbody) return;

            const rows = Array.from(tbody.querySelectorAll('tr'));

            rows.sort((a, b) => {
                let aValue, bValue;

                switch(column) {
                    case 'AccountingTime':
                        const aTimeElem = a.querySelector('[data-datetime]');
                        const bTimeElem = b.querySelector('[data-datetime]');
                        aValue = aTimeElem ? new Date(aTimeElem.dataset.datetime) : new Date(0);
                        bValue = bTimeElem ? new Date(bTimeElem.dataset.datetime) : new Date(0);
                        break;
                    case 'ANumber':
                        aValue = a.cells[0].textContent.trim();
                        bValue = b.cells[0].textContent.trim();
                        break;
                    case 'BNumber':
                        aValue = a.cells[1].textContent.trim();
                        bValue = b.cells[1].textContent.trim();
                        break;
                    case 'Length':
                        aValue = parseInt(a.cells[3].textContent.trim()) || 0;
                        bValue = parseInt(b.cells[3].textContent.trim()) || 0;
                        break;
                    default:
                        return 0;
                }

                if (aValue < bValue) return isAscending ? -1 : 1;
                if (aValue > bValue) return isAscending ? 1 : -1;
                return 0;
            });

            tbody.innerHTML = '';
            rows.forEach(row => tbody.appendChild(row));
        }

        // اتصال رویدادها بعد از لود شدن این پارشیال
        function initClientSideFilters() {
            // اتصال به دراپ‌داون‌ها برای فیلتر سریع
            const clientANumberSelect = document.getElementById('client-anumber-select');
            const clientBNumberSelect = document.getElementById('client-bnumber-select');

            if (clientANumberSelect) {
                clientANumberSelect.addEventListener('change', () => handleClientSideFilter(false));
            }
            if (clientBNumberSelect) {
                clientBNumberSelect.addEventListener('change', () => handleClientSideFilter(false));
            }

            // اتصال به دراپ‌داون مرتب‌سازی
            const sortSelect = document.getElementById('sort-select');
            if (sortSelect) {
                sortSelect.addEventListener('change', handleClientSort);
            }

            // اتصال به دکمه جستجوی عمیق
            const deepSearchBtn = document.getElementById('btnDeepSearch');
            if (deepSearchBtn) {
                deepSearchBtn.addEventListener('click', function () {
                    handleClientSideFilter(true);
                });
            }
        }

        // فراخوانی مقداردهی اولیه
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initClientSideFilters);
        } else {
            initClientSideFilters();
        }
    })();
</script>