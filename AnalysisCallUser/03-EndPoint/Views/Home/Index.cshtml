@using AnalysisCallUser._01_Domain.Core.Enums
@using System.Globalization
@model AnalysisCallUser._03_EndPoint.Models.ViewModels.Dashboard.DashboardViewModel

@{
    ViewData["Title"] = "داشبورد";
}

<!-- فرم مورد نیاز برای توکن امنیتی در درخواست‌های AJAX -->
<form id="anti-forgery-form">
    @Html.AntiForgeryToken()
</form>

<div class="dashboard-container">
    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
    {
        <div class="page-header">
            <h3>داشبورد</h3>
            <div class="page-actions">
                <button id="refresh-dashboard" class="btn btn-outline-primary">
                    <i class="fas fa-sync-alt"></i> به‌روزرسانی
                </button>
                <button id="clear-cache" class="btn btn-outline-warning">
                    <i class="fas fa-trash"></i> خالی کردن کش
                </button>
            </div>
        </div>
    }
    <div class="row">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-phone"></i>
                </div>
                <div class="stat-content">
                    <h3>@Model.TotalCalls.ToString("N0")</h3>
                    <p>کل تماس‌ها</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon answered">
                    <i class="fas fa-phone-alt"></i>
                </div>
                <div class="stat-content">
                    <h3>@Model.AnsweredCalls.ToString("N0")</h3>
                    <p>تماس‌های پاسخ داده شده</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon duration">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="stat-content">
                    <h3>@Model.AverageCallDuration.ToString("F1")</h3>
                    <p>میانگین مدت تماس (ثانیه)</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon rate">
                    <i class="fas fa-percentage"></i>
                </div>
                <div class="stat-content">
                    <h3>@(Model.TotalCalls > 0 ? ((double)Model.AnsweredCalls / Model.TotalCalls * 100).ToString("F1") : "0")%</h3>
                    <p>نرخ پاسخگویی</p>
                </div>
            </div>
        </div>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
    {
        <div class="row mt-4">
            <div class="col-md-8">
                <div class="chart-container">
                    <h4>فعالیت اخیر (۵ مورد آخر)</h4>
                    <canvas id="recent-activity-chart" width="400" height="200"></canvas>
                </div>
            </div>
            <div class="col-md-4">
                <div class="chart-container">
                    <h4>شهرهای برتر تماس با ایران</h4>
                    <canvas id="top-cities-chart" width="400" height="200"></canvas>
                </div>
            </div>
        </div>
    }
    <div class="row mt-4">
        <div class="col-md-12">
            <div class="map-container">
                <h4>نقشه ایران و آذربایجان</h4>
                <!-- Styles -->
                <style>
                    #chartdiv {
                        width: 100%;
                        height: 650px;
                        background-color: #2c2c2c; /* پس‌زمینه تیره متناسب با تم سایت */
                        color: #ffffff; /* رنگ متن پیش‌فرض */
                    }
                </style>

                <!-- Resources -->
                <script src="https://cdn.amcharts.com/lib/5/index.js"></script>
                <script src="https://cdn.amcharts.com/lib/5/map.js"></script>
                <script src="https://cdn.amcharts.com/lib/5/geodata/worldLow.js"></script>
                <script src="https://cdn.amcharts.com/lib/5/themes/Animated.js"></script>

                <!-- Chart code -->
                <script>
                    am5.ready(function() {

                    var bulletColor = am5.color(0xc83830);
                    var polygonColor = am5.color(0xd9cec8);

                    // فقط ایران و آذربایجان با مقادیر مشخص
                    var data = [
                      {
                        "id": "IR",
                        "threatened": 100,
                        "updated": 100
                      },
                      {
                        "id": "AZ",
                        "threatened": 100,
                        "updated": 100
                      }
                    ]

                    var root = am5.Root.new("chartdiv");

                    var myTheme = am5.Theme.new(root);

                    myTheme.rule("InterfaceColors").setAll({
                      primaryButton: am5.color(0xc83830),
                      primaryButtonHover: am5.Color.lighten(am5.color(0xc83830), 0.2),
                      primaryButtonDown: am5.Color.lighten(am5.color(0xc83830), -0.2),
                      primaryButtonActive: am5.color(0xd9cec8),
                    });

                    // تنظیم رنگ متن پیش‌فرض برای تم تیره
                    myTheme.rule("Label").setAll({
                      fontSize: "0.8em",
                      fill: am5.color(0xffffff) // متن‌ها به رنگ سفید
                    });

                    root.setThemes([am5themes_Animated.new(root), myTheme]);

                    var chart = root.container.children.push(am5map.MapChart.new(root, {
                      projection: am5map.geoMercator()
                    }));

                    var graticuleSeries = chart.series.unshift(
                      am5map.GraticuleSeries.new(root, {
                        step: 10
                      })
                    );

                    graticuleSeries.mapLines.template.set("strokeOpacity", 0.05)

                    var cont = chart.children.push(am5.Container.new(root, {
                      layout: root.horizontalLayout,
                      x: am5.percent(15),
                      centerX: 0,
                      y: am5.percent(100),
                      dy: -40,
                      // پس‌زمینه سفید حذف شد
                      paddingTop: 5,
                      paddingBottom: 5,
                      paddingLeft: 10,
                      paddingRight: 10
                    }));

                    // افزودن کنترل‌ها و برچسب‌ها
                    cont.children.push(am5.Label.new(root, {
                      centerY: am5.p50,
                      text: "نقشه",
                      fill: am5.color(0xffffff) // متن به رنگ سفید
                    }));

                    var switchButton = cont.children.push(am5.Button.new(root, {
                      themeTags: ["switch"],
                      centerY: am5.p50,
                      icon: am5.Circle.new(root, {
                        themeTags: ["icon"]
                      })
                    }));

                    switchButton.on("active", function () {
                      if (!switchButton.get("active")) {
                        chart.set("projection", am5map.geoMercator());
                        chart.set("panY", "translateY");
                        chart.set("rotationY", 0);
                        polygonSeries.set("exclude", ["AQ"]);

                      } else {
                        chart.set("projection", am5map.geoOrthographic());
                        chart.set("panY", "rotateY")
                        chart.set("panX", "rotateX");
                        polygonSeries.set("exclude", []);
                        chart.animate({ key: "rotationX", to: chart.get("rotationX") + 360, duration: 15000, easing: am5.ease.inOut(am5.ease.cubic) });
                      }
                    });

                    cont.children.push(
                      am5.Label.new(root, {
                        centerY: am5.p50,
                        text: "کره",
                        fill: am5.color(0xffffff) // متن به رنگ سفید
                      })
                    );

                    var polygonSeries = chart.series.push(
                      am5map.MapPolygonSeries.new(root, {
                        geoJSON: am5geodata_worldLow,
                        valueField: "threatened",
                        calculateAggregates: true,
                        exclude: ["AQ"]
                      })
                    );

                    polygonSeries.mapPolygons.template.events.on("pointerover", function (ev) {
                      heatLegend.showValue(ev.target.dataItem.get("value"));
                    });

                    polygonSeries.set("heatRules", [{
                      target: polygonSeries.mapPolygons.template,
                      dataField: "value",
                      min: am5.color(0xd9cec8), // رنگ خنثی برای کشورها بدون داده
                      max: am5.color(0x6f0600), // رنگ برجسته برای ایران و آذربایجان
                      key: "fill"
                    }]);

                    polygonSeries.mapPolygons.template.setAll({
                      tooltipText: "{name}",
                      fill: polygonColor,
                      stroke: am5.color(0x000000), // تغییر رنگ خطوط به مشکی
                      strokeWidth: 1
                    });

                    polygonSeries.data.setAll(data);

                    var heatLegend = chart.children.push(am5.HeatLegend.new(root, {
                      orientation: "vertical",
                      startColor: am5.color(0xd9cec8),
                      endColor: am5.color(0x6f0600),
                      startText: "پایین",
                      endText: "بالا",
                      stepCount: 8,
                      x: am5.p100,
                      centerX: am5.p100,
                      paddingRight: 20,
                      paddingTop: 20,
                      paddingBottom: 20
                    }));

                    heatLegend.startLabel.setAll({
                      fontSize: 12,
                      fill: am5.color(0xcccccc) // متن روشن برای خوانایی
                    });

                    heatLegend.endLabel.setAll({
                      fontSize: 12,
                      fill: am5.color(0xcccccc) // متن روشن برای خوانایی
                    });

                    polygonSeries.events.on("datavalidated", function () {
                      heatLegend.set("startValue", polygonSeries.getPrivate("valueLow"));
                      heatLegend.set("endValue", polygonSeries.getPrivate("valueHigh"));
                    });

                    var title = chart.children.push(am5.Label.new(root, {
                      text: "نقشه ایران و آذربایجان",
                      fontSize: 20,
                      x: am5.percent(50),
                      centerX: am5.p50,
                      y: 40,
                      fill: am5.color(0xffffff) // عنوان به رنگ سفید
                    }));

                    }); // end am5.ready()
                </script>

                <!-- HTML -->
                <div id="chartdiv"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/dist/chart.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {

            const recentActivityCtx = document.getElementById('recent-activity-chart').getContext('2d');
            const recentActivityChart = new Chart(recentActivityCtx, {
                type: 'line',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.RecentActivity.Select(d => d.Label))),
                    datasets: [{
                        label: 'تعداد تماس‌ها',
                        data: @Html.Raw(Json.Serialize(Model.RecentActivity.Select(d => d.Value))),
                        backgroundColor: 'rgba(0, 173, 181, 0.2)',
                        borderColor: 'rgba(0, 173, 181, 1)',
                        borderWidth: 2,
                        tension: 0.4,
                        fill: true,
                        pointBackgroundColor: 'rgba(0, 173, 181, 1)',
                        pointBorderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });

            const topCitiesCtx = document.getElementById('top-cities-chart').getContext('2d');
            const topCitiesChart = new Chart(topCitiesCtx, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.TopCities.Select(d => d.Label))),
                    datasets: [{
                        label: 'تعداد تماس‌ها',
                        data: @Html.Raw(Json.Serialize(Model.TopCities.Select(d => d.Value))),
                        backgroundColor: 'rgba(255, 99, 132, 0.2)',
                        borderColor: 'rgba(255, 99, 132, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true }
                    },
                    plugins: { legend: { display: false } }
                }
            });

            document.getElementById('refresh-dashboard').addEventListener('click', function() {
                location.reload();
            });

            document.getElementById('clear-cache').addEventListener('click', async function() {

                const clearButton = document.getElementById('clear-cache');
                const originalText = clearButton.innerHTML;
                clearButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> در حال انجام...';
                clearButton.disabled = true;

                try {
                    const token = document.querySelector('#anti-forgery-form input[name="__RequestVerificationToken"]').value;

                    const response = await fetch('/Home/ClearCache', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token
                        }
                    });

                    if (response.ok) {
                        const result = await response.json();
                        alert(result.message);
                        location.reload();
                    } else {
                        alert('خطا در خالی کردن کش.');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('خطا در ارتباط با سرور.');
                } finally {
                    clearButton.innerHTML = originalText;
                    clearButton.disabled = false;
                }
            });
        });
    </script>
}