@model AnalysisCallUser._02_Infrastructure.Helpers.PagedResult<AnalysisCallUser._01_Domain.Core.DTOs.CallDetailDto>

@{
    // تعداد صفحاتی که در هر سمت صفحه فعلی نمایش داده می‌شوند
    int delta = 2;
    var currentPage = Model.PageNumber;
    var totalPages = Model.TotalPages;

    // محاسبه بازه صفحاتی که باید نمایش داده شوند
    var rangeStart = Math.Max(1, currentPage - delta);
    var rangeEnd = Math.Min(totalPages, currentPage + delta);
}

<nav aria-label="Page navigation">
    <ul class="pagination justify-content-center">
        @if (Model.HasPreviousPage)
        {
            <li class="page-item">
                <a class="page-link" href="#" data-page="@(currentPage - 1)" aria-label="Previous">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>
        }

        @* نمایش صفحه اول *@
        <li class="page-item @(1 == currentPage ? "active" : "")">
            <a class="page-link" href="#" data-page="1">1</a>
        </li>

        @* نمایش "..." اگر بین صفحه اول و بازه فعلی فاصله وجود داشته باشد *@
        @if (rangeStart > 2)
        {
            <li class="page-item disabled">
                <span class="page-link">...</span>
            </li>
        }

        @* نمایش صفحات در بازه محاسبه شده *@
        @for (int i = rangeStart; i <= rangeEnd; i++)
        {
            // از تکرار نمایش صفحه اول و آخر خودداری می‌کنیم
            if (i == 1 || i == totalPages)
            {
                continue;
            }

            <li class="page-item @(i == currentPage ? "active" : "")">
                <a class="page-link" href="#" data-page="@i">@i</a>
            </li>
        }

        @* نمایش "..." اگر بین بازه فعلی و صفحه آخر فاصله وجود داشته باشد *@
        @if (rangeEnd < totalPages - 1)
        {
            <li class="page-item disabled">
                <span class="page-link">...</span>
            </li>
        }

        @* نمایش صفحه آخر (اگر با صفحه اول یکی نباشد) *@
        @if (totalPages > 1)
        {
            <li class="page-item @(totalPages == currentPage ? "active" : "")">
                <a class="page-link" href="#" data-page="@totalPages">@totalPages</a>
            </li>
        }

        @if (Model.HasNextPage)
        {
            <li class="page-item">
                <a class="page-link" href="#" data-page="@(currentPage + 1)" aria-label="Next">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
        }
    </ul>
</nav>
