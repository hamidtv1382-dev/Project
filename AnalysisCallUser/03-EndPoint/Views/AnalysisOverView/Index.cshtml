        function renderTreemapLevel(data, title, parentTotal) {
            currentTreemapData = data;
            document.getElementById('treemapHeaderTitle').innerText = title;
            document.getElementById('treemapBackBtn').style.display = treemapHistory.length > 0 ? 'inline-block' : 'none';

            const container = document.getElementById('treemapContainer');
            const grid = document.getElementById('treemapGrid');
            grid.innerHTML = '';

            if (!data || data.length === 0) {
                grid.innerHTML = `<div class="treemap-empty"><i class="bi bi-tree"></i><h6>داده‌ای در این سطح وجود ندارد</h6></div>`;
                return;
            }

            data.sort((a, b) => b.total - a.total);

            const containerWidth = grid.clientWidth;
            const containerHeight = grid.clientHeight;
            const totalArea = containerWidth * containerHeight;
            const MIN_ITEM_AREA = 800;
            const MIN_ITEM_WIDTH = 60;
            const MIN_ITEM_HEIGHT = 40;

            data.forEach(item => {
                const realArea = (item.total / parentTotal) * totalArea;
                item.area = Math.max(realArea, MIN_ITEM_AREA);
            });

            const layout = squarifiedTreemap(data, 0, 0, containerWidth, containerHeight);

            layout.forEach(rect => {
                const item = rect.data;
                const div = document.createElement('div');
                div.className = `treemap-item ${item.colorClass} ${rect.width * rect.height < 1500 ? 'small' : ''}`;
                div.style.position = 'absolute';
                div.style.left = `${rect.x}px`;
                div.style.top = `${rect.y}px`;

                const finalWidth = Math.max(rect.width, MIN_ITEM_WIDTH);
                const finalHeight = Math.max(rect.height, MIN_ITEM_HEIGHT);
                div.style.width = `${finalWidth}px`;
                div.style.height = `${finalHeight}px`;

                const percentage = ((item.total / parentTotal) * 100).toFixed(1);
                const showDetails = (finalWidth > 80 && finalHeight > 60);

                div.innerHTML = `
                    <div class="treemap-label">
                        ${showDetails ? `<span class="treemap-title">${item.name}</span>` : `<span class="treemap-title" style="font-size:10px">${item.name.substring(0, 15)}${item.name.length > 15 ? '...' : ''}</span>`}
                        ${showDetails ? `<span class="treemap-stat">${item.total.toLocaleString('fa-IR')} تماس</span>` : ''}
                        ${showDetails ? `<span class="treemap-percentage">${percentage}%</span>` : ''}
                    </div>`;

                div.addEventListener('mouseenter', function(e) {
                    const tooltipContent = `<strong>${item.name}</strong><br>کل: ${item.total.toLocaleString('fa-IR')}<br>موفق: ${item.success.toLocaleString('fa-IR')}<br>ناموفق: ${item.fail.toLocaleString('fa-IR')}`;
                    showTreemapTooltip(e, tooltipContent);
                });

                div.addEventListener('mousemove', moveTreemapTooltip);
                div.addEventListener('mouseleave', hideTreemapTooltip);

                if (item.children && item.children.length > 0) {
                    div.style.cursor = 'pointer';
                    div.addEventListener('click', function(e) {
                        e.stopPropagation();
                        treemapHistory.push({ data: currentTreemapData, title: document.getElementById('treemapHeaderTitle').innerText, total: parentTotal });
                        currentLevel++;
                        breadcrumbHistory.push({ name: item.name, level: currentLevel, data: item.children });
                        renderTreemapLevel(item.children, item.name, item.total);
                        updateBreadcrumb();
                    });
                } else { div.style.cursor = 'default'; }

                grid.appendChild(div);
            });
        }

        function squarifiedTreemap(items, x, y, width, height) {
            const layout = [];
            let row = [];
            let rowWidth = width;
            let rowHeight = 0;
            let rowArea = 0;
            const isVertical = height > width;
            if (isVertical) { [width, height] = [height, width]; [x, y] = [y, x]; }
            items.forEach(item => {
                const area = item.area;
                const potentialRow = [...row, item];
                const totalArea = rowArea + area;
                const aspectRatio = calculateAspectRatio(potentialRow, totalArea, width, height);

                if (row.length === 0 || aspectRatio <= calculateAspectRatio(row, rowArea, width, height)) {
                    row = potentialRow; rowArea = totalArea;
                } else {
                    layout.push(...layoutRow(row, x, y, rowWidth, rowHeight, rowArea, isVertical));
                    const usedHeight = rowHeight;
                    if (isVertical) { x += rowWidth; } else { y += rowHeight; }
                    row = [item]; rowArea = area; rowHeight = 0;
                    rowWidth = isVertical ? height - usedHeight : width;
                }
            });
            if (row.length > 0) { layout.push(...layoutRow(row, x, y, rowWidth, rowHeight, rowArea, isVertical)); }
            return layout;
        }

        function calculateAspectRatio(row, totalArea, width, height) {
            const rowWidth = width; const rowHeight = totalArea / rowWidth;
            let minRatio = Infinity; let maxRatio = 0;
            row.forEach(item => {
                const itemWidth = (item.area / totalArea) * rowWidth;
                const itemHeight = rowHeight;
                const ratio = Math.max(itemWidth / itemHeight, itemHeight / itemWidth);
                minRatio = Math.min(minRatio, ratio);
                maxRatio = Math.max(maxRatio, ratio);
            });
            return maxRatio;
        }

        function layoutRow(row, x, y, width, height, totalArea, isVertical) {
            const rowHeight = totalArea / width;
            const layout = [];
            let currentX = x; let currentY = y;
            row.forEach(item => {
                const itemWidth = (item.area / totalArea) * width;
                const itemHeight = rowHeight;
                let rect = { x: currentX, y: currentY, width: itemWidth, height: itemHeight, data: item };
                if (isVertical) { rect = { x: currentY, y: currentX, width: itemHeight, height: itemWidth, data: item }; }
                layout.push(rect);
                if (isVertical) { currentY += itemWidth; } else { currentX += itemWidth; }
            });
            return layout;
        }

        function updateBreadcrumb() {
            const breadcrumbContainer = document.getElementById('treemapBreadcrumb');
            breadcrumbContainer.innerHTML = '';
            breadcrumbHistory.forEach((item, index) => {
                const span = document.createElement('span');
                span.className = `breadcrumb-item ${index === breadcrumbHistory.length - 1 ? 'active' : ''}`;
                span.textContent = item.name;
                if (index < breadcrumbHistory.length - 1) {
                    span.addEventListener('click', function() {
                        const targetLevel = item.level;
                        while (breadcrumbHistory.length > targetLevel + 1) {
                            breadcrumbHistory.pop();
                            if (treemapHistory.length > 0) {
                                const prevState = treemapHistory.pop();
                                renderTreemapLevel(prevState.data, prevState.title, prevState.total);
                            }
                        }
                        currentLevel = targetLevel;
                        updateBreadcrumb();
                    });
                }
                breadcrumbContainer.appendChild(span);
                if (index < breadcrumbHistory.length - 1) {
                    const separator = document.createElement('span');
                    separator.className = 'breadcrumb-separator';
                    separator.innerHTML = '&nbsp;/&nbsp;';
                    breadcrumbContainer.appendChild(separator);
                }
            });
        }

        function showTreemapTooltip(event, content) {
            treemapTooltip.innerHTML = content;
            treemapTooltip.style.display = 'block';
            moveTreemapTooltip(event);
        }

        function moveTreemapTooltip(event) {
            treemapTooltip.style.left = `${event.clientX + 10}px`;
            treemapTooltip.style.top = `${event.clientY + 10}px`;
        }

        function hideTreemapTooltip() { treemapTooltip.style.display = 'none'; }

        function goBackTreemap() {
            if (treemapHistory.length > 0) {
                const prevState = treemapHistory.pop();
                breadcrumbHistory.pop();
                currentLevel--;
                renderTreemapLevel(prevState.data, prevState.title, prevState.total);
                updateBreadcrumb();
            }
        }
        document.getElementById('treemapBackBtn').addEventListener('click', goBackTreemap);

        // --- متغیر سراسری برای نگهداری داده‌های آم‌چارت ---
        let amchartsDataGlobal = null;

        // --- منطق نمودار درختی amCharts (کشور-شهر-اپراتور) ---
        function initAmchartsForceGraph(data) {
            // ذخیره داده برای اکسپورت
            amchartsDataGlobal = data;

            // Destroy previous instance if exists to save memory
            if (amchartsRoot) {
                amchartsRoot.dispose();
            }

            // Create root element
            amchartsRoot = am5.Root.new("chartdiv");

            // Set themes
            amchartsRoot.setThemes([
                am5themes_Animated.new(amchartsRoot)
            ]);

            // Create zoomable container
            var zoomableContainer = amchartsRoot.container.children.push(
                am5.ZoomableContainer.new(amchartsRoot, {
                    width: am5.p100,
                    height: am5.p100,
                    wheelable: true,
                    pinchZoom: true
                })
            );

            var zoomTools = zoomableContainer.children.push(am5.ZoomTools.new(amchartsRoot, {
                target: zoomableContainer
            }));

            // Create series
            var series = zoomableContainer.contents.children.push(am5hierarchy.ForceDirected.new(amchartsRoot, {
                maskContent: false,
                singleBranchOnly: false,
                downDepth: 2,
                topDepth: 1,
                initialDepth: 3,
                valueField: "value",
                categoryField: "name",
                childDataField: "children",
                idField: "name",
                linkWithField: "linkWith",
                manyBodyStrength: -10,
                centerStrength: 0.8,
                minRadius: 20 // جلوگیری از پرش ناگهانی سایز در لحظه لود
            }));

            series.get("colors").setAll({
                step: 2
            });

            series.links.template.set("strength", 0.5);

            // --- تنظیمات جدید برای اصلاح رنگ و موقعیت لیبل‌ها ---
            // 1. رنگ متن: مشکی
            series.labels.template.set("fill", am5.color(0x000000));

            // 2. فونت فارسی
            series.labels.template.setAll({
                fontSize: 12,
                fontFamily: "Vazirmatn, sans-serif",
                // 3. موقعیت: در مرکز و داخل دایره
                textAlign: "center",
                textValign: "middle",
                centerX: am5.p50,
                centerY: am5.p50,
                // اطمینان از عدم پوشانده شدن توسط دایره (برای حاشیه امن)
                dy: 0,
                dx: 0,
                // اجبار به نمایش لیبل
                forceState: true
            });

            // 4. تنظیمات Tooltip سفارشی (رنگ مشکی)
            series.nodes.template.tooltipText = "[bold]{name}[/]\n{value} تماس";

            // رویداد آماده‌سازی داده برای اضافه کردن اطلاعات والد (کشور و شهر)
            series.nodes.template.events.on("datavalidated", function(ev) {
                var dataItem = ev.target.dataItem;
                // اگر اپراتور باشد (سطح سوم)، اطلاعات والدین را اضافه کن
                if (dataItem.children.length === 0 && dataItem.parent && dataItem.parent.parent) {
                    var city = dataItem.parent;
                    var country = city.parent;
                    // فرمت جدید tooltip
                    ev.target.tooltipText = "[bold]اپراتور: {name}[/]\nکل تماس: {value}\n[fontSize:10px]شهر: " + city.get("name") + " | کشور: " + country.get("name") + "[/]";
                }
                // اگر شهر باشد (سطح دوم)
                else if (dataItem.children.length > 0 && dataItem.parent) {
                     var country = dataItem.parent;
                     ev.target.tooltipText = "[bold]شهر: {name}[/]\nکل تماس: {value}\n[fontSize:10px]کشور: " + country.get("name") + "[/]";
                }
            });

            series.data.setAll([data]);

            series.set("selectedDataItem", series.dataItems[0]);

            // Make stuff animate on load
            series.appear(1000, 100);
        }

        // --- منطق نمودار Word Cloud (کشور/شهر/اپراتور) ---
        function initWordCloud(typesData) {
            if (wordCloudRoot) {
                wordCloudRoot.dispose();
            }

            wordCloudRoot = am5.Root.new("wordCloudChartDiv");
            wordCloudRoot.setThemes([
                am5themes_Animated.new(wordCloudRoot)
            ]);

            // استخراج داده‌ها برای ابر کلمات
            // ما می‌خواهیم همه کشورها، شهرها و اپراتورها را با توجه به حجم تماسشان نمایش دهیم.
            const wordCloudData = [];

            typesData.forEach(t => {
                // تایپ تماس (مثلاً تماس صوتی) - سطح بالاتر
                if (t.totalCount > 0) {
                    wordCloudData.push({ tag: t.typeName, weight: t.totalCount });
                }

                if (t.countries) {
                    t.countries.forEach(c => {
                        // کشور
                        if (c.totalCount > 0) {
                            wordCloudData.push({ tag: c.countryName, weight: c.totalCount });
                        }

                        if (c.cities) {
                            c.cities.forEach(city => {
                                // شهر
                                if (city.totalCount > 0) {
                                    wordCloudData.push({ tag: city.cityName, weight: city.totalCount });
                                }

                                if (city.operators) {
                                    city.operators.forEach(op => {
                                        // اپراتور
                                        if (op.totalCount > 0) {
                                            wordCloudData.push({ tag: op.operatorName, weight: op.totalCount });
                                        }
                                    });
                                }
                            });
                        }
                    });
                }
            });

            // مرتب‌سازی داده‌ها بر اساس وزن (برای نمایش بهتر)
            wordCloudData.sort((a, b) => b.weight - a.weight);
            // محدود کردن تعداد کلمات برای رندر سریع‌تر و تمیزی بیشتر (مثلاً 50 تا پرترددترین)
            const topWords = wordCloudData.slice(0, 100);

            var series = wordCloudRoot.container.children.push(am5wc.WordCloud.new(wordCloudRoot, {
                categoryField: "tag",
                valueField: "weight",
                maxFontSize: am5.percent(18),
                minFontSize: am5.percent(3),
                calculateAggregates: true, // برای بهتر جاگیری
                randomness: 0.2,
                excludeWords: ["همه", "نامشخص"], // کلمات ناخواسته
                rotation: 0 // <-- تغییر انجام شده: چپ‌چین کردن ابر کلمات (حذف چرخش عمودی)
            }));

            // تنظیمات فونت و رنگ
            series.labels.template.setAll({
                fontFamily: "Vazirmatn, Tahoma, Arial",
                tooltipText: "[bold]{tag}[/]\n{weight} تماس",
                fontSize: 14
            });

            series.labels.template.adapters.add("fill", function(fill, target) {
                // استفاده از رنگ‌های متنوع و زیبا بر اساس وزن
                if (target.dataItem) {
                    const weight = target.dataItem.get("value");
                    // رنگ‌بندی از بنفش برای وزن‌های بالا تا آبی/خاکستری برای پایین
                    if (weight > 10000) return am5.color(0x6f42c1);
                    if (weight > 5000) return am5.color(0x0dcaf0);
                    if (weight > 2000) return am5.color(0x20c997);
                    return am5.color(0x6c757d);
                }
                return fill;
            });

            series.data.setAll(topWords);
        }

        // --- دریافت داده‌های اصلی و هندل کردن فیلترها ---
        async function loadData() {
            if (isRequestInProgress && abortController) { abortController.abort(); }

            const yearVal = document.getElementById('selectYear').value;
            const monthVal = document.getElementById('selectMonth').value;
            const btnFilter = document.getElementById('btnFilter');
            const btnCancel = document.getElementById('btnCancel');

            let params = new URLSearchParams();
            if (monthVal) { params.append('year', yearVal); params.append('month', monthVal); }
            else if (yearVal) { params.append('year', yearVal); }
            else { alert('لطفاً سال را انتخاب کنید.'); return; }

            abortController = new AbortController();
            isRequestInProgress = true;

            const originalBtnText = btnFilter.innerHTML;
            btnFilter.innerHTML = '<span class="spinner-border spinner-border-sm"></span> پردازش...';
            btnFilter.disabled = true;
            btnCancel.style.display = 'inline-block';

            document.getElementById('treemapLoading').style.display = 'flex';

            try {
                const response = await fetch(`GetChartData?${params.toString()}`, { signal: abortController.signal });

                if (abortController.signal.aborted) { console.log('درخواست توسط کاربر لغو شد.'); return; }

                const result = await response.json();

                if (result.success) {
                    document.getElementById('totalCalls').innerText = result.statistics.totalCalls.toLocaleString('fa-IR');
                    document.getElementById('totalSuccess').innerText = result.statistics.totalSuccess.toLocaleString('fa-IR');
                    document.getElementById('totalFail').innerText = result.statistics.totalFail.toLocaleString('fa-IR');
                    document.getElementById('successRate').innerText = result.statistics.successRate + '%';
                    document.getElementById('dateRangeDisplay').innerText = `بازه انتخابی: ${result.dateRange.persianStart} تا ${result.dateRange.persianEnd}`;

                    const labels = result.data.map(d => d.displayDate);
                    const displayDatesFull = result.data.map(d => d.displayDate);
                    const successData = result.data.map(d => d.success);
                    const failData = result.data.map(d => d.fail);
                    const totalCallsData = result.data.map(d => d.success + d.fail);

                    initLineChart(labels, successData, failData, displayDatesFull);
                    initTotalCallsChart(labels, totalCallsData, displayDatesFull);

                    if (result.typeBreakdown && Array.isArray(result.typeBreakdown)) {
                        globalTypeBreakdown = result.typeBreakdown;
                        populateFiltersFromData(globalTypeBreakdown);
                        initMainPieChart(globalTypeBreakdown);
                        initCountryCharts(globalTypeBreakdown);
                        initTreemap(globalTypeBreakdown);

                        // اجرای اولیه فیلترها برای نمایش نمودار پیش‌فرض
                        applyLocationFilter();
                        applyCategoryFilter();

                        // --- آماده‌سازی داده برای نمودار amCharts (سلسله مراتب صحیح) ---
                        // ساختار: کشور (توپ بزرگ) -> شهر (متوسط) -> اپراتور (کوچک)

                        const allCountriesMap = new Map();

                        globalTypeBreakdown.forEach(t => {
                            if (t.countries) {
                                t.countries.forEach(c => {
                                    if (!allCountriesMap.has(c.countryID)) {
                                        allCountriesMap.set(c.countryID, {
                                            name: c.countryName,
                                            value: 0,
                                            children: []
                                        });
                                    }
                                    const countryNode = allCountriesMap.get(c.countryID);

                                    // اضافه کردن تماس‌های کلی به ارزش کشور (برای اندازه دایره بزرگ)
                                    countryNode.value += c.totalCount;

                                    // پردازش شهرها
                                    if (c.cities) {
                                        c.cities.forEach(city => {
                                            // چک کردن تکراری نبودن شهر در این کشور (از تایپ‌های مختلف ممکن است بیاید)
                                            let cityNode = countryNode.children.find(ch => ch.name === city.cityName);
                                            if (!cityNode) {
                                                cityNode = {
                                                    name: city.cityName,
                                                    value: city.totalCount,
                                                    children: []
                                                };
                                                countryNode.children.push(cityNode);
                                            } else {
                                                cityNode.value += city.totalCount;
                                            }

                                            // پردازش اپراتورها
                                            if (city.operators) {
                                                city.operators.forEach(op => {
                                                    let opNode = cityNode.children.find(ch => ch.name === op.operatorName);
                                                    if (!opNode) {
                                                        opNode = {
                                                            name: op.operatorName,
                                                            value: op.totalCount,
                                                            children: []
                                                        };
                                                        cityNode.children.push(opNode);
                                                    } else {
                                                        opNode.value += op.totalCount;
                                                    }
                                                });
                                            }
                                        });
                                    }
                                });
                            }
                        });

                        // ساخت فینال آبجکت داده با ریشه نامرئی که کشورها مستقیم زیر آن باشند
                        const amchartsData = {
                            name: "Root",
                            value: 0,
                            children: Array.from(allCountriesMap.values())
                                .sort((a, b) => b.value - a.value) // مرتب‌سازی بر اساس حجم
                                .map(c => ({
                                    name: c.name,
                                    value: c.value,
                                    children: c.children.map(city => ({
                                        name: city.name,
                                        value: city.value,
                                        children: city.children
                                    }))
                                }))
                        };

                        // مقدار Root را تنظیم می‌کنیم
                        amchartsData.value = amchartsData.children.reduce((sum, item) => sum + item.value, 0);

                        initAmchartsForceGraph(amchartsData);

                        // --- لود نمودار ابر کلمات ---
                        initWordCloud(globalTypeBreakdown);
                    }

                } else {
                    alert(result.message || 'خطایی رخ داد');
                    document.getElementById('treemapLoading').style.display = 'none';
                }
            } catch (error) {
                if (error.name !== 'AbortError') {
                    console.error('Error:', error);
                    alert('ارتباط با سرور بربر نشد');
                    document.getElementById('treemapLoading').style.display = 'none';
                }
            } finally {
                btnFilter.innerHTML = originalBtnText;
                btnFilter.disabled = false;
                btnCancel.style.display = 'none';
                isRequestInProgress = false;
                abortController = null;
            }
        }

        function cancelRequest() {
            if (isRequestInProgress && abortController) {
                abortController.abort();
                console.log('درخواست لغو شد.');
            }
        }

        // شروع کار
        loadData();

        document.getElementById('btnFilter').addEventListener('click', loadData);
        document.getElementById('btnCancel').addEventListener('click', cancelRequest);

        // --- اتصال رویدادهای فیلتر دسته‌بندی ---
        // این بخش بسیار مهم است. باید بعد از تعریف توابع append شود.
        document.getElementById('filterOperator').addEventListener('change', applyCategoryFilter);
        document.getElementById('filterCallType').addEventListener('change', applyCategoryFilter);
        document.getElementById('filterAnswerStatus').addEventListener('change', applyCategoryFilter);

        window.addEventListener('resize', function() {
            if (currentTreemapData.length > 0) {
                const currentTitle = document.getElementById('treemapHeaderTitle').innerText;
                const currentTotal = totalTreemapRoot;
                renderTreemapLevel(currentTreemapData, currentTitle, currentTotal);
            }
        });
    });
</script>