        </div>
    </div>

    <!-- کارت‌های آماری -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card stat-card bg-primary p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title mb-0 opacity-75">کل تماس‌ها</h6>
                        <h2 class="fw-bold mb-0" id="totalCalls">0</h2>
                    </div>
                    <i class="bi bi-telephone-fill fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card bg-success p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title mb-0 opacity-75">پاسخ داده شده</h6>
                        <h2 class="fw-bold mb-0" id="totalSuccess">0</h2>
                    </div>
                    <i class="bi bi-check-circle-fill fs-1 opacity-50"></i>
                </div>
            </div>
