        <div class="quadrant">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold text-muted mb-0">نمودار کل تماس‌ها (روزانه)</h6>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" onclick="resetTotalCallsZoom()">
                        <i class="bi bi-zoom-out"></i> ریست
