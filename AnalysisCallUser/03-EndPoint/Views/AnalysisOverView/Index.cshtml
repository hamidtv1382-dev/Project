        </div>
    </div>

    <!-- داشبورد 4 ربع -->
    <div class="dashboard-grid">
        <!-- ربع بالا چپ -->
        <div class="quadrant" id="topLeftQuadrant">
            <div class="d-flex justify-content-between align-items-center mb-2">
