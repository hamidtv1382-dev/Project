            <div class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-2">
                <h6 class="fw-bold text-muted mb-0">ابر کلمات پرتردد (کشور/شهر/اپراتور)</h6>
                <button class="btn-export-csv" onclick="exportWordCloudToCsv()"><i class="bi bi-download"></i> CSV</button>
            </div>
            <!-- کانتینر جداگانه برای Word Cloud -->
            <div id="wordCloudChartDiv"></div>
        </div>

        <!-- نمودار درختی جدید (amCharts) - با عرض کامل -->
        <div class="quadrant full-width">
            <div class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-2">
                <h6 class="fw-bold text-muted mb-0">تحلیل درختی (کشور-شهر-اپراتور)</h6>
                <button class="btn-export-csv" onclick="exportAmchartsToCsv()"><i class="bi bi-download"></i> CSV</button>
