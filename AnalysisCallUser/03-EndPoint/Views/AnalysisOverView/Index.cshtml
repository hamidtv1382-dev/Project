<!-- اسکریپت‌های Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/hammerjs@2.0.8/hammer.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2.0.1/dist/chartjs-plugin-zoom.min.js"></script>

<!-- اسکریپت‌های amCharts -->
<script src="https://cdn.amcharts.com/lib/5/index.js"></script>
<script src="https://cdn.amcharts.com/lib/5/hierarchy.js"></script>
<script src="https://cdn.amcharts.com/lib/5/themes/Animated.js"></script>
<!-- اسکریپت amCharts Word Cloud -->
<script src="https://cdn.amcharts.com/lib/5/wc.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        let lineChart = null;
        let mainPieChart = null;
        let miniPieCharts = [];
        let totalCallsChart = null;
        let amchartsRoot = null; // برای مدیریت حافظه amChart
        let wordCloudRoot = null; // برای مدیریت حافظه Word Cloud

        // متغیرهای مربوط به Treemap
        let currentTreemapData = [];
        let treemapHistory = [];
        let totalTreemapRoot = 0;
        let breadcrumbHistory = [{ name: 'سطح اصلی', level: 0 }];
        let currentLevel = 0;

        let abortController = null;
        let isRequestInProgress = false;

        // داده‌های سراسری برای فیلترها و اکسپورت
        let globalTypeBreakdown = [];
        let globalChartData = []; // برای نگهداری دیتای خطی
        let globalDisplayDates = []; // برای نگهداری تاریخ‌ها

        const ctxLine = document.getElementById('callsLineChart').getContext('2d');
        const ctxMainPie = document.getElementById('mainTypePieChart').getContext('2d');
        const ctxTotalCalls = document.getElementById('totalCallsLineChart').getContext('2d');
        const ctxLocation = document.getElementById('chartLocation').getContext('2d');
        const ctxCategory = document.getElementById('chartCategory').getContext('2d');

        const persianMonthDays = [31, 31, 31, 31, 31, 31, 30, 30, 30, 30, 30, 29];
        const treemapTooltip = document.getElementById('treemapTooltip');

        // --- توابع کمکی اکسپورت ---

        // تابع عمومی برای اکسپورت به CSV با پشتیبانی UTF-8
        function downloadCSV(csvContent, fileName) {
            // اضافه کردن BOM برای شناسایی صحیح UTF-8 در اکسل
            const blob = new Blob(["\uFEFF" + csvContent], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement("a");
            const url = URL.createObjectURL(blob);
            link.setAttribute("href", url);
            link.setAttribute("download", fileName + ".csv");
            link.style.visibility = 'hidden';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        // اکسپورت نمودارهای Chart.js (Pie, Line, Bar)
        window.exportChartToCsv = function(canvasId, fileName) {
            const chart = Chart.getChart(document.getElementById(canvasId));
            if (!chart) return;

            let csv = "";
            const data = chart.data;
            const labels = data.labels;
            const datasets = data.datasets;

            // هدر
            let headers = ["Subject", "Value"];
            if (datasets.length > 1) {
                datasets.forEach((ds, i) => headers.push(`Value_${ds.label}`));
            }
            csv += headers.join(",") + "\n";

            // ردیف‌ها
            for (let i = 0; i < labels.length; i++) {
                let row = [`"${labels[i]}"`];
                for (let j = 0; j < datasets.length; j++) {
                    row.push(datasets[j].data[i]);
                }
                csv += row.join(",") + "\n";
            }

            downloadCSV(csv, fileName);
        };

        // اکسپورت نمودارهای اسکرول خوردنی (چند نمودار پای)
        window.exportScrollChartsToCsv = function(fileName) {
            let csv = "Type,Country,City,Value\n";

            miniPieCharts.forEach(chart => {
                if(!chart) return;
                const labels = chart.data.labels; // کشورها
                const data = chart.data.datasets[0].data;
                const title = chart.options.plugins.title.text; // یا نام والد را از HTML پیدا می‌کنیم

                // یافتن نام تایپ از المنت HTML
                const wrapper = chart.canvas.closest('.mini-pie-wrapper');
                const typeName = wrapper ? wrapper.querySelector('h6').innerText : "Unknown Type";

                labels.forEach((label, i) => {
                    csv += `"${typeName}","${label}","",${data[i]}\n`;
                });
            });

            downloadCSV(csv, fileName);
        };

        // اکسپورت Treemap
        window.exportTreemapToCsv = function() {
            let csv = "Level,Name,Total,Success,Fail,Percentage\n";

            function traverse(items, level) {
                items.forEach(item => {
                    csv += `${level},"${item.name}",${item.total},${item.success},${item.fail},${item.percentage}%\n`;
                    if (item.children) {
                        traverse(item.children, level + 1);
                    }
                });
            }

            traverse(currentTreemapData, 1);
            downloadCSV(csv, "Treemap_Data");
        };

        // اکسپورت Word Cloud
        window.exportWordCloudToCsv = function() {
            // داده‌های اصلی از globalTypeBreakdown
            let csv = "Tag,Weight\n";
            const wordCloudData = [];

            globalTypeBreakdown.forEach(t => {
                if (t.totalCount > 0) wordCloudData.push({ tag: t.typeName, weight: t.totalCount });
                if (t.countries) {
                    t.countries.forEach(c => {
                        if (c.totalCount > 0) wordCloudData.push({ tag: c.countryName, weight: c.totalCount });
                        if (c.cities) {
                            c.cities.forEach(city => {
                                if (city.totalCount > 0) wordCloudData.push({ tag: city.cityName, weight: city.totalCount });
                                if (city.operators) {
                                    city.operators.forEach(op => {
                                        if (op.totalCount > 0) wordCloudData.push({ tag: op.operatorName, weight: op.totalCount });
                                    });
                                }
                            });
                        }
                    });
                }
            });

            wordCloudData.sort((a, b) => b.weight - a.weight);
            wordCloudData.slice(0, 100).forEach(w => {
                csv += `"${w.tag}",${w.weight}\n`;
            });

            downloadCSV(csv, "WordCloud_Top100");
        };

        // اکسپورت نمودار درختی amCharts
        window.exportAmchartsToCsv = function() {
            let csv = "Parent,Name,Value,Type\n";
            let currentData = amchartsDataGlobal; // باید تعریف شده باشد در بخش لود

            function traverse(items, parentName) {
                items.forEach(item => {
                    let type = "Type";
                    // تشخیص سطح بر اساس عمق ساختار
                    if (item.children && item.children.length > 0 && item.children[0].children) {
                        // سطوح پایین (اپراتور) فرزندشان را ندارند
                         if (item.children[0].children && item.children[0].children.length === 0) {
                             // این سطح شهر است (چون فرزندش اپراتور و اپراتور فرزند ندارد)
                             type = "City";
                         } else {
                             type = "Country";
                         }
                    } else if (!item.children || item.children.length === 0) {
                        type = "Operator";
                    }

                    csv += `"${parentName}","${item.name}",${item.value},"${type}"\n`;
                    if (item.children) {
                        traverse(item.children, item.name);
                    }
                });
            }

            traverse(currentData, "Root");
            downloadCSV(csv, "ForceDirected_Tree");
        };

        // --- استخراج داده‌ها از typeBreakdown و پر کردن دراپ‌داون‌ها ---
        function populateFiltersFromData(typesData) {
            const typeSelect = document.getElementById('filterCallType');
            const countrySelect = document.getElementById('filterCountry');
            const citySelect = document.getElementById('filterCity');

            // نگهداری انتخاب‌های فعلی
            const currentType = typeSelect.value;
            const currentCountry = countrySelect.value;
            const currentCity = citySelect.value;

            typeSelect.innerHTML = '<option value="">همه</option>';
            countrySelect.innerHTML = '<option value="">همه کشورها</option>';
            citySelect.innerHTML = '<option value="">ابتدا کشور را انتخاب کنید</option>';
            citySelect.disabled = true;

            // 1. تایپ‌ها
            typesData.forEach(t => {
                const opt = document.createElement('option');
                opt.value = t.typeID;
                opt.textContent = t.typeName;
                typeSelect.appendChild(opt);
            });
            typeSelect.value = currentType;

            // 2. کشورها
            const countriesMap = new Map();
            typesData.forEach(t => {
                if (t.countries) {
                    t.countries.forEach(c => {
                        if (!countriesMap.has(c.countryID)) {
                            countriesMap.set(c.countryID, c.countryName);
                        }
                    });
                }
            });
            const sortedCountries = Array.from(countriesMap.entries()).sort((a, b) => a[1].localeCompare(b[1]));
            sortedCountries.forEach(([id, name]) => {
                const opt = document.createElement('option');
                opt.value = id;
                opt.textContent = name;
                countrySelect.appendChild(opt);
            });

            // بازیابی انتخاب کشور
            if (currentCountry && countriesMap.has(parseInt(currentCountry))) {
                countrySelect.value = currentCountry;
                updateCityDropdown(currentCountry, currentCity);
            }

            // 3. اپراتورها
            const operatorsMap = new Map();
            typesData.forEach(t => {
                if (t.countries) {
                    t.countries.forEach(c => {
                        if (c.cities) {
                            c.cities.forEach(city => {
                                if (city.operators) {
                                    city.operators.forEach(op => {
                                        if (!operatorsMap.has(op.operatorID)) {
                                            operatorsMap.set(op.operatorID, op.operatorName);
                                        }
                                    });
                                }
                            });
                        }
                    });
                }
            });
            const opSelect = document.getElementById('filterOperator');
            opSelect.innerHTML = '<option value="">همه</option>';
            const sortedOps = Array.from(operatorsMap.entries()).sort((a, b) => a[1].localeCompare(b[1]));
            sortedOps.forEach(([id, name]) => {
                const opt = document.createElement('option');
                opt.value = id;
                opt.textContent = name;
                opSelect.appendChild(opt);
            });
        }

        // --- مدیریت تغییر کشور و شهر ---
        function updateCityDropdown(countryId, selectedCityIdToKeep = null) {
            const citySelect = document.getElementById('filterCity');
            if (!countryId) {
                citySelect.innerHTML = '<option value="">ابتدا کشور را انتخاب کنید</option>';
                citySelect.disabled = true;
                return;
            }

            const citiesMap = new Map();
            globalTypeBreakdown.forEach(t => {
                if (t.countries) {
                    const countryObj = t.countries.find(c => c.countryID == countryId);
                    if (countryObj && countryObj.cities) {
                        countryObj.cities.forEach(city => {
                            if (!citiesMap.has(city.cityID)) {
                                citiesMap.set(city.cityID, city.cityName);
                            }
                        });
                    }
                }
            });

            citySelect.innerHTML = '<option value="">همه شهرها</option>';
            const sortedCities = Array.from(citiesMap.entries()).sort((a, b) => a[1].localeCompare(b[1]));

            if (sortedCities.length === 0) {
                const opt = document.createElement('option');
                opt.text = "شهری یافت نشد";
                citySelect.appendChild(opt);
                citySelect.disabled = true;
            } else {
                sortedCities.forEach(([id, name]) => {
                    const opt = document.createElement('option');
                    opt.value = id;
                    opt.textContent = name;
                    citySelect.appendChild(opt);
                });
                citySelect.disabled = false;
                if (selectedCityIdToKeep && citiesMap.has(parseInt(selectedCityIdToKeep))) {
                    citySelect.value = selectedCityIdToKeep;
                }
            }
        }

        // --- اتصال رویدادها به دراپ‌داون‌های مکانی ---
        document.getElementById('filterCountry').addEventListener('change', function() {
            updateCityDropdown(this.value);
            applyLocationFilter();
        });

        document.getElementById('filterCity').addEventListener('change', function() {
            applyLocationFilter();
        });

        // --- منطق فیلترینگ مکانی ---
        function applyLocationFilter() {
            if (!globalTypeBreakdown || globalTypeBreakdown.length === 0) return;

            const countryId = document.getElementById('filterCountry').value;
            const cityId = document.getElementById('filterCity').value;

            let labels = [];
            let values = [];
            let title = '';
            let color = '#0dcaf0';

            // اگر فیلتری انتخاب نشده، کل کشورها را نمایش بده
            if (!countryId) {
                const dataMap = new Map();
                globalTypeBreakdown.forEach(t => {
                    t.countries.forEach(c => {
                        if (!dataMap.has(c.countryName)) dataMap.set(c.countryName, 0);
                        dataMap.set(c.countryName, dataMap.get(c.countryName) + c.totalCount);
                    });
                });
                labels = Array.from(dataMap.keys());
                values = Array.from(dataMap.values());
                title = 'توزیع تماس‌ها بر اساس کشور';
            }
            // اگر کشور انتخاب شده و شهر خالی، شهرهای آن کشور را نمایش بده
            else if (!cityId) {
                const dataMap = new Map();
                globalTypeBreakdown.forEach(t => {
                    const countryObj = t.countries.find(c => c.countryID == countryId);
                    if (countryObj && countryObj.cities) {
                        countryObj.cities.forEach(c => {
                            if (!dataMap.has(c.cityName)) dataMap.set(c.cityName, 0);
                            dataMap.set(c.cityName, dataMap.get(c.cityName) + c.totalCount);
                        });
                    }
                });
                labels = Array.from(dataMap.keys());
                values = Array.from(dataMap.values());
                title = 'توزیع تماس‌ها بر اساس شهر';
            }
            // اگر شهر هم انتخاب شده، اپراتورهای آن شهر را نمایش بده
            else {
                const dataMap = new Map();
                globalTypeBreakdown.forEach(t => {
                    const countryObj = t.countries.find(c => c.countryID == countryId);
                    if (countryObj && countryObj.cities) {
                        const cityObj = countryObj.cities.find(c => c.cityID == cityId);
                        if (cityObj && cityObj.operators) {
                            cityObj.operators.forEach(op => {
                                if (!dataMap.has(op.operatorName)) dataMap.set(op.operatorName, 0);
                                dataMap.set(op.operatorName, dataMap.get(op.operatorName) + op.totalCount);
                            });
                        }
                    }
                });
                labels = Array.from(dataMap.keys());
                values = Array.from(dataMap.values());
                title = 'توزیع تماس‌ها بر اساس اپراتور';
            }

            // استفاده از روش نابود کردن سخت
            forceCreateChart(ctxLocation, 'chartLocation', labels, values, title, color);
        }

        // --- منطق فیلترینگ دسته‌بندی ---
        function applyCategoryFilter() {
            if (!globalTypeBreakdown || globalTypeBreakdown.length === 0) return;

            const operatorId = document.getElementById('filterOperator').value;
            const callTypeId = document.getElementById('filterCallType').value;
            const statusVal = document.getElementById('filterAnswerStatus').value;

            let labels = [];
            let values = [];
            let chartTitle = '';
            let color = '#fd7e14';

            // اگر اپراتور انتخاب شده باشد، برای تشخیص تغییر رنگ استفاده می‌کنیم
            if (operatorId) {
                color = '#6610f2'; // رنگ متفاوت وقتی اپراتور فیلتر شده
            }

            if (callTypeId) {
                // حالت: تایپ مشخص شده -> نمایش کشورهای آن تایپ
                chartTitle = `کشورهای تایپ انتخابی`;
                const typeObj = globalTypeBreakdown.find(t => t.typeID == callTypeId);
                if (typeObj && typeObj.countries) {
                    typeObj.countries.forEach(c => {
                        let count = 0;
                        if (c.cities) {
                            c.cities.forEach(city => {
                                city.operators.forEach(op => {
                                    // فیلتر اپراتور
                                    if (operatorId && op.operatorID != operatorId) return;

                                    // فیلتر وضعیت
                                    if (statusVal === "1") count += op.successCount;
                                    else if (statusVal === "0") count += op.failCount;
                                    else count += op.totalCount;
                                });
                            });
                        }
                        labels.push(c.countryName);
                        values.push(count);
                    });
                }
            } else {
                // حالت: تایپ انتخاب نشده -> نمایش کل تایپ‌ها
                chartTitle = 'سهم تایپ‌های تماس';
                globalTypeBreakdown.forEach(t => {
                    let count = 0;
                    if (t.countries) {
                        t.countries.forEach(c => {
                            if (c.cities) {
                                c.cities.forEach(city => {
                                    city.operators.forEach(op => {
                                        if (operatorId && op.operatorID != operatorId) return;

                                        if (statusVal === "1") count += op.successCount;
                                        else if (statusVal === "0") count += op.failCount;
                                        else count += op.totalCount;
                                    });
                                });
                            }
                        });
                    }
                    labels.push(t.typeName);
                    values.push(count);
                });
            }

            // استفاده از روش نابود کردن سخت
            forceCreateChart(ctxCategory, 'chartCategory', labels, values, chartTitle, color);
        }

        // --- تابع ریست کامل برای هر دو نمودار ---
        window.resetAllFilters = function() {
            // ریست کردن فیلترهای دسته‌بندی
            document.getElementById('filterOperator').value = "";
            document.getElementById('filterCallType').value = "";
            document.getElementById('filterAnswerStatus').value = "";

            // ریست کردن فیلترهای مکانی
            document.getElementById('filterCountry').value = "";
            document.getElementById('filterCity').value = "";
            document.getElementById('filterCity').disabled = true;

            // اعمال مجدد وضعیت اولیه به نمودارها
            applyLocationFilter();
            applyCategoryFilter();
        };

        // --- روش قطعی برای ساخت نمودار جدید (راه حل جدید) ---
        function forceCreateChart(ctx, canvasId, labels, data, label, color) {
            // پیدا کردن و نابود کردن هر نموداری که روی این context وجود دارد
            const existingChart = Chart.getChart(ctx);
            if (existingChart) {
                existingChart.destroy();
            }

            // ساخت نمودار جدید
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: label,
                        data: data,
                        backgroundColor: color,
                        borderWidth:1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: {
                        duration: 800,
                        easing: 'easeOutBounce' // انیمیشن پررنگ برای محسوس شدن تغییر
                    },
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: { beginAtZero: true },
                        x: { grid: { display: false } }
                    }
                }
            });
        }

        // --- مدیریت تاریخ ---
        function updateDateInputs() {
            const year = document.getElementById('selectYear').value;
            const month = document.getElementById('selectMonth').value;
            const startInput = document.getElementById('startDate');
            const endInput = document.getElementById('endDate');

            if (month && month !== "") {
                const lastDay = persianMonthDays[parseInt(month) - 1];
                startInput.value = `${year}/${month.padStart(2, '0')}/01`;
                endInput.value = `${year}/${month.padStart(2, '0')}/${lastDay}`;
            } else if (year) {
                startInput.value = `${year}/01/01`;
                endInput.value = `${year}/12/29`;
            } else {
                startInput.value = ""; endInput.value = "";
            }
        }
        document.getElementById('selectYear').addEventListener('change', updateDateInputs);
        document.getElementById('selectMonth').addEventListener('change', updateDateInputs);
        updateDateInputs();

        // --- نمودار خطی اصلی ---
        function initLineChart(labels, successData, failData, displayDates) {
            if (lineChart) lineChart.destroy();

            // ذخیره داده‌ها برای اکسپورت
            globalChartData = [];
            globalDisplayDates = displayDates;

            lineChart = new Chart(ctxLine, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'پاسخ داده شده (موفق)', data: successData, borderColor: '#198754',
                            backgroundColor: 'rgba(25, 135, 84, 0.1)', borderWidth: 2, tension: 0.3, fill: true, pointRadius: 2, pointHoverRadius: 5
                        },
                        {
