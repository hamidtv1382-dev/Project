<!-- اسکریپت‌ها -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/hammerjs@2.0.8/hammer.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2.0.1/dist/chartjs-plugin-zoom.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        let lineChart = null; // نمودار خطی
        let mainPieChart = null; // نمودار دایره‌ای اصلی (تایپ‌ها)
        let miniPieCharts = []; // آرایه‌ای برای نگهداری نمودارهای کوچک کشورها (برای حذف در هنگام رندر مجدد)

        const ctxLine = document.getElementById('callsLineChart').getContext('2d');
        const ctxMainPie = document.getElementById('mainTypePieChart').getContext('2d');

        // آرایه تعداد روزهای ماه‌های شمسی
        const persianMonthDays = [31, 31, 31, 31, 31, 31, 30, 30, 30, 30, 30, 29];

        // تابع آپدیت خودکار فیلدهای تاریخ
        function updateDateInputs() {
            const year = document.getElementById('selectYear').value;
            const month = document.getElementById('selectMonth').value;
            const startInput = document.getElementById('startDate');
            const endInput = document.getElementById('endDate');

            if (month && month !== "") {
                const lastDay = persianMonthDays[parseInt(month) - 1];
                startInput.value = `${year}/${month.padStart(2, '0')}/01`;
                endInput.value = `${year}/${month.padStart(2, '0')}/${lastDay}`;
            } else if (year) {
                startInput.value = `${year}/01/01`;
                endInput.value = `${year}/12/29`;
            } else {
                startInput.value = "";
                endInput.value = "";
            }
        }

        document.getElementById('selectYear').addEventListener('change', updateDateInputs);
        document.getElementById('selectMonth').addEventListener('change', updateDateInputs);
        updateDateInputs();

        // --- تنظیمات نمودار خطی (همان قبلی) ---
        function initLineChart(labels, successData, failData, displayDates) {
            if (lineChart) lineChart.destroy();

            lineChart = new Chart(ctxLine, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'پاسخ داده شده (موفق)',
                            data: successData,
                            borderColor: '#198754',
                            backgroundColor: 'rgba(25, 135, 84, 0.1)',
                            borderWidth: 2,
                            tension: 0.3,
                            fill: true,
                            pointRadius: 2,
                            pointHoverRadius: 5
                        },
                        {
                            label: 'پاسخ داده نشده (ناموفق)',
                            data: failData,
                            borderColor: '#dc3545',
                            backgroundColor: 'rgba(220, 53, 69, 0.1)',
                            borderWidth: 2,
                            tension: 0.3,
                            fill: true,
                            pointRadius: 2,
                            pointHoverRadius: 5
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: { position: 'top', labels: { font: { family: 'Vazirmatn' } } },
                        tooltip: {
                            titleFont: { family: 'Vazirmatn' },
                            bodyFont: { family: 'Vazirmatn' },
                            callbacks: {
                                title: function(tooltipItems) {
                                    const index = tooltipItems[0].dataIndex;
                                    return displayDates[index];
                                }
                            }
                        },
                        zoom: {
                            pan: { enabled: true, mode: 'x' },
                            zoom: { wheel: { enabled: true }, pinch: { enabled: true }, mode: 'x' }
                        }
                    },
                    scales: {
                        y: { beginAtZero: true, title: { display: true, text: 'تعداد تماس', font: {family: 'Vazirmatn'} } },
                        x: { ticks: { font: { family: 'Vazirmatn' }, maxTicksLimit: 10 }, grid: { display: false } }
                    }
                }
            });
        }

        window.resetLineZoom = function() {
            if(lineChart) lineChart.resetZoom();
        };

        // --- تابع ساخت نمودار دایره‌ای اصلی (تایپ‌ها) ---
        function initMainPieChart(typesData) {
            if (mainPieChart) mainPieChart.destroy();

            const labels = typesData.map(t => t.typeName);
            const dataTotal = typesData.map(t => t.totalCount);
            // رنگ‌های مختلف برای هر تایپ
            const backgroundColors = ['#6f42c1', '#198754', '#0dcaf0', '#ffc107', '#dc3545', '#fd7e14', '#6610f2'];

            mainPieChart = new Chart(ctxMainPie, {
                type: 'doughnut', // نوع دایره‌ای توخالی (زیباتر برای داشبورد)
                data: {
                    labels: labels,
                    datasets: [{
                        data: dataTotal,
                        backgroundColor: backgroundColors.slice(0, labels.length),
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'right', labels: { font: { family: 'Vazirmatn' } } },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const raw = context.raw;
                                    const index = context.dataIndex;
                                    const typeInfo = typesData[index];
                                    const success = typeInfo.successCount;
                                    const fail = typeInfo.failCount;
                                    const percentage = ((raw / typesData.reduce((a, b) => a + b.totalCount, 0)) * 100).toFixed(1);
                                    return ` ${typeInfo.typeName}: ${raw} (${percentage}%) [موفق: ${success}, ناموفق: ${fail}]`;
                                }
                            }
                        }
                    }
                }
            });
        }

        // --- تابع ساخت نمودارهای کوچک کشورها (Top Left) ---
        function initCountryCharts(typesData) {
            const container = document.getElementById('topLeftContainer');
            const scrollHint = document.getElementById('scrollHint');

            // پاک کردن نمودارهای قبلی
            miniPieCharts.forEach(chart => {
                if (chart && typeof chart.destroy === 'function') {
                    chart.destroy();
                }
            });
            miniPieCharts = [];
            container.innerHTML = '';

            if (!typesData || typesData.length === 0) {
                container.innerHTML = '<div class="w-100 text-center text-muted mt-5">داده‌ای برای نمایش وجود ندارد</div>';
                scrollHint.style.display = 'none';
                return;
            }

            // اگر بیش از 2 نوع تایپ داریم، نشانگر اسکرول را نمایش بده
            if (typesData.length > 2) {
                scrollHint.style.display = 'flex';
            } else {
                scrollHint.style.display = 'none';
            }

            // ایجاد نمودار برای هر تایپ
            typesData.forEach((type, typeIndex) => {
                if (!type.countries || type.countries.length === 0) return;

                // ایجاد کارت برای هر تایپ
                const wrapper = document.createElement('div');
                wrapper.className = 'mini-pie-wrapper';

                // عنوان تایپ
                const title = document.createElement('h6');
                title.className = 'fw-bold text-truncate mb-2';
                title.innerText = type.typeName;
                title.style.color = '#6f42c1';
                title.title = type.typeName; // tooltip برای متن طولانی

                // اطلاعات آماری کوچک
                const stats = document.createElement('div');
                stats.className = 'small text-muted mb-2';
                stats.innerHTML = `
                    <span class="badge bg-success me-1">موفق: ${type.successCount}</span>
                    <span class="badge bg-danger me-1">ناموفق: ${type.failCount}</span>
                    <span class="badge bg-primary">کل: ${type.totalCount}</span>
                `;

                wrapper.appendChild(title);
                wrapper.appendChild(stats);

                // بوم نقاشی (Canvas)
                const canvas = document.createElement('canvas');
                canvas.className = 'mini-pie-canvas';
                // یک ID یکتا برای کنترلر چارت جی اس
                const canvasId = `miniChart_${type.typeID || typeIndex}`;
                canvas.id = canvasId;

                wrapper.appendChild(canvas);
                container.appendChild(wrapper);

                // ساخت نمودار
                const ctxMini = document.getElementById(canvasId).getContext('2d');

                // محاسبه درصد برای کشورها
                const totalCallsForType = type.totalCount;

                const chart = new Chart(ctxMini, {
                    type: 'pie',
                    data: {
                        labels: type.countries.map(c => c.countryName),
                        datasets: [{
                            data: type.countries.map(c => c.totalCount),
                            backgroundColor: ['#0d6efd', '#198754', '#ffc107', '#dc3545', '#6c757d', '#20c997', '#e83e8c', '#fd7e14'], // رنگ‌های متنوع
                            borderWidth: 1,
                            borderColor: '#fff'
                        }]
                    },
                    options: {
                        responsive: false, // چون عرض ثابت داریم
                        plugins: {
                            legend: {
                                display: type.countries.length <= 5, // فقط اگر تعداد کشورها کم است نمایش بده
                                position: 'bottom',
                                labels: {
                                    font: {
                                        family: 'Vazirmatn',
                                        size: 9
                                    },
                                    padding: 10,
                                    usePointStyle: true
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        const cIndex = context.dataIndex;
                                        const cInfo = type.countries[cIndex];
                                        const percentage = ((cInfo.totalCount / totalCallsForType) * 100).toFixed(1);
                                        return ` ${cInfo.countryName}: ${cInfo.totalCount} (${percentage}%)`;
                                    },
                                    afterLabel: function(context) {
                                        const cIndex = context.dataIndex;
                                        const cInfo = type.countries[cIndex];
                                        return [`موفق: ${cInfo.successCount}`, `ناموفق: ${cInfo.failCount}`];
                                    }
                                },
                                titleFont: { family: 'Vazirmatn', size: 12 },
                                bodyFont: { family: 'Vazirmatn', size: 11 }
                            }
                        }
                    }
                });

                miniPieCharts.push(chart);
            });
        }

        // --- تابع فراخوانی API ---
        async function loadData() {
            const yearVal = document.getElementById('selectYear').value;
            const monthVal = document.getElementById('selectMonth').value;
            const btn = document.getElementById('btnFilter');

            let params = new URLSearchParams();

            if (monthVal) {
                params.append('year', yearVal);
                params.append('month', monthVal);
            } else if (yearVal) {
                params.append('year', yearVal);
            } else {
                alert('لطفاً سال را انتخاب کنید.');
                return;
            }

            const originalBtnText = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> پردازش...';
            btn.disabled = true;

            try {
                const response = await fetch(`GetChartData?${params.toString()}`);
                const result = await response.json();

                if (result.success) {
                    // 1. بروزرسانی آمار بالا
                    document.getElementById('totalCalls').innerText = result.statistics.totalCalls.toLocaleString('fa-IR');
                    document.getElementById('totalSuccess').innerText = result.statistics.totalSuccess.toLocaleString('fa-IR');
                    document.getElementById('totalFail').innerText = result.statistics.totalFail.toLocaleString('fa-IR');
                    document.getElementById('successRate').innerText = result.statistics.successRate + '%';
                    document.getElementById('dateRangeDisplay').innerText = `بازه انتخابی: ${result.dateRange.persianStart} تا ${result.dateRange.persianEnd}`;

                    // 2. بروزرسانی نمودار خطی (پایین چپ)
                    const labels = result.data.map(d => d.displayDate);
                    const displayDatesFull = result.data.map(d => d.displayDate);
                    const successData = result.data.map(d => d.success);
                    const failData = result.data.map(d => d.fail);
                    initLineChart(labels, successData, failData, displayDatesFull);

                    // 3. بروزرسانی نمودارهای دایره‌ای
                    // بررسی وجود داده تایپ (اگر کنترلر شما قدیمی بود و این فیلد را نمی‌فرستاد، ارور ندهد)
                    if (result.typeBreakdown && Array.isArray(result.typeBreakdown)) {
                        // ربع بالا راست: تایپ کلی
                        initMainPieChart(result.typeBreakdown);
                        // ربع بالا چپ: کشورها
                        initCountryCharts(result.typeBreakdown);
                    }

                } else {
                    alert(result.message || 'خطایی رخ داد');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('ارتباط با سرور برقرار نشد');
            } finally {
                btn.innerHTML = originalBtnText;
                btn.disabled = false;
            }
        }

        // لود اولیه
        loadData();
        document.getElementById('btnFilter').addEventListener('click', loadData);
    });
</script>