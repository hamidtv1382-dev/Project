</div>

<!-- ابزارک Tooltip برای نمایش جزئیات -->
<div id="treemapTooltip" class="treemap-tooltip"></div>

<!-- اسکریپت‌ها -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/hammerjs@2.0.8/hammer.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2.0.1/dist/chartjs-plugin-zoom.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        let lineChart = null;
        let mainPieChart = null;
        let miniPieCharts = [];

        // متغیرهای مربوط به Treemap پیشرفته
        let currentTreemapData = [];
        let treemapHistory = [];
        let totalTreemapRoot = 0;
        let breadcrumbHistory = [{ name: 'سطح اصلی', level: 0 }];
        let currentLevel = 0;

        const ctxLine = document.getElementById('callsLineChart').getContext('2d');
        const ctxMainPie = document.getElementById('mainTypePieChart').getContext('2d');
        const persianMonthDays = [31, 31, 31, 31, 31, 31, 30, 30, 30, 30, 30, 29];
        const treemapTooltip = document.getElementById('treemapTooltip');

        // --- مدیریت تاریخ ---
        function updateDateInputs() {
            const year = document.getElementById('selectYear').value;
            const month = document.getElementById('selectMonth').value;
            const startInput = document.getElementById('startDate');
            const endInput = document.getElementById('endDate');

            if (month && month !== "") {
                const lastDay = persianMonthDays[parseInt(month) - 1];
                startInput.value = `${year}/${month.padStart(2, '0')}/01`;
                endInput.value = `${year}/${month.padStart(2, '0')}/${lastDay}`;
            } else if (year) {
                startInput.value = `${year}/01/01`;
                endInput.value = `${year}/12/29`;
            } else {
                startInput.value = ""; endInput.value = "";
            }
        }
        document.getElementById('selectYear').addEventListener('change', updateDateInputs);
        document.getElementById('selectMonth').addEventListener('change', updateDateInputs);
        updateDateInputs();

        // --- نمودار خطی ---
        function initLineChart(labels, successData, failData, displayDates) {
            if (lineChart) lineChart.destroy();
            lineChart = new Chart(ctxLine, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'پاسخ داده شده (موفق)', data: successData, borderColor: '#198754',
                            backgroundColor: 'rgba(25, 135, 84, 0.1)', borderWidth: 2, tension: 0.3, fill: true, pointRadius: 2, pointHoverRadius: 5
                        },
                        {
                            label: 'پاسخ داده نشده (ناموفق)', data: failData, borderColor: '#dc3545',
                            backgroundColor: 'rgba(220, 53, 69, 0.1)', borderWidth: 2, tension: 0.3, fill: true, pointRadius: 2, pointHoverRadius: 5
                        }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: { position: 'top', labels: { font: { family: 'Vazirmatn' } } },
                        tooltip: {
                            callbacks: {
                                title: function(tooltipItems) {
                                    const index = tooltipItems[0].dataIndex;
                                    return displayDates[index];
                                }
                            }
                        },
                        zoom: { pan: { enabled: true, mode: 'x' }, zoom: { wheel: { enabled: true }, pinch: { enabled: true }, mode: 'x' } }
                    },
                    scales: {
                        y: { beginAtZero: true, title: { display: true, text: 'تعداد تماس', font: {family: 'Vazirmatn'} } },
                        x: { ticks: { font: { family: 'Vazirmatn' }, maxTicksLimit: 10 }, grid: { display: false } }
                    }
                }
            });
        }
        window.resetLineZoom = function() { if(lineChart) lineChart.resetZoom(); };
    // --- نمودار پای اصلی ---
    function initMainPieChart(typesData) {
        if (mainPieChart) mainPieChart.destroy();

        const labels = typesData.map(t => t.typeName);
        const dataTotal = typesData.map(t => t.totalCount);

        const backgroundColors = [
            '#6f42c1',
            '#198754',
            '#0dcaf0',
            '#ffc107',
            '#dc3545',
            '#fd7e14',
            '#6610f2'
        ];

        mainPieChart = new Chart(ctxMainPie, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: dataTotal,
                    backgroundColor: backgroundColors.slice(0, labels.length),
                    borderWidth: 1,
                    radius: '80%',     // 👈 کوچک‌تر شدن کل دایره (مثلاً 75% تا 85%)
                    cutout: '55%'      // 👈 اندازه سوراخ وسط (در صورت تمایل)
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                layout: {
                    padding: 10 // فضای اطراف برای جلوگیری از فشردگی
                },
                plugins: {
                    legend: {
                        position: 'right',
                        labels: {
                            font: {
                                family: 'Vazirmatn',
                                size: 13
                            }
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                const raw = context.raw;
                                const index = context.dataIndex;
                                const typeInfo = typesData[index];

                                const total = typesData.reduce(
                                    (sum, item) => sum + item.totalCount,
                                    0
                                );

                                const percentage = ((raw / total) * 100).toFixed(1);

                                return ` ${typeInfo.typeName}: ${raw} (${percentage}%) [موفق: ${typeInfo.successCount}, ناموفق: ${typeInfo.failCount}]`;
                            }
                        }
                    }
                }
            }
        });
    }

        // --- نمودارهای کوچک کشورها ---
        function initCountryCharts(typesData) {
            const container = document.getElementById('topLeftContainer');
            const scrollHint = document.getElementById('scrollHint');
            miniPieCharts.forEach(chart => { if (chart && typeof chart.destroy === 'function') chart.destroy(); });
            miniPieCharts = []; container.innerHTML = '';

            if (!typesData || typesData.length === 0) {
                container.innerHTML = '<div class="w-100 text-center text-muted mt-5">داده‌ای برای نمایش وجود ندارد</div>';
                scrollHint.style.display = 'none'; return;
            }
            if (typesData.length > 2) scrollHint.style.display = 'flex'; else scrollHint.style.display = 'none';

            typesData.forEach((type, typeIndex) => {
                if (!type.countries || type.countries.length === 0) return;
                const wrapper = document.createElement('div'); wrapper.className = 'mini-pie-wrapper';
                const title = document.createElement('h6'); title.className = 'fw-bold text-truncate mb-2'; title.innerText = type.typeName; title.style.color = '#6f42c1';
                const stats = document.createElement('div'); stats.className = 'small text-muted mb-2';
                stats.innerHTML = `<span class="badge bg-success me-1">موفق: ${type.successCount}</span><span class="badge bg-danger me-1">ناموفق: ${type.failCount}</span><span class="badge bg-primary">کل: ${type.totalCount}</span>`;
                wrapper.appendChild(title); wrapper.appendChild(stats);
                const canvas = document.createElement('canvas'); canvas.className = 'mini-pie-canvas'; canvas.id = `miniChart_${type.typeID || typeIndex}`;
                wrapper.appendChild(canvas); container.appendChild(wrapper);
                const ctxMini = document.getElementById(canvas.id).getContext('2d');
                const totalCallsForType = type.totalCount;
                const chart = new Chart(ctxMini, {
                    type: 'pie',
                    data: {
                        labels: type.countries.map(c => c.countryName),
                        datasets: [{
                            data: type.countries.map(c => c.totalCount),
                            backgroundColor: ['#0d6efd', '#198754', '#ffc107', '#dc3545', '#6c757d', '#20c997', '#e83e8c', '#fd7e14'],
                            borderWidth: 1, borderColor: '#fff'
                        }]
                    },
                    options: {
                        responsive: false,
                        plugins: {
                            legend: { display: type.countries.length <= 5, position: 'bottom', labels: { font: { family: 'Vazirmatn', size: 9 }, padding: 10, usePointStyle: true } },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        const cIndex = context.dataIndex; const cInfo = type.countries[cIndex];
                                        const percentage = ((cInfo.totalCount / totalCallsForType) * 100).toFixed(1);
                                        return ` ${cInfo.countryName}: ${cInfo.totalCount} (${percentage}%)`;
                                    },
                                    afterLabel: function(context) {
                                        const cIndex = context.dataIndex; const cInfo = type.countries[cIndex];
                                        return [`موفق: ${cInfo.successCount}`, `ناموفق: ${cInfo.failCount}`];
                                    }
                                },
                                titleFont: { family: 'Vazirmatn', size: 12 }, bodyFont: { family: 'Vazirmatn', size: 11 }
                            }
                        }
                    }
                });
                miniPieCharts.push(chart);
            });
        }

        // --- منطق نمودار درختی (Treemap) پیشرفته ---
        function initTreemap(fullData) {
            // پنهان کردن اسپینر
            document.getElementById('treemapLoading').style.display = 'none';

            totalTreemapRoot = fullData.reduce((acc, item) => acc + item.totalCount, 0);
            currentLevel = 0;
            breadcrumbHistory = [{ name: 'سطح اصلی', level: 0 }];

            // آماده‌سازی داده اولیه
            const initialData = fullData.map((t, index) => ({
                id: 'type_' + t.typeID,
                name: t.typeName,
                total: t.totalCount,
                success: t.successCount,
                fail: t.failCount,
                percentage: ((t.totalCount / totalTreemapRoot) * 100).toFixed(1),
                colorClass: `color-level-${index % 10}`,
                children: t.countries.map(c => ({
                    id: 'country_' + c.countryID,
                    name: c.countryName,
                    total: c.totalCount,
                    success: c.successCount,
                    fail: c.failCount,
                    percentage: ((c.totalCount / t.totalCount) * 100).toFixed(1),
                    colorClass: `color-level-${(index + 1) % 10}`,
                    children: c.cities.map(ci => ({
                        id: 'city_' + ci.cityID,
                        name: ci.cityName,
                        total: ci.totalCount,
                        success: ci.successCount,
                        fail: ci.failCount,
                        percentage: ((ci.totalCount / c.totalCount) * 100).toFixed(1),
                        colorClass: `color-level-${(index + 2) % 10}`,
                        children: ci.operators.map(o => ({
                            id: 'op_' + o.operatorID,
                            name: o.operatorName,
                            total: o.totalCount,
                            success: o.successCount,
                            fail: o.failCount,
                            percentage: ((o.totalCount / ci.totalCount) * 100).toFixed(1),
                            colorClass: `color-level-${(index + 3) % 10}`,
                            children: null
                        }))
                    }))
                }))
            }));

            treemapHistory = [];
            renderTreemapLevel(initialData, 'نمای کلی (تایپ)', totalTreemapRoot);
            updateBreadcrumb();
        }

        function renderTreemapLevel(data, title, parentTotal) {
            currentTreemapData = data;
            document.getElementById('treemapHeaderTitle').innerText = title;
            document.getElementById('treemapBackBtn').style.display = treemapHistory.length > 0 ? 'inline-block' : 'none';

            const container = document.getElementById('treemapContainer');
            const grid = document.getElementById('treemapGrid');
            grid.innerHTML = '';

            if (!data || data.length === 0) {
                grid.innerHTML = `
                    <div class="treemap-empty">
                        <i class="bi bi-tree"></i>
                        <h6>داده‌ای در این سطح وجود ندارد</h6>
                        <small>برای بازگشت به سطح قبلی روی دکمه بازگشت کلیک کنید</small>
                    </div>
                `;
                return;
            }

            // مرتب‌سازی بر اساس اندازه
            data.sort((a, b) => b.total - a.total);

            // محاسبه ابعاد کانتینر
            const containerWidth = grid.clientWidth;
            const containerHeight = grid.clientHeight;
            const totalArea = containerWidth * containerHeight;

            // اعمال حداقل سایز برای آیتم‌ها (حل مشکل آیتم‌های خیلی کوچک)
            const MIN_ITEM_AREA = 800; // حداقل مساحت برای هر آیتم
            const MIN_ITEM_WIDTH = 60; // حداقل عرض
            const MIN_ITEM_HEIGHT = 40; // حداقل ارتفاع

            // محاسبه مساحت هر آیتم با اعمال حداقل مقدار
            data.forEach(item => {
                // محاسبه مساحت واقعی
                const realArea = (item.total / parentTotal) * totalArea;

                // اعمال حداقل مساحت
                item.area = Math.max(realArea, MIN_ITEM_AREA);
            });

            // الگوریتم Squarified برای محاسبه موقعیت و ابعاد مستطیل‌ها
            const layout = squarifiedTreemap(data, 0, 0, containerWidth, containerHeight);

            // ایجاد آیتم‌های Treemap
            layout.forEach(rect => {
                const item = rect.data;
                const div = document.createElement('div');
                div.className = `treemap-item ${item.colorClass} ${rect.width * rect.height < 1500 ? 'small' : ''}`;

                div.style.position = 'absolute';
                div.style.left = `${rect.x}px`;
                div.style.top = `${rect.y}px`;

                // اعمال حداقل ابعاد
                const finalWidth = Math.max(rect.width, MIN_ITEM_WIDTH);
                const finalHeight = Math.max(rect.height, MIN_ITEM_HEIGHT);

                div.style.width = `${finalWidth}px`;
                div.style.height = `${finalHeight}px`;

                // محاسبه درصد نسبت به والد
                const percentage = ((item.total / parentTotal) * 100).toFixed(1);

                // تنظیم محتوای آیتم
                const showDetails = (finalWidth > 80 && finalHeight > 60);

                div.innerHTML = `
                    <div class="treemap-label">
                        ${showDetails ? `<span class="treemap-title">${item.name}</span>` : `<span class="treemap-title" style="font-size:10px">${item.name.substring(0, 15)}${item.name.length > 15 ? '...' : ''}</span>`}
                        ${showDetails ? `<span class="treemap-stat">${item.total.toLocaleString('fa-IR')} تماس</span>` : ''}
                        ${showDetails ? `<span class="treemap-percentage">${percentage}%</span>` : ''}
                    </div>
                `;

                // رویدادهای hover برای Tooltip
                div.addEventListener('mouseenter', function(e) {
                    const tooltipContent = `
                        <strong>${item.name}</strong><br>
                        کل تماس‌ها: ${item.total.toLocaleString('fa-IR')}<br>
                        موفق: ${item.success.toLocaleString('fa-IR')}<br>
                        ناموفق: ${item.fail.toLocaleString('fa-IR')}<br>
                        نرخ موفقیت: ${((item.success / item.total) * 100).toFixed(1)}%<br>
                        سهم: ${percentage}%
                    `;
                    showTreemapTooltip(e, tooltipContent);
                });

                div.addEventListener('mousemove', function(e) {
                    moveTreemapTooltip(e);
                });

                div.addEventListener('mouseleave', function() {
                    hideTreemapTooltip();
                });

                // رویداد کلیک برای رفتن به سطح پایین‌تر
                if (item.children && item.children.length > 0) {
                    div.style.cursor = 'pointer';
                    div.addEventListener('click', function(e) {
                        e.stopPropagation();

                        // ذخیره وضعیت فعلی
                        treemapHistory.push({
                            data: currentTreemapData,
                            title: document.getElementById('treemapHeaderTitle').innerText,
                            total: parentTotal
                        });

                        // به سطح بعدی برو
                        currentLevel++;
                        breadcrumbHistory.push({
                            name: item.name,
                            level: currentLevel,
                            data: item.children
                        });

                        renderTreemapLevel(item.children, item.name, item.total);
                        updateBreadcrumb();
                    });
                } else {
                    div.style.cursor = 'default';
                }

                grid.appendChild(div);
            });
        }

        // الگوریتم Squarified Treemap
        function squarifiedTreemap(items, x, y, width, height) {
            const layout = [];
            let row = [];
            let rowWidth = width;
            let rowHeight = 0;
            let rowArea = 0;

            // اگر ارتفاع بیشتر از عرض است، جای آنها را عوض کن
            const isVertical = height > width;
            if (isVertical) {
                [width, height] = [height, width];
                [x, y] = [y, x];
            }

            items.forEach(item => {
                const area = item.area;
                const potentialRow = [...row, item];
                const totalArea = rowArea + area;
                const aspectRatio = calculateAspectRatio(potentialRow, totalArea, width, height);

                if (row.length === 0 || aspectRatio <= calculateAspectRatio(row, rowArea, width, height)) {
                    row = potentialRow;
                    rowArea = totalArea;
                } else {
                    // ردیف قبلی را رسم کن
                    layout.push(...layoutRow(row, x, y, rowWidth, rowHeight, rowArea, isVertical));

                    // برای ردیف جدید تنظیمات را به روز کن
                    const usedHeight = rowHeight;
                    if (isVertical) {
                        x += rowWidth;
                    } else {
                        y += rowHeight;
                    }
                    row = [item];
                    rowArea = area;
                    rowHeight = 0;
                    rowWidth = isVertical ? height - usedHeight : width;
                }
            });

            // آخرین ردیف را رسم کن
            if (row.length > 0) {
                layout.push(...layoutRow(row, x, y, rowWidth, rowHeight, rowArea, isVertical));
            }

            return layout;
        }

        function calculateAspectRatio(row, totalArea, width, height) {
            const rowWidth = width;
            const rowHeight = totalArea / rowWidth;
            let minRatio = Infinity;
            let maxRatio = 0;

            row.forEach(item => {
                const itemWidth = (item.area / totalArea) * rowWidth;
                const itemHeight = rowHeight;
                const ratio = Math.max(itemWidth / itemHeight, itemHeight / itemWidth);
                minRatio = Math.min(minRatio, ratio);
                maxRatio = Math.max(maxRatio, ratio);
            });

            return maxRatio;
        }

        function layoutRow(row, x, y, width, height, totalArea, isVertical) {
            const rowHeight = totalArea / width;
            const layout = [];
            let currentX = x;
            let currentY = y;

            row.forEach(item => {
                const itemWidth = (item.area / totalArea) * width;
                const itemHeight = rowHeight;

                let rect = {
                    x: currentX,
                    y: currentY,
                    width: itemWidth,
                    height: itemHeight,
                    data: item
                };

                if (isVertical) {
                    rect = {
                        x: currentY,
                        y: currentX,
                        width: itemHeight,
                        height: itemWidth,
                        data: item
                    };
                }

                layout.push(rect);

                if (isVertical) {
                    currentY += itemWidth;
                } else {
                    currentX += itemWidth;
                }
            });

            return layout;
        }

        // مدیریت Breadcrumb
        function updateBreadcrumb() {
            const breadcrumbContainer = document.getElementById('treemapBreadcrumb');
            breadcrumbContainer.innerHTML = '';

            breadcrumbHistory.forEach((item, index) => {
                const span = document.createElement('span');
                span.className = `breadcrumb-item ${index === breadcrumbHistory.length - 1 ? 'active' : ''}`;
                span.textContent = item.name;

                if (index < breadcrumbHistory.length - 1) {
                    span.addEventListener('click', function() {
                        // به سطح مورد نظر برو
                        const targetLevel = item.level;
                        while (breadcrumbHistory.length > targetLevel + 1) {
                            breadcrumbHistory.pop();
                            if (treemapHistory.length > 0) {
                                const prevState = treemapHistory.pop();
                                renderTreemapLevel(prevState.data, prevState.title, prevState.total);
                            }
                        }
                        currentLevel = targetLevel;
                        updateBreadcrumb();
                    });
                }

                breadcrumbContainer.appendChild(span);

                if (index < breadcrumbHistory.length - 1) {
                    const separator = document.createElement('span');
                    separator.className = 'breadcrumb-separator';
                    separator.innerHTML = '&nbsp;/&nbsp;';
                    breadcrumbContainer.appendChild(separator);
                }
            });
        }

        // مدیریت Tooltip
        function showTreemapTooltip(event, content) {
            treemapTooltip.innerHTML = content;
            treemapTooltip.style.display = 'block';
            moveTreemapTooltip(event);
        }

        function moveTreemapTooltip(event) {
            const x = event.clientX + 10;
            const y = event.clientY + 10;
            treemapTooltip.style.left = `${x}px`;
            treemapTooltip.style.top = `${y}px`;
        }

        function hideTreemapTooltip() {
            treemapTooltip.style.display = 'none';
        }

        // بازگشت به سطح قبلی
        function goBackTreemap() {
            if (treemapHistory.length > 0) {
                const prevState = treemapHistory.pop();
                breadcrumbHistory.pop();
                currentLevel--;
                renderTreemapLevel(prevState.data, prevState.title, prevState.total);
                updateBreadcrumb();
            }
        }

        // تنظیم دکمه بازگشت
        document.getElementById('treemapBackBtn').addEventListener('click', goBackTreemap);

        // --- دریافت داده‌ها ---
        async function loadData() {
            const yearVal = document.getElementById('selectYear').value;
            const monthVal = document.getElementById('selectMonth').value;
            const btn = document.getElementById('btnFilter');

            let params = new URLSearchParams();
            if (monthVal) { params.append('year', yearVal); params.append('month', monthVal); }
            else if (yearVal) { params.append('year', yearVal); }
            else { alert('لطفاً سال را انتخاب کنید.'); return; }

            const originalBtnText = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> پردازش...';
            btn.disabled = true;

            // نمایش اسپینر Treemap
            document.getElementById('treemapLoading').style.display = 'flex';

            try {
                const response = await fetch(`GetChartData?${params.toString()}`);
                const result = await response.json();

                if (result.success) {
                    // 1. آمار بالا
                    document.getElementById('totalCalls').innerText = result.statistics.totalCalls.toLocaleString('fa-IR');
                    document.getElementById('totalSuccess').innerText = result.statistics.totalSuccess.toLocaleString('fa-IR');
                    document.getElementById('totalFail').innerText = result.statistics.totalFail.toLocaleString('fa-IR');
                    document.getElementById('successRate').innerText = result.statistics.successRate + '%';
                    document.getElementById('dateRangeDisplay').innerText = `بازه انتخابی: ${result.dateRange.persianStart} تا ${result.dateRange.persianEnd}`;

                    // 2. نمودار خطی
                    const labels = result.data.map(d => d.displayDate);
                    const displayDatesFull = result.data.map(d => d.displayDate);
                    const successData = result.data.map(d => d.success);
                    const failData = result.data.map(d => d.fail);
                    initLineChart(labels, successData, failData, displayDatesFull);

                    // 3. نمودارهای دایره‌ای و Treemap
                    if (result.typeBreakdown && Array.isArray(result.typeBreakdown)) {
                        initMainPieChart(result.typeBreakdown);
                        initCountryCharts(result.typeBreakdown);
                        initTreemap(result.typeBreakdown);
                    }

                } else {
                    alert(result.message || 'خطایی رخ داد');
                    document.getElementById('treemapLoading').style.display = 'none';
                }
            } catch (error) {
                console.error('Error:', error);
                alert('ارتباط با سرور برقرار نشد');
                document.getElementById('treemapLoading').style.display = 'none';
            }
            finally {
                btn.innerHTML = originalBtnText;
                btn.disabled = false;
            }
        }

        loadData();
        document.getElementById('btnFilter').addEventListener('click', loadData);

        // تنظیم مجدد Treemap هنگام تغییر سایز پنجره
        window.addEventListener('resize', function() {
            if (currentTreemapData.length > 0) {
                const currentTitle = document.getElementById('treemapHeaderTitle').innerText;
                const currentTotal = totalTreemapRoot;
                renderTreemapLevel(currentTreemapData, currentTitle, currentTotal);
            }
        });
    });
</script>