        <div class="quadrant">
            <div class="treemap-controls">
                <h6 class="fw-bold text-muted mb-0" id="treemapHeaderTitle">نمای کلی (تایپ)</h6>
                <button id="treemapBackBtn" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-right"></i> بازگشت
                </button>
            </div>
