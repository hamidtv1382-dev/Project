            <div class="treemap-breadcrumb" id="treemapBreadcrumb">
                <span class="breadcrumb-item active" data-level="0">سطح اصلی</span>
            </div>
            <div id="treemapContainer" class="treemap-container">
                <!-- درخت اینجا رندر می‌شود -->
                <div class="treemap-loading" id="treemapLoading">
                    <div class="treemap-loading-spinner"></div>
                    <span>در حال بارگذاری Treemap...</span>
