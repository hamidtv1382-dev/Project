    <!-- داشبورد 4 ربع -->
    <div class="dashboard-grid">

        <!-- ربع بالا چپ: نمودارهای دایره‌ای کشورها (اسکرول خور) -->
        <div class="quadrant" id="topLeftQuadrant">
